{
  // Cloudflare deploy configuration, committed ON PURPOSE.
  //
  // WHY THIS FILE EXISTS
  //
  // Without it, `wrangler deploy` runs its auto-configuration, which inspects
  // the repository and guesses. It guessed Expo — because `expo` is still a
  // root dependency and app.config.ts is still here, both deliberately, as the
  // anchor for the EAS project that used to run CI (CLAUDE.md §2).
  //
  // So it ran `bunx expo export -p web` and failed asking for react-native-web.
  // It would have kept failing, because the detection is reading real files
  // that are staying. A committed config removes the guess entirely.
  //
  // The site is Astro in web/. After `astro build`, prerendered files live in
  // web/dist/client and the Worker entry in web/dist/server/entry.mjs.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "besivov",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],

  // Built output, not the adapter package. `astro build` writes this file;
  // deploying without building will fail looking for it.
  "main": "web/dist/server/entry.mjs",

  "observability": {
    "enabled": true
  },

  "assets": {
    "binding": "ASSETS",
    "directory": "web/dist/client"
  }

  // Do NOT add custom_domain here until hasivuv.com DNS is attached.
  // A routes.custom_domain that does not resolve fails the deploy.
}
