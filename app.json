{
  "expo": {
    "name": "Hebrew App Template",
    "slug": "app1",
    "owner": "liorkrisis-team",
    "scheme": "hebrewapptemplate",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.template.hebrewapp",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.template.hebrewapp",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "259e2af8-8519-4257-a321-e377944580b1"
      }
    }
  }
}
