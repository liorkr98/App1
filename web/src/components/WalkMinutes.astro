---
import { walkingLineParts, walkMinuteParts } from '@/features/listings/hebrew-plural';

interface Props {
  minutes: number;
  /** Append הליכה. The enrichment rows already sit under a walking-time heading. */
  walking?: boolean;
}

const parts = Astro.props.walking
  ? walkingLineParts(Astro.props.minutes)
  : walkMinuteParts(Astro.props.minutes);
---
{
  'digit' in parts ? (
    Astro.props.walking ? (
      <Fragment>
        <bdi>{parts.digit}</bdi> {parts.noun}
      </Fragment>
    ) : (
      /*
        The digit and the noun are one phrase. Without an isolating wrapper
        the digit escapes the cell and glues to the place name ("3דקות").
        Flex keeps the number at the start of the line (the right, in Hebrew)
        and the noun beside it.
      */
      <span class="minute-pair">
        <bdi>{parts.digit}</bdi>
        <small>{parts.noun}</small>
      </span>
    )
  ) : (
    <span>{parts.words}</span>
  )
}
