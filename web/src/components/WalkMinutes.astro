---
import { walkingLineParts, walkMinuteParts } from '@/features/listings/hebrew-plural';
import { lang } from '../lib/i18n';

interface Props {
  minutes: number;
  /** Append הליכה. The enrichment rows already sit under a walking-time heading. */
  walking?: boolean;
}

/**
 * Another language (a translated listing page): always the digit, and a
 * noun that agrees with it — Arabic counts 3 to 10 with the plural and the
 * rest with the singular; English and Russian use the short unit, which has
 * no plural to get wrong.
 */
function foreign(language: 'en' | 'ru' | 'ar', count: number, walking: boolean) {
  if (language === 'ar') {
    const noun = count >= 3 && count <= 10 ? 'دقائق' : 'دقيقة';
    return { digit: count, noun: walking ? `${noun} مشيًا` : noun };
  }
  if (language === 'ru') return { digit: count, noun: walking ? 'мин пешком' : 'мин' };
  return { digit: count, noun: walking ? 'min walk' : 'min' };
}

const language = lang();
const parts =
  language !== 'he'
    ? foreign(language, Astro.props.minutes, Boolean(Astro.props.walking))
    : Astro.props.walking
      ? walkingLineParts(Astro.props.minutes)
      : walkMinuteParts(Astro.props.minutes);
---
{
  'digit' in parts ? (
    Astro.props.walking ? (
      <Fragment>
        <bdi>{parts.digit}</bdi> {parts.noun}
      </Fragment>
    ) : (
      /*
        The digit and the noun are one phrase. Without an isolating wrapper
        the digit escapes the cell and glues to the place name ("3דקות").
        Flex keeps the number at the start of the line (the right, in Hebrew)
        and the noun beside it.
      */
      <span class="minute-pair">
        <bdi>{parts.digit}</bdi>
        <small>{parts.noun}</small>
      </span>
    )
  ) : (
    <span>{parts.words}</span>
  )
}
