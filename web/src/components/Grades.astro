---
/**
 * A school's grade span. In Hebrew it is letters (א׳–ו׳); in the other page
 * languages it is digits ("Grades 1–6"), and those go in <bdi> like every
 * other number (CLAUDE.md §4.2).
 */
interface Props {
  span: string;
}

const { span } = Astro.props;
const parts = span.split(/(\d+(?:–\d+)?)/);
---
{parts.map((part, index) => (index % 2 === 1 ? <bdi>{part}</bdi> : part))}
