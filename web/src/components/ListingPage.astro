---
import type { Listing } from '@/types/listing';
import BaseListing from '../layouts/BaseListing.astro';
import CtaDock from './CtaDock.astro';
import Disclosures from './Disclosures.astro';
import Enrichment from './Enrichment.astro';
import FactsGrid from './FactsGrid.astro';
import Gallery from './Gallery.astro';
import HeroThumbs from './HeroThumbs.astro';
import HighlightChips from './HighlightChips.astro';
import Hero from './Hero.astro';
import MonthlyCost from './MonthlyCost.astro';
import MapSection from './MapSection.astro';
import PriceBar from './PriceBar.astro';
import { priceProps } from '../lib/stage';
import Prose from './Prose.astro';
import SellerBlock from './SellerBlock.astro';
import Stage from './Stage.astro';
import AgentCard from './AgentCard.astro';
import Walk from './Walk.astro';
import { CATEGORY_PRESENTATION } from '../lib/category-presentation';
import { lang, t, tr } from '../lib/i18n';
import { languagePath, pageLanguages } from '../lib/translated';
import { perUnitPrice } from '../lib/price';
import { ils } from '../lib/format';
import { areaMap } from '@/features/listings/area-map';
import { isWalkItem, labeledWalkItems } from '@/features/listings/photo-rooms';
import { enrichmentHasContent } from '@/features/listings/enrichment-view';
import { shareMessage, whatsappShareUrl } from '@/features/listings/share-message';
import {
  publicPlace,
  showListingMap,
  whatsappPrefill,
} from '@/features/listings/control-surface';
import { templateFor, templateSpec } from '@/features/templates/manifest';
import { toCells } from '../lib/facts';
import { DEMO_NOTE } from '../lib/template-pages';
import SectionLabel from './SectionLabel.astro';

interface Props {
  listing: Listing;
  /**
   * Forces noindex. Used by `/template-check/` so the CI fixtures cannot be
   * crawled as a second copy of the demo listings.
   */
  robots?: string;
  /** Editor phone: first screen and map legend stay clear of the fixed bars. */
  preview?: boolean;
  /**
   * An example page (/templates/{id}/demo/, a fixture at /a/{slug}). Every
   * contact button keeps its look and calls no one: WhatsApp points at the
   * demo bar's note and the phone number is dropped, so no call link is
   * drawn. The fixtures carry well-formed Israeli numbers that may belong to
   * real people (13 Oct 2026).
   */
  demo?: boolean;
}

/**
 * ONE template for both categories.
 *
 * Three of the four allowed divergences are selected by DATA, not by a
 * category check:
 *   price note   PriceBar branches on listPrice
 *   disclosures  rendered when the array is non-empty
 *   map          rendered when the location has a street
 *
 * The fourth — the hero block — comes from CATEGORY_PRESENTATION. That is the
 * only category lookup on the page, which is what keeps a fifth divergence
 * from appearing by accident.
 */
const { listing: shown, robots, preview = false, demo = false } = Astro.props;
const given: Listing = demo ? { ...shown, seller: { ...shown.seller, phone: '' } } : shown;
// A template drawn for the other category (Showroom on a flat) is drawn as
// its fallback instead — here, once, so BaseListing's data-template and every
// Stage below agree on what the page actually is.
const listing: Listing = { ...given, template: templateFor(given.template, given.category) };
const presentation = CATEGORY_PRESENTATION[listing.category];

const paragraphs = listing.description.split('\n\n');
const heading = tr(listing.category === 'property' ? 'על הדירה' : 'על הרכב');
const current = lang();
const languages = listing.status === 'published' ? pageLanguages(listing) : [];
const LANGUAGE_NAMES = { he: 'עברית', en: 'English', ru: 'Русский', ar: 'العربية' } as const;

// A vehicle has no street, so no map. See DESIGN-CONTRACT §5.4.
const showMap = showListingMap(listing.location);

/**
 * The neighbourhood drawn from real coordinates, when the address was looked
 * up. Undefined falls back to the generic pin card, which is the honest state
 * for a listing whose surroundings we have never fetched.
 */
const neighbourhoodMap = listing.areaPlaces ? areaMap(listing.areaPlaces) : undefined;

/**
 * ₪ per m², derived from the price and whichever fact the schema marks as the
 * denominator. A vehicle has no such fact and gets nothing — inventing a
 * price per kilometre would be worse than an empty line.
 */
const perUnit = perUnitPrice(listing.category, listing.facts, listing.price);

/**
 * Licence attributions, carried by the data rather than the template.
 *
 * A page that renders no OpenStreetMap places carries no ODbL credit, and a
 * page that gains a new attributed source cannot forget to add one. Hardcoding
 * it in the footer would make the credit depend on a template remembering.
 */
const attributions = [
  ...(listing.enrichment?.category === 'property' ? listing.enrichment.attributions : []),
  // The description's own sources, which are not the grid's. A page can owe
  // one, both, or neither — see Listing.textAttributions.
  ...(listing.textAttributions ?? []),
];

const sold = listing.status === 'sold';
const walkImages = [listing.media.cover, ...listing.media.gallery];
const walkItems = labeledWalkItems(walkImages);
const galleryImages = listing.media.gallery.filter((image) => !isWalkItem(image, walkItems));
const hasWalk = walkItems.length > 0;
const waMessage = whatsappPrefill(
  listing.category,
  listing.location ? publicPlace(listing.location) : undefined,
);
const waHref = demo ? DEMO_NOTE : `/a/${listing.slug}/wa?text=${encodeURIComponent(waMessage)}`;
const homeLabel = listing.category === 'property' ? t('listing.section.home') : t('listing.section.vehicle');

const shareCells = toCells(listing.category, listing.facts, listing.audience);

/**
 * gallery, showcase, aurora and blueprint compose their own first screen
 * (Stage) from the same data; the rest keep the shared hero and restyle it.
 * The choice rides on the TEMPLATE (its manifest entry), never on the
 * category, so the property and vehicle pages still differ only in the four
 * allowed ways.
 */
const spec = templateSpec(listing.template);
const composed = spec.composed;
/*
 * The stage's big numerals. Numbers first: a row of numerals reads as a spec
 * sheet, and "יש" set at 3rem does not; word-valued cells only fill in when
 * there are too few. The facts grid then skips them — the same number twice
 * on one screen is filler — unless the cell is מאומת, because the citation
 * lives in the grid and must not be lost.
 */
const presentCells = shareCells.filter((cell) => !cell.absent);
const stageCells = composed
  ? [...presentCells.filter((cell) => cell.bdi), ...presentCells.filter((cell) => !cell.bdi)].slice(
      0,
      spec.keyCells ?? 4,
    )
  : [];
const stageKeys = stageCells.filter((cell) => !cell.verified).map((cell) => cell.key);
const flatTitle = listing.title.replace(/\s*\n\s*/g, ' ');
const shareFacts = shareCells
  .filter((cell) => !cell.absent && cell.value !== tr('אין'))
  .filter((cell) => !(flatTitle.includes(cell.value) && flatTitle.includes(cell.label)))
  .slice(0, 4)
  .map((cell) => {
    if (cell.value === tr('יש')) return cell.label;
    if (cell.displayValue !== cell.value) return `${cell.label} ${cell.displayValue}`;
    return `${cell.value} ${cell.label}`;
  });
const sharePlace = listing.location?.street
  ? `${listing.location.street}, ${listing.location.city}`
  : listing.location?.city;
const pageUrl = new URL(languagePath(listing.slug, current), Astro.site).href;
const shareHref = whatsappShareUrl(
  shareMessage({
    title: listing.title,
    price: listing.price > 0 && listing.priceDisplay !== 'on_request' ? ils(listing.price) : '',
    ...(listing.shareLine ? { line: listing.shareLine } : {}),
    facts: shareFacts,
    ...(sharePlace ? { place: sharePlace } : {}),
    ...(listing.prePortal ? { prePortalLine: t('listing.prePortal') } : {}),
    url: pageUrl,
  }),
);
---
<BaseListing
  listing={listing}
  ogFactKeys={presentation.ogFactKeys}
  heroHeight={presentation.heroHeight}
  robots={robots}
  hasWalk={hasWalk}
  preview={preview}
>
  {composed ? (
    <Fragment>
      <Stage
        listing={listing}
        layout={composed}
        photos={walkImages}
        cells={stageCells}
        perUnit={perUnit}
        waHref={waHref}
        sold={sold}
      />
      {composed === 'gallery' && <AgentCard seller={listing.seller} waHref={waHref} sold={sold} />}
    </Fragment>
  ) : (
    <Fragment>
      <Hero
        cover={listing.media.cover}
        title={listing.title}
        location={listing.location}
        slug={listing.slug}
        watermarkUrl={
          listing.seller.logoPlacement === 'watermark' ? listing.seller.agencyLogoUrl : undefined
        }
      />

      <HeroThumbs images={walkImages} href={hasWalk ? '#walk-frame-0' : '#listing-gallery'} />
    </Fragment>
  )}

  {/* M7: CSS view-timeline reveals this after the hero (or walkFirst
      tour) leaves. Until then it is display:none / opacity:0, so it
      cannot sit under the dock on the first screen.
      Price only since 17 Oct 2026 (owner's decision after the audit): it
      carried a second WhatsApp button, so a reader saw two, and three at
      the contact block. The dock is the one WhatsApp within thumb reach.
      With no price to show there is no bar. */}
  {!sold && (listing.priceDisplay === 'on_request' || listing.price > 0) && (
    <div class="compact-bar">
      <span class="compact-price">
        {listing.priceDisplay === 'on_request' ? t('listing.priceOnRequest') : <bdi>{ils(listing.price)}</bdi>}
      </span>
    </div>
  )}

  {!composed && (
    <Fragment>
      <PriceBar {...priceProps(listing, perUnit)} />

      <HighlightChips highlights={listing.highlights} facts={listing.facts} />
    </Fragment>
  )}

  {/* Seller declaration, omitted when sold — urgency that the thing is
      gone is a different claim than "not yet on the portals". Never
      מאומת: we do not check Yad2 or Madlan (CLAUDE.md §10). */}
  {!sold && listing.prePortal ? (
    <p class="pre-portal">
      <strong>{t('listing.prePortal')}</strong>
      {' '}
      {t('listing.prePortalNote')}
    </p>
  ) : null}

  <FactsGrid
    category={listing.category}
    facts={listing.facts}
    audience={listing.audience}
    omit={stageKeys}
  />
  <MonthlyCost facts={listing.facts} />

  <section class="reveal about">
    <SectionLabel text={homeLabel} />
    <h2>{heading}</h2>
    {paragraphs[0] ? <p><Prose text={paragraphs[0]} /></p> : null}
    {paragraphs.length > 1 && (
      <details class="read-more">
        <summary>{t('listing.readMore')}</summary>
        {paragraphs.slice(1).map((paragraph) => (
          <p><Prose text={paragraph} /></p>
        ))}
      </details>
    )}
  </section>

  {listing.disclosures && listing.disclosures.length > 0 && (
    <Disclosures items={listing.disclosures} />
  )}

  <Walk
    images={walkImages}
    allPhotosHref={galleryImages.length > 0 ? '#listing-gallery' : undefined}
    floorPlan={listing.media.floorPlan}
    tourUrl={listing.media.tourUrl}
  />

  <Gallery
    images={galleryImages}
    film={[listing.media.cover, ...listing.media.gallery]}
    video={listing.media.video}
  />

  {/* Below the seller's own content, deliberately: what they came to publish
      comes first, and the enrichment is what makes the page worth forwarding
      (RESEARCH.md §5). */}
  {listing.enrichment && enrichmentHasContent(listing.enrichment) && (
    <Enrichment enrichment={listing.enrichment} />
  )}

  {showMap && listing.location && (
    <MapSection
      location={listing.location}
      enrichment={listing.enrichment?.category === 'property' ? listing.enrichment : undefined}
      areaMap={neighbourhoodMap}
      areaAttribution={listing.textAttributions?.[0]}
    />
  )}

  <SellerBlock
    seller={listing.seller}
    whatsappHref={waHref}
    shareHref={shareHref}
    sold={sold}
  />

  <Fragment slot="top"><slot name="top" /></Fragment>
  <Fragment slot="after">
    {/* A sold listing is a record, not a live offer. The WhatsApp dock would
        invite a message about something that is gone. */}
      <CtaDock
        href={demo ? DEMO_NOTE : undefined}
        phone={listing.seller.phone}
        message={waMessage}
        slug={listing.slug}
        sold={sold}
      />

    {/* נבנה עם עמוד מכירה is the viral loop (CLAUDE.md §8). Free listings keep it;
        a paid grant sets listing.hyadMark false and the mark comes off.
        The ODbL line is a LICENCE CONDITION, not a courtesy (§10). */}
    <footer>
      {/* The page in the languages the agent saved (0044), each named in itself. */}
      {languages.length > 1 && (
        <nav class="page-langs" aria-label={t('language.label')}>
          {languages.map((code) =>
            code === current ? (
              <span lang={code} aria-current="page">{LANGUAGE_NAMES[code]}</span>
            ) : (
              <a href={languagePath(listing.slug, code)} lang={code} hreflang={code}>{LANGUAGE_NAMES[code]}</a>
            ),
          )}
        </nav>
      )}
      {listing.hyadMark !== false && (
        <Fragment>{t('common.builtByPrefix')}<a href="/?src=credit">{t('common.brand')}</a></Fragment>
      )}
      {attributions.map((attribution) => (
        <Fragment><br /><span class="attribution"><Prose text={tr(attribution)} /></span></Fragment>
      ))}
      <br />
      <a href="/about/">{t('legal.about')}</a>
      {' · '}
      <a href="/contact/">{t('legal.contact')}</a>
      {' · '}
      <a href="/legal/terms/">{t('legal.terms')}</a>
      {' · '}
      <a href="/legal/privacy/">{t('legal.privacy')}</a>
      {' · '}
      <a href="/legal/accessibility/">{t('legal.accessibility')}</a>
      {current === 'he' && (
        <Fragment>
          {' · '}
          <a href="/guide/photos/">{t('guide.photosTitle')}</a>
        </Fragment>
      )}
    </footer>
  </Fragment>
</BaseListing>
