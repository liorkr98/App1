---
import type { Image } from '@/types/listing';
import type { ListingVideo } from '@/features/listings/rich-media';
import { photoAlt } from '@/features/listings/photo-alt';
import { groupByRoom, hasRoomLabels } from '@/features/listings/photo-rooms';
import { GALLERY_WIDTHS, largest, srcset } from '../lib/images';
import { t } from '../lib/i18n';
import Film from './Film.astro';
import { FILM_MIN } from '@/features/listings/ken-burns';

interface Props {
  images: Image[];
  /** Cover first, then the gallery. The film never reorders them. */
  film?: Image[];
  video?: ListingVideo;
}

const { images, film = [], video } = Astro.props;

const grouped = hasRoomLabels(images);
const groups = grouped ? groupByRoom(images) : [{ items: images }];
// Every photograph, labelled or not (13 Oct: a labelled listing's film was its
// cover alone), and no film at all under FILM_MIN.
const showFilm = Boolean(video) || film.length >= FILM_MIN;
---

{/*
  Asymmetric by CSS, not by markup: the first photograph spans both columns.
  The film is the next tile, also full width, in every template — a tile,
  not a new section, so the four-divergence gate is unchanged.

  When the seller named rooms, each room is its own grid. The film sits in
  the first group, after that group's first photograph.
*/}
{(images.length > 0 || showFilm) && (
  grouped ? (
    <div id="listing-gallery">
      {groups.map((group, groupIndex) => {
        const room = group.room ? t(`editor.rooms.${group.room}`) : undefined;
        const [first, ...rest] = group.items;
        return (
          <section class="gallery-room">
            {group.room ? <h2>{t(`editor.rooms.${group.room}`)}</h2> : null}
            <div class="gallery reveal">
              {first && (
                <figure>
                  <button
                    type="button"
                    class="gallery-open"
                    data-lightbox={largest(first, GALLERY_WIDTHS)}
                    data-alt={photoAlt(first, room)}
                  >
                    <img
                      src={largest(first, GALLERY_WIDTHS)}
                      srcset={srcset(first, GALLERY_WIDTHS) || undefined}
                      sizes="(max-width: 620px) 50vw, 310px"
                      width={first.width}
                      height={first.height}
                      alt={photoAlt(first, room)}
                      loading="lazy"
                      decoding="async"
                      class="clip-reveal"
                    />
                  </button>
                  {(first.caption || room) && <figcaption>{first.caption || room}</figcaption>}
                </figure>
              )}
              {groupIndex === 0 && showFilm ? <Film images={film} video={video} /> : null}
              {rest.map((image) => (
                <figure>
                  <button
                    type="button"
                    class="gallery-open"
                    data-lightbox={largest(image, GALLERY_WIDTHS)}
                    data-alt={photoAlt(image, room)}
                  >
                    <img
                      src={largest(image, GALLERY_WIDTHS)}
                      srcset={srcset(image, GALLERY_WIDTHS) || undefined}
                      sizes="(max-width: 620px) 50vw, 310px"
                      width={image.width}
                      height={image.height}
                      alt={photoAlt(image, room)}
                      loading="lazy"
                      decoding="async"
                      class="clip-reveal"
                    />
                  </button>
                  {(image.caption || room) && <figcaption>{image.caption || room}</figcaption>}
                </figure>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  ) : (
    <div id="listing-gallery" class="gallery reveal">
      {images[0] && (
        <figure>
          <button
            type="button"
            class="gallery-open"
            data-lightbox={largest(images[0], GALLERY_WIDTHS)}
            data-alt={photoAlt(images[0])}
          >
            <img
              src={largest(images[0], GALLERY_WIDTHS)}
              srcset={srcset(images[0], GALLERY_WIDTHS) || undefined}
              sizes="(max-width: 620px) 50vw, 310px"
              width={images[0].width}
              height={images[0].height}
              alt={photoAlt(images[0])}
              loading="lazy"
              decoding="async"
              class="clip-reveal"
            />
          </button>
          {images[0].caption && <figcaption>{images[0].caption}</figcaption>}
        </figure>
      )}
      {showFilm ? <Film images={film} video={video} /> : null}
      {images.slice(1).map((image) => (
        <figure>
          <button
            type="button"
            class="gallery-open"
            data-lightbox={largest(image, GALLERY_WIDTHS)}
            data-alt={photoAlt(image)}
          >
            <img
              src={largest(image, GALLERY_WIDTHS)}
              srcset={srcset(image, GALLERY_WIDTHS) || undefined}
              sizes="(max-width: 620px) 50vw, 310px"
              width={image.width}
              height={image.height}
              alt={photoAlt(image)}
              loading="lazy"
              decoding="async"
              class="clip-reveal"
            />
          </button>
          {image.caption && <figcaption>{image.caption}</figcaption>}
        </figure>
      ))}
    </div>
  )
)}
