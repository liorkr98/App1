---
import type { Image } from '@/types/listing';
import { GALLERY_WIDTHS, largest, srcset } from '../lib/images';

interface Props {
  images: Image[];
}

const { images } = Astro.props;
---
{/*
  Asymmetric by CSS, not by markup: .gallery figure:first-child spans both
  columns at 16/10 and the rest sit in pairs at 4/3. A uniform strip is what
  made the previous port read as a template.

  So the FIRST image is doing two jobs — it is index 0, the cover the
  WhatsApp card is cut from, and it is the one that gets the wide frame here.
  Photo order is the seller's, and it is load-bearing in two places at once.
*/}
<div class="gallery reveal">
  {images.map((image) => (
    <figure>
      <img
        src={largest(image, GALLERY_WIDTHS)}
        srcset={srcset(image, GALLERY_WIDTHS) || undefined}
        sizes="(max-width: 620px) 50vw, 310px"
        width={image.width}
        height={image.height}
        alt={image.alt ?? ''}
        loading="lazy"
        decoding="async"
      >
      {image.caption && <figcaption>{image.caption}</figcaption>}
    </figure>
  ))}
</div>
