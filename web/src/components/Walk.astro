---
import type { Image } from '@/types/listing';
import { groupByRoom, hasRoomLabels, type PhotoRoom } from '@/features/listings/photo-rooms';
import { GALLERY_WIDTHS, largest, srcset } from '../lib/images';
import { t } from '../lib/i18n';

interface Props {
  images: Image[];
}

const { images } = Astro.props;
const groups = hasRoomLabels(images)
  ? groupByRoom(images).filter(
      (group): group is { room: PhotoRoom; items: Image[] } => group.room !== undefined,
    )
  : [];
---
{/*
  A walk through the apartment, from the photographs the seller already took.

  Not Matterport and not a 360. Those are a different product, a different
  capture session, and a per-listing cost. This is the labelled stills in
  room order, snapped sideways, so a buyer on a phone flicks from the living
  room to the kitchen the way they would walk it.

  Omitted when nobody named a room — the same omit-empty rule as disclosures
  and the map. Inventing a tour from unlabeled photos would be a caption the
  seller did not write.
*/}
{groups.length > 0 && (
  <section class="walk reveal">
    <h2>{t('listing.walkTitle')}</h2>
    <nav class="walk-nav" aria-label={t('listing.walkTitle')}>
      {groups.map((group) => (
        <a href={`#walk-${group.room}`}>{t(`editor.rooms.${group.room}`)}</a>
      ))}
    </nav>
    <div class="walk-track">
      {groups.flatMap((group) =>
        group.items.map((image, index) => (
          <figure id={index === 0 ? `walk-${group.room}` : undefined}>
            <img
              src={largest(image, GALLERY_WIDTHS)}
              srcset={srcset(image, GALLERY_WIDTHS) || undefined}
              sizes="(max-width: 620px) 80vw, 480px"
              width={image.width}
              height={image.height}
              alt={image.alt ?? ''}
              loading="lazy"
              decoding="async"
            >
            <figcaption>{t(`editor.rooms.${group.room}`)}</figcaption>
          </figure>
        )),
      )}
    </div>
  </section>
)}
