---
import type { Image } from '@/types/listing';
import { groupByRoom, hasRoomLabels, type PhotoRoom } from '@/features/listings/photo-rooms';
import { GALLERY_WIDTHS, largest, srcset } from '../lib/images';
import { t } from '../lib/i18n';
import SectionLabel from './SectionLabel.astro';

interface Props {
  images: Image[];
  /** Jump target for "כל התמונות". Absent when the gallery below is empty. */
  allPhotosHref?: string;
}

const { images, allPhotosHref } = Astro.props;
const groups = hasRoomLabels(images)
  ? groupByRoom(images).filter(
      (group): group is { room: PhotoRoom; items: Image[] } => group.room !== undefined,
    )
  : [];

const slides = groups.flatMap((group) =>
  group.items.map((image) => ({ image, room: group.room })),
);

const firstIndexByRoom = new Map<PhotoRoom, number>();
slides.forEach((slide, index) => {
  if (!firstIndexByRoom.has(slide.room)) firstIndexByRoom.set(slide.room, index);
});
---
{/*
  A walk through the apartment, from the photographs the seller already took.

  Not Matterport and not a 360. The listing page has no JavaScript: the large
  photograph switches with radio buttons, the filmstrip is labels, and
  "התמונה הבאה" checks the next radio. Hash :target used to scroll the whole
  page so the picture landed on the editor's Back/Next dock.

  Omitted when nobody named a room — the same omit-empty rule as disclosures
  and the map. Inventing a tour from unlabeled photos would be a caption the
  seller did not write.
*/}
{slides.length > 0 && (
<section class="walk reveal">
    <SectionLabel text={t('listing.section.gallery')} />
    <h2>{t('listing.walkTitle')}</h2>
    <p class="walk-lead">{t('listing.walkLead')}</p>
    <div class="walk-viewer">
      <nav class="walk-film" aria-label={t('listing.filmstrip')}>
        {slides.map((slide, index) => (
          <label for={`walk-p${index}`} aria-label={t(`editor.rooms.${slide.room}`)}>
            {/*
              Radio lives inside the thumb it selects. A 1px radio at the
              top of the viewer used to steal focus-scroll and jump the page.
            */}
            <input
              class="walk-pick"
              type="radio"
              name="listing-walk"
              id={`walk-p${index}`}
              checked={index === 0 ? true : undefined}
            />
            <img
              src={largest(slide.image, GALLERY_WIDTHS)}
              srcset={srcset(slide.image, GALLERY_WIDTHS) || undefined}
              sizes="72px"
              width="72"
              height="72"
              alt=""
              loading="lazy"
              decoding="async"
            >
            <span class="walk-current">{t('listing.currentPhoto')}</span>
          </label>
        ))}
      </nav>
      <div class="walk-main">
        {slides.map((slide, index) => {
          const next = (index + 1) % slides.length;
          return (
            <figure>
              <div class="walk-frame">
                <img
                  src={largest(slide.image, GALLERY_WIDTHS)}
                  srcset={srcset(slide.image, GALLERY_WIDTHS) || undefined}
                  sizes="(max-width: 620px) 80vw, 480px"
                  width={slide.image.width}
                  height={slide.image.height}
                  alt={slide.image.alt ?? ''}
                  loading={index === 0 ? undefined : 'lazy'}
                  decoding="async"
                >
                <nav class="walk-chips" aria-label={t('listing.walkTitle')}>
                  {groups.map((group) => (
                    <label for={`walk-p${firstIndexByRoom.get(group.room) ?? 0}`}>{t(`editor.rooms.${group.room}`)}</label>
                  ))}
                </nav>
                {allPhotosHref && (
                  <a class="walk-all" href={allPhotosHref}>{t('listing.showAllPhotos')}</a>
                )}
                {slides.length > 1 && (
                  <label class="walk-next" for={`walk-p${next}`}>{t('listing.nextPhoto')}</label>
                )}
              </div>
              <figcaption>{t(`editor.rooms.${slide.room}`)}</figcaption>
            </figure>
          );
        })}
      </div>
    </div>
  </section>
)}
