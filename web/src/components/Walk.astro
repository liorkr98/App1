---
import type { Image } from '@/types/listing';
import { photoAlt } from '@/features/listings/photo-alt';
import { groupByRoom, hasRoomLabels, type PhotoRoom } from '@/features/listings/photo-rooms';
import { GALLERY_WIDTHS, largest, srcset } from '../lib/images';
import { t } from '../lib/i18n';
import SectionLabel from './SectionLabel.astro';

interface Props {
  images: Image[];
  /** Jump target for "כל התמונות". Absent when the gallery below is empty. */
  allPhotosHref?: string;
  floorPlan?: Image;
  tourUrl?: string;
}

const { images, allPhotosHref, floorPlan, tourUrl } = Astro.props;
const groups = hasRoomLabels(images)
  ? groupByRoom(images).filter(
      (group): group is { room: PhotoRoom; items: Image[] } => group.room !== undefined,
    )
  : [];

const slides = groups.flatMap((group) =>
  group.items.map((image) => ({
    image,
    room: group.room,
    label: t(`editor.rooms.${group.room}`),
  })),
);

if (floorPlan) {
  slides.push({ image: floorPlan, room: 'other' as PhotoRoom, label: t('listing.floorPlan') });
}

const firstIndexByRoom = new Map<string, number>();
slides.forEach((slide, index) => {
  if (!firstIndexByRoom.has(slide.label)) firstIndexByRoom.set(slide.label, index);
});

const show = slides.length > 0 || Boolean(tourUrl);
---
{/*
  A walk through the apartment, from the photographs the seller already took.

  M5 is the centre-active snap track on .walk-main. Radios still pick a frame
  without a hash jump; a few bytes of listing-enhance scroll the track into
  line. Floor plan and 3D-tour URL are chips here, not new sections.

  Omitted when nobody named a room and there is no plan or tour URL.
*/}
{show && (
<section class="walk reveal">
    <SectionLabel text={t('listing.section.gallery')} />
    <h2>{t('listing.walkTitle')}</h2>
    <p class="walk-lead">{t('listing.walkLead')}</p>
    <nav class="tour-chips" aria-label={t('listing.walkTitle')}>
      {groups.map((group) => (
        <label for={`walk-p${firstIndexByRoom.get(t(`editor.rooms.${group.room}`)) ?? 0}`}>
          {t(`editor.rooms.${group.room}`)}
        </label>
      ))}
      {floorPlan ? (
        <label for={`walk-p${slides.length - 1}`}>{t('listing.floorPlan')}</label>
      ) : null}
      {tourUrl ? (
        <a href={tourUrl} target="_blank" rel="noopener noreferrer">
          {t('listing.tourCta')}
          <span class="visually-hidden"> ({t('listing.newWindow')})</span>
        </a>
      ) : null}
    </nav>
    {slides.length > 0 && (
    <div class="walk-viewer">
      <nav class="walk-film" aria-label={t('listing.filmstrip')}>
        {slides.map((slide, index) => (
          <label for={`walk-p${index}`} aria-label={slide.label}>
            <input
              class="walk-pick"
              type="radio"
              name="listing-walk"
              id={`walk-p${index}`}
              checked={index === 0 ? true : undefined}
            />
            <img
              src={largest(slide.image, GALLERY_WIDTHS)}
              srcset={srcset(slide.image, GALLERY_WIDTHS) || undefined}
              sizes="72px"
              width="72"
              height="72"
              alt=""
              loading="lazy"
              decoding="async"
            >
            <span class="walk-current">{t('listing.currentPhoto')}</span>
          </label>
        ))}
      </nav>
      <div class="walk-main tour-track">
        {slides.map((slide, index) => {
          const next = (index + 1) % slides.length;
          const alt = photoAlt(slide.image, slide.label);
          return (
            <figure class="tour-card" id={`walk-frame-${index}`}>
              <div class="walk-frame">
                <button
                  type="button"
                  class="gallery-open"
                  data-lightbox={largest(slide.image, GALLERY_WIDTHS)}
                  data-alt={alt}
                >
                  <img
                    src={largest(slide.image, GALLERY_WIDTHS)}
                    srcset={srcset(slide.image, GALLERY_WIDTHS) || undefined}
                    sizes="(max-width: 620px) 80vw, 480px"
                    width={slide.image.width}
                    height={slide.image.height}
                    alt={alt}
                    loading={index === 0 ? undefined : 'lazy'}
                    decoding="async"
                  >
                </button>
                {allPhotosHref && (
                  <a class="walk-all" href={allPhotosHref}>{t('listing.showAllPhotos')}</a>
                )}
                {slides.length > 1 && (
                  <label class="walk-next" for={`walk-p${next}`}>{t('listing.nextPhoto')}</label>
                )}
              </div>
              <figcaption>{slide.label}</figcaption>
            </figure>
          );
        })}
      </div>
    </div>
    )}
  </section>
)}
