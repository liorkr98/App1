---
import Prose from './Prose.astro';

interface Props {
  items: string[];
}

const { items } = Astro.props;
---
{
  /**
   * Vehicle-only in practice, but the component asks for a list rather than a
   * category — a property with known defects should be able to use it.
   *
   * Its own framed block, deliberately not folded into the description: the
   * whole value is that a buyer can find the bad news without reading prose.
   * (DESIGN-CONTRACT §5.3)
   */
}
<section class="flaws reveal">
  <h2>מה שכדאי <span class="h2-num">לדעת</span></h2>
  <ul>
    {items.map((item) => (
      <li>
        {/* An olive dot, not a warning glyph. These are disclosures a seller
            chose to make, and marking them with a hazard sign would punish
            the honesty the block exists to reward. */}
        <span class="mark" aria-hidden="true"></span>
        <span><Prose text={item} /></span>
      </li>
    ))}
  </ul>
</section>
