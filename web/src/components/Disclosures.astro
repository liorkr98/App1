---
import Prose from './Prose.astro';
import { t } from '../lib/i18n';

interface Props {
  items: string[];
}

const { items } = Astro.props;
---
{
  /**
   * Vehicle-only in practice, but the component asks for a list rather than a
   * category — a property with known defects should be able to use it.
   *
   * Its own framed block, deliberately not folded into the description: the
   * whole value is that a buyer can find the bad news without reading prose.
   * (DESIGN-CONTRACT §5.3)
   *
   * Each disclosure is a labelled row (index + text), not an olive-dot list
   * and not a hazard colour. These are things a seller chose to say.
   */
}
<section class="flaws reveal">
  <h2>{t('listing.section.disclosures')}</h2>
  <ul>
    {items.map((item, index) => (
      <li>
        <span class="flaw-n"><bdi>{index + 1}</bdi></span>
        <span class="flaw-text"><Prose text={item} /></span>
      </li>
    ))}
  </ul>
</section>
