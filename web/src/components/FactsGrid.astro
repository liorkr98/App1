---
import type { Fact, ListingAudience } from '@/types/listing';
import type { ListingCategory } from '@/features/listings/schemas';
import { toCells } from '../lib/facts';
import { t } from '../lib/i18n';

interface Props {
  category: ListingCategory;
  facts: Fact[];
  /** Reorders the grid. Defaults to the resident reading. */
  audience?: ListingAudience;
  /**
   * Keys already shown as the stage's numerals. Never a verified cell —
   * ListingPage filters those out so the citation stays in the grid.
   */
  omit?: readonly string[];
}

const { category, facts, audience = 'resident', omit = [] } = Astro.props;

/**
 * Six present facts in the grid. Confirmed absences collapse into one
 * line — a wall of אין is the first thing a buyer used to scan. The rest
 * of the present facts sit in a disclosure, as a label · value list.
 *
 * value:null still produces no cell. Only a boolean can be absent.
 */
const cells = toCells(category, facts, audience);
const present = cells.filter((cell) => !cell.absent && !omit.includes(cell.key));
const absent = cells.filter((cell) => cell.absent);
const lead = present.slice(0, 6);
const rest = present.slice(6);
---
{lead.length > 0 && (
  <div class="facts">
    {lead.map((cell) => (
      <div class="fact">
        <div class="fact-val">
          {cell.bdi ? <bdi>{cell.displayValue}</bdi> : cell.displayValue}
        </div>
        <div class="fact-lbl">{cell.label}</div>
        {cell.verified && (
          <div class="fact-src">
            <span class="verified">מאומת</span>
            <span class="fact-cite">{cell.sourceName} · נכון ל־<bdi>{cell.sourceDate}</bdi></span>
          </div>
        )}
      </div>
    ))}
  </div>
)}

{absent.length > 0 && (
  <p class="absent-line">{t('listing.factsAbsent')}: {absent.map((cell) => cell.label).join(' · ')}</p>
)}

{rest.length > 0 && (
  <details class="facts-more">
    <summary>{t('listing.factsMore')}</summary>
    <dl class="spec-list">
      {rest.map((cell) => (
        <div>
          <dt>{cell.label}</dt>
          <dd>{cell.bdi ? <bdi>{cell.displayValue}</bdi> : cell.displayValue}</dd>
        </div>
      ))}
    </dl>
  </details>
)}
