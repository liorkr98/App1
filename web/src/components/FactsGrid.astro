---
import type { Fact, ListingAudience } from '@/types/listing';
import type { ListingCategory } from '@/features/listings/schemas';
import { toCells } from '../lib/facts';

interface Props {
  category: ListingCategory;
  facts: Fact[];
  /** Reorders the grid. Defaults to the resident reading. */
  audience?: ListingAudience;
}

const { category, facts, audience = 'resident' } = Astro.props;

/**
 * Cells come from the schema. No field name appears in this file, so a third
 * category renders here with no change.
 *
 * Three states, and the difference between the last two is the point:
 *   present: true, value set   normal cell
 *   present: false             35% opacity showing אין — the seller said no
 *   value: null                NO cell — the seller never answered
 *
 * Collapsing the last two would turn "we do not know" into "no", which is
 * what makes a listing page an ad instead of a description.
 *
 * A fourth thing this grid carries is provenance. A verified cell shows מאומת
 * and cites the body and the date beneath it; everything else is the seller's
 * word and is left unmarked. Marking BOTH classes would be noise — the reader
 * only needs to know which figures somebody else stands behind
 * (RESEARCH.md §4.7).
 */
const cells = toCells(category, facts, audience);
---
<div class="facts">
  {cells.map((cell) => (
    <div class={cell.absent ? 'fact off' : 'fact'}>
      <div class="fact-val">
        {cell.bdi ? <bdi>{cell.value}</bdi> : cell.value}
        {cell.pairedValue !== undefined && <Fragment> / <bdi>{cell.pairedValue}</bdi></Fragment>}
      </div>
      <div class="fact-lbl">{cell.label}</div>
      {cell.verified && (
        <div class="fact-src">
          <span class="verified">מאומת</span>
          <span class="fact-cite">{cell.sourceName} · נכון ל־<bdi>{cell.sourceDate}</bdi></span>
        </div>
      )}
    </div>
  ))}
</div>
