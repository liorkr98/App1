---
import { t } from '../lib/i18n';

interface Props {
  /** Digits only, international format without a plus, e.g. 972500000000. */
  phone: string;
  /** Public slug, so the tap is counted at /a/{slug}/wa before wa.me. */
  slug: string;
  /**
   * A sold listing is a record. The dock stops inviting a message about
   * something that is gone and points at more listings instead.
   */
  sold?: boolean;
  /** Overrides the WhatsApp route: an example page points at its note. */
  href?: string | undefined;
}

const { slug, sold = false, href: given } = Astro.props;

// The hop writes the message (control-surface.ts listingPrefill).
const href = sold ? '/' : (given ?? `/a/${slug}/wa`);
const label = sold ? t('listing.moreListings') : t('listing.whatsappCta');
---
{/*
  While the buyer reads, the bar folds to a round button at the inline end
  and opens again at the end of the page (listing.css, "the dock folds").
  Scroll-driven CSS only; the label stays in the link, so its name does not
  change. A sold listing keeps the full bar: it points at more listings.
*/}
<div class="cta-dock" data-fold={sold ? undefined : ''}>
  <a class="cta" href={href}>
    <span class="cta-label">{label}</span>
    {!sold && (
      <svg class="cta-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 5h16v11H9l-5 4z" />
      </svg>
    )}
  </a>
</div>
