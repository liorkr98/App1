---
import type { ListingLocation, PropertyEnrichment } from '@/types/listing';
import type { AreaMap as AreaMapData } from '@/features/listings/area-map';
import { mapNearbyItems } from '@/features/listings/nearby-map';
import { composedMapSrc } from '@/features/listings/area-map';
import { googleMapsUrl, navigationTarget, wazeNavigateUrl } from '@/features/listings/map-card';
import { publicPlace } from '@/features/listings/control-surface';
import { t } from '../lib/i18n';
import AreaMap from './AreaMap.astro';
import Prose from './Prose.astro';
import SectionLabel from './SectionLabel.astro';
import WalkMinutes from './WalkMinutes.astro';

interface Props {
  location: ListingLocation;
  enrichment?: PropertyEnrichment;
  /**
   * The neighbourhood drawn from OpenStreetMap coordinates, when the address
   * was looked up. Without it the section is the street line alone.
   */
  areaMap?: AreaMapData | undefined;
  areaAttribution?: string | undefined;
}

const { location, enrichment, areaMap, areaAttribution } = Astro.props;

const address = publicPlace(location);
const nearby = enrichment ? mapNearbyItems(enrichment) : [];
const point = navigationTarget(location);
const waze = point ? wazeNavigateUrl(point.lat, point.lng) : undefined;
const google = point ? googleMapsUrl(point.lat, point.lng) : undefined;
const zoomSrc = areaMap ? composedMapSrc(areaMap) : undefined;
---
{
  /**
   * Property only (DESIGN-CONTRACT §5.4). A vehicle's location is an
   * approximate meeting area, not an address; pinning a private car for sale
   * to a home address on a public page is a theft risk.
   *
   * Where the address was looked up, AreaMap draws the neighbourhood and a
   * live map loads over it once the section nears the screen
   * (scripts/listing-map.ts; CLAUDE.md §2, the 5 Oct 2026 map note).
   *
   * NO PIN, EVER (7 Oct 2026). Without a looked-up neighbourhood this used to
   * show a drawn street grid with a big location pin in the middle — a pin on
   * nothing, which read as "this building" on a page whose rule is "the street
   * area only". Now the section is the street line alone, and the dashboard
   * offers to look the area up again. No live query at render.
   */
}
<section class="map reveal">
  <SectionLabel text={t('listing.section.map')} />
  <h2>{t('listing.mapTitle')}</h2>

  {areaMap && areaAttribution ? <AreaMap map={areaMap} attribution={areaAttribution} /> : null}

  <div class="addr"><Prose text={address} /></div>
  {(waze || google) && (
    <div class="map-links">
      {waze && (
        <a class="map-nav" href={waze} rel="noopener noreferrer">{t('listing.mapNavigate')}</a>
      )}
      {google && (
        <a class="map-nav" href={google} rel="noopener noreferrer">{t('listing.mapGoogle')}</a>
      )}
    </div>
  )}

  {zoomSrc && (
    <dialog id="listing-map" class="map-dialog" aria-label={t('listing.mapTitle')}>
      <button type="button" class="lightbox-close" data-map-close>{t('listing.closeLightbox')}</button>
      <div class="map-zoom">
        <img src={zoomSrc} alt="" width="4800" height="3000" />
      </div>
    </dialog>
  )}
  {nearby.length > 0 && (
    <ul class="map-nearby">
      {nearby.map((item) => (
        <li>
          <span class="map-nearby-kind">{t(`listing.mapNearby.${item.kind}`)}</span>
          <b><Prose text={item.name} /></b>
          <span class="map-nearby-walk"><WalkMinutes minutes={item.walkMinutes} walking /></span>
        </li>
      ))}
    </ul>
  )}
</section>
