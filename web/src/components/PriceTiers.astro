---
import { planByKey } from '@/features/billing/price';
import { amount, noteValues, termsPath } from '../lib/plan-copy';
import { t } from '../lib/i18n';
import Msg from './Msg.astro';

/**
 * The homepage price strip. Every number comes from
 * src/features/billing/pricing-config.ts, like /pricing; launch prices
 * appear only once a real seat count proves one remains (lib/launch-offer).
 * Each card points at /pricing. DISPLAY ONLY (CLAUDE.md §8).
 */
const cards = [
  { regular: planByKey('free'), launch: null },
  { regular: planByKey('agent'), launch: planByKey('agent_launch') },
  { regular: planByKey('private_sale'), launch: null },
];
---

<ul class="price-tiers is-compact">
  {cards.map(({ regular, launch }) => (
    <li class:list={['price-tier', regular.key === 'agent' && 'is-featured']} data-card={launch?.key}>
      <a href="/pricing/">
        <p class="price-tier-name">{t(`billing.plans.${regular.key}`)}</p>
        <div class="price-tier-variants">
        <div data-variant="regular">
          <p class:list={['price-tier-sum', regular.key === 'free' && 'is-free']}><Msg path={termsPath(regular)} values={{ price: amount(regular) }} /></p>
          <p class="price-tier-note"><Msg path={`billing.notes.${regular.key}`} values={noteValues(regular)} /></p>
        </div>
        {launch && (
          <div data-variant="launch" class="is-off">
            <p class="price-tier-flag">{t('billing.launchFlag')}</p>
            <p class="price-tier-sum"><Msg path={termsPath(launch)} values={{ price: amount(launch) }} /></p>
            <p class="price-tier-note"><Msg path={`billing.notes.${launch.key}`} values={noteValues(launch)} /></p>
          </div>
        )}
        </div>
      </a>
    </li>
  ))}
</ul>

<script>
  import { showLaunchOffers } from '../lib/launch-offer';
  void showLaunchOffers();
</script>
<style>
  .price-tiers {
    list-style: none;
    display: grid;
    gap: 1rem;
    margin-block: 0;
    padding: 0;
  }

  @media (min-width: 560px) {
    .price-tiers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: stretch;
    }
  }

  @media (min-width: 960px) {
    .price-tiers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Living Surfaces tokens, so the strip reads on the Onyx homepage: on
     the old fixed tokens it was a cream card with the page's light ink on
     it, unreadable (design audit, 14 Oct 2026). Flat surfaces, no lines. */
  .price-tier {
    border-radius: var(--ls-r-card);
    padding: 1.25rem 1.2rem 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    background: var(--ls-surface);
    color: var(--ls-ink);
    min-block-size: 100%;
  }

  .price-tier > a {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    color: inherit;
    text-decoration: none;
    min-block-size: 100%;
  }

  .price-tier-flag {
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--ls-accent);
    margin: 0;
  }

  .price-tier-name {
    font-size: 1rem;
    font-weight: 800;
    margin: 0;
  }

  /* Both prices in one cell, trading visibility: no layout shift (pricing.css). */
  .price-tier-variants {
    display: grid;
  }

  .price-tier-variants > :global(*) {
    grid-area: 1 / 1;
  }

  .price-tier-variants > :global(.is-off) {
    visibility: hidden;
  }

  .price-tier-sum {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
    margin: 0.15rem 0 0.1rem;
  }

  /* The number is the card's headline; לחודש + מע״מ sits beside it. */
  /* "Free" is the free card's price, so it takes the price's type, not a
     body line beside the others' display figures (audit, 17 Oct 2026). */
  .price-tier-sum.is-free,
  .price-tier-sum :global(bdi) {
    font-family: var(--ls-font-display);
    font-size: clamp(2rem, 4vw, 2.55rem);
    font-weight: 800;
    line-height: 1.05;
    margin-inline-end: 0.25rem;
  }

  .price-tier-note {
    color: var(--ls-ink-2);
    font-size: 1rem;
    line-height: 1.55;
    margin: 0;
    max-inline-size: 28ch;
  }

  .price-tier.is-featured {
    background: var(--ls-ink);
    color: var(--ls-ground);
  }

  .price-tier.is-featured .price-tier-flag,
  .price-tier.is-featured .price-tier-note {
    color: color-mix(in srgb, var(--ls-ground) 72%, var(--ls-ink));
  }

  .is-compact .price-tier {
    padding: 1.1rem 1.05rem 1.2rem;
  }
</style>
