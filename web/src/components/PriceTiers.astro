---
import { ils } from '../lib/format';
import { t } from '../lib/i18n';

interface Props {
  /** Home strip: no checkout controls, each card points at /pricing. */
  compact?: boolean;
}

const { compact = false } = Astro.props;

const tiers = [
  { id: 'single', price: 79, featured: false },
  { id: 'pack', price: 129, featured: false },
  { id: 'agent', price: 249, featured: true },
] as const;
---

{/*
  Three cards, not a run-on line. The agent tier is the one the product is
  for, so it is a dark panel with a text flag — not a second colour, and not
  the same outlined box repeated three times.

  Checkout is disabled until an Israeli PSP is wired (ADR 0003). The control
  stays visible and honest: "עדיין לא פתוח", not a fake pay button.
*/}
<ul class:list={['price-tiers', compact && 'is-compact']}>
  {
    tiers.map((tier) => {
      const inner = (
        <>
          {tier.featured ? <p class="price-tier-flag">{t('pricing.agentFlag')}</p> : null}
          {tier.featured ? null : <p class="price-tier-name">{t(`pricing.${tier.id}`)}</p>}
          <p class="price-tier-sum"><bdi>{ils(tier.price)}</bdi></p>
          <p class="price-tier-note">{t(`pricing.${tier.id}Note`)}</p>
          {compact ? null : (
            <button type="button" disabled>
              {t('pricing.disabled')}
            </button>
          )}
        </>
      );

      return compact ? (
        <li class:list={['price-tier', tier.featured && 'is-featured']}>
          <a href="/pricing/">{inner}</a>
        </li>
      ) : (
        <li class:list={['price-tier', tier.featured && 'is-featured']}>{inner}</li>
      );
    })
  }
</ul>

<style>
  .price-tiers {
    list-style: none;
    display: grid;
    gap: 1rem;
    margin-block: 0;
    padding: 0;
  }

  @media (min-width: 720px) {
    .price-tiers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
    }
  }

  .price-tier {
    border: 1px solid var(--stone);
    border-radius: 14px;
    padding: 1.25rem 1.2rem 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    background: var(--plaster);
    min-block-size: 100%;
  }

  .price-tier > a {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    color: inherit;
    text-decoration: none;
    min-block-size: 100%;
  }

  .price-tier-flag {
    font-size: var(--t-label);
    font-weight: 700;
    color: var(--olive);
    margin: 0;
  }

  .price-tier-name {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0;
  }

  .price-tier-sum {
    font-family: 'Frank Ruhl Libre', serif;
    font-size: clamp(2rem, 4vw, 2.55rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.015em;
    margin: 0.15rem 0 0.1rem;
  }

  .price-tier-note {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
    margin: 0;
    max-inline-size: 28ch;
  }

  .price-tier button {
    margin-block-start: auto;
    padding: 0.7rem 1rem;
    min-block-size: 44px;
    border: 1px solid var(--stone);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-weight: 700;
  }

  .price-tier.is-featured {
    background: var(--ink-deep);
    color: var(--plaster);
    border-color: var(--ink-deep);
    padding-block: 1.45rem;
  }

  .price-tier.is-featured .price-tier-flag {
    /* 6.94:1 on ink-deep. Olive on this ground fails AA at this size. */
    color: #9c9d93;
  }

  .price-tier.is-featured .price-tier-note {
    color: rgba(251, 250, 247, 0.78);
  }

  .price-tier.is-featured button {
    /* Opacity on the whole control dropped plaster-on-olive below AA. */
    background: var(--olive);
    color: var(--plaster);
    border-color: var(--olive);
  }

  .is-compact .price-tier {
    padding: 1.1rem 1.05rem 1.2rem;
  }
</style>
