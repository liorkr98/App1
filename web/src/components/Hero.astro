---
import type { Image, ListingLocation } from '@/types/listing';
import { HERO_WIDTHS, largest, srcset } from '../lib/images';
import Prose from './Prose.astro';

interface Props {
  cover: Image;
  /** Newlines become <br>, matching the reference titles. */
  title: string;
  location?: ListingLocation;
  /** Corner mark when the profile chose watermark. Empty alt: the agency name is in the bar. */
  watermarkUrl?: string;
}

const { cover, title, location, watermarkUrl } = Astro.props;

const place = location?.street ? `${location.street}, ${location.city}` : (location?.city ?? '');

const lines = title.split('\n');

function focalPercent(value: number | undefined): number | undefined {
  if (value == null || !Number.isFinite(value)) return undefined;
  return Math.min(100, Math.max(0, value));
}

const focalX = focalPercent(cover.focalX);
const focalY = focalPercent(cover.focalY);
const objectPosition =
  focalX != null || focalY != null ? `${focalX ?? 50}% ${focalY ?? 50}%` : undefined;
---
{/*
  The LCP element. fetchpriority="high", explicit dimensions, never lazy.

  The parallax lives entirely in CSS (.hero-img, behind @supports
  animation-timeline). Nothing here knows the image moves.
*/}
<section class="hero">
  <img
    class="hero-img"
    src={largest(cover, HERO_WIDTHS)}
    srcset={srcset(cover, HERO_WIDTHS) || undefined}
    sizes="(max-width: 620px) 100vw, 620px"
    width={cover.width}
    height={cover.height}
    alt={cover.alt ?? ''}
    style={objectPosition ? `object-position:${objectPosition}` : undefined}
    fetchpriority="high"
    decoding="async"
  >
  {watermarkUrl ? (
    <img class="hero-watermark" src={watermarkUrl} alt="" width="72" height="72" />
  ) : null}
  <div class="hero-veil">
    {place && <div class="hero-place"><Prose text={place} /></div>}
    <h1 class="hero-title">
      {lines.map((line) => (
        <span class="hero-line">
          <span><Prose text={line} /></span>
        </span>
      ))}
    </h1>
  </div>
</section>
