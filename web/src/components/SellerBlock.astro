---
import { canonicalSellerRole } from '@/features/agents/profile';
import type { Seller } from '@/types/listing';
import { displayPhone, telHref } from '@/features/listings/phone';
import { t } from '../lib/i18n';
import SectionLabel from './SectionLabel.astro';

interface Props {
  seller: Seller;
  /** WhatsApp to the agent. Omitted when the listing is sold. */
  whatsappHref?: string;
  /** Pre-composed forward message. Buyer sharing, not contacting. */
  shareHref?: string;
  sold?: boolean;
}

const { seller, whatsappHref, shareHref, sold = false } = Astro.props;
const sellerRole = seller.role ? canonicalSellerRole(seller.role) : '';

/**
 * A person photo, or the agency mark when the profile put the logo only
 * in this card (footerOnly). Bar / watermark placements already show the
 * mark elsewhere — repeating it here as an empty-looking disc is the
 * P0 tell. No photo and no footer logo → no disc.
 */
const photo =
  seller.avatarUrl ??
  (seller.logoPlacement === 'footerOnly' ? seller.agencyLogoUrl : undefined);

const callHref = telHref(seller.phone);
const phoneLabel = displayPhone(seller.phone);
---
{/*
  Agents are the primary audience (CLAUDE.md §1), so their name appears at
  the top of the page and again here at the bottom — the two positions a
  reader actually looks at. The tinted ground separates it from the seller's
  own content above without another hairline.
*/}
<section class="seller">
  <SectionLabel text={t('listing.section.seller')} />
  <div class="seller-row">
    {photo ? (
      <div class="avatar" aria-hidden="true">
        <img src={photo} alt="" />
      </div>
    ) : null}
    <div>
      <div class="seller-name">{seller.name}</div>
      {/*
        Role and agency on one line, separated by a middot, rather than two
        stacked lines. They are one answer to one question — who is this
        person — and stacking them gives the agency its own line of weight it
        has not earned this far down the page. The agent bar at the top is
        where the agency is the headline.
      */}
      {(sellerRole || seller.agencyName) && (
        <div class="seller-role">
          {sellerRole}
          {sellerRole && seller.agencyName && ' · '}
          {seller.agencyName}
        </div>
      )}
      {/*
        Plain text, deliberately no class of its own beyond the muted role
        line's styling. This is the agent's own legal declaration under the
        Real Estate Brokers Regulations (2024), not a fact this product
        checked — so it must never pick up the .verified chip's border or
        colour (docs/OPPORTUNITIES.md §1a). The number goes in <bdi>: it is a
        run of digits inside a Hebrew line (CLAUDE.md §4.2).
      */}
      {seller.licenceNumber && (
        <div class="seller-role">רישיון מס׳ <bdi>{seller.licenceNumber}</bdi></div>
      )}
      {/*
        מאומת · פנקס המתווכים only when the register matched at signup.
        licenceVerified is never inferred from the presence of a number — an
        unbacked badge is worse than none (CLAUDE.md §7).
      */}
      {seller.licenceVerified && (
        <div class="verified">{t('listing.licenceVerified')}</div>
      )}
      {phoneLabel && (
        <div class="seller-role"><bdi>{phoneLabel}</bdi></div>
      )}
    </div>
  </div>

  {!sold && (
    <div class="seller-actions">
      {callHref && (
        <a class="seller-action" href={callHref}>{t('listing.callCta')}</a>
      )}
      {whatsappHref && (
        <a class="seller-action seller-action-wa" href={whatsappHref}>{t('listing.whatsappShort')}</a>
      )}
    </div>
  )}
  {shareHref && !sold && (
    <a class="seller-share" href={shareHref}>{t('listing.share')}</a>
  )}
</section>
