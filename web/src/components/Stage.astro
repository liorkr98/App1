---
import type { Image, Listing } from '@/types/listing';
import type { ComposedLayout } from '@/features/templates/manifest';
import { labeledWalkItems } from '@/features/listings/photo-rooms';
import { GALLERY_WIDTHS, HERO_WIDTHS, largest, srcset } from '../lib/images';
import type { FactCell } from '../lib/facts';
import { t } from '../lib/i18n';
import type { PerUnitPrice } from '../lib/price';
import AgentCard from './AgentCard.astro';
import HighlightChips from './HighlightChips.astro';
import PriceBar from './PriceBar.astro';
import Prose from './Prose.astro';
import AtelierStage from './stages/AtelierStage.astro';
import GlassStage from './stages/GlassStage.astro';
import MonolithStage from './stages/MonolithStage.astro';
import ShowroomStage from './stages/ShowroomStage.astro';

interface Props {
  listing: Listing;
  /** Which composed layout (TEMPLATE_MANIFEST). Token templates never reach here. */
  layout: ComposedLayout;
  /** Cover first, then the gallery — the same order the walk uses. */
  photos: Image[];
  /** The numerals, already chosen by ListingPage (so the grid can skip them). */
  cells: FactCell[];
  perUnit?: PerUnitPrice;
  waHref: string;
  sold: boolean;
}

const { listing, layout, photos, cells, perUnit, waHref, sold } = Astro.props;

/**
 * THE FIRST SCREEN, composed per template (TEMPLATE_MANIFEST.composed).
 *
 * The seven token templates share one head — hero, thumbs, price bar — and
 * restyle it, which is why agents said they all looked the same. These three
 * compose a different head from the same data:
 *
 *   gallery   a photo mosaic, then title, price and big numerals beside a
 *             sticky agent card (the card is rendered by ListingPage so it can
 *             stick for the whole page, not just this section)
 *   aurora    (was cinema) the cover full-bleed under a breathing accent
 *             glow, a giant condensed title, and a glass panel with the key
 *             numbers and the plan. Living Surfaces, Onyx.
 *   blueprint the floor plan first, drawn onto a drafting grid, with a room
 *             viewer: pick a room, see its photograph. Without a plan the
 *             plan scene is omitted and the viewer runs on rooms alone.
 *             Living Surfaces, Paper.
 *   showcase  headline, a rounded photograph and a card beside it carrying
 *             the numbers, the price and the agent
 *   monolith, atelier, glass, showroom
 *             one component each in ./stages/ — see their headers.
 *
 * Everything below the first screen is the shared flow — facts, provenance,
 * enrichment, map, seller — so the rules those components enforce (absent vs
 * unanswered, מאומת only with a source, bdi on every number) are enforced
 * here by construction rather than re-implemented.
 *
 * Numerals count up only where the cell says so (countFrom: m² only). The
 * formatted value is in the HTML; the script only animates towards it.
 */

const cover = listing.media.cover;
const lines = listing.title.split('\n');
const place = listing.location?.street
  ? `${listing.location.street}, ${listing.location.city}`
  : (listing.location?.city ?? '');

const key = cells;
const roomLabel = (image: Image) => (image.room ? t(`editor.rooms.${image.room}`) : undefined);
const mosaic = photos.slice(0, 5);
const floorPlan = listing.media.floorPlan;

// Blueprint's room viewer: the first photo of each labelled room, in walk
// order. Unlabelled photos give no rooms, and the viewer shows the cover.
const rooms = labeledWalkItems(photos).filter(
  (image, index, all) => all.findIndex((other) => other.room === image.room) === index,
);
const shots = rooms.length > 0 ? rooms : [cover];

// The cover is named for the dashboard→listing morph (M11); the dashboard
// card gives its image the same name.
const objectPosition = [
  cover.focalX != null || cover.focalY != null
    ? `object-position:${cover.focalX ?? 50}% ${cover.focalY ?? 50}%`
    : '',
  `view-transition-name:cover-${listing.slug}`,
]
  .filter(Boolean)
  .join(';');

const priceProps = {
  price: listing.price,
  listPrice: listing.listPrice,
  priceNote: listing.priceNote,
  priceDisplay: listing.priceDisplay,
  perUnit,
};
---
{layout === 'gallery' && (
  <section class="stage stage-gallery">
    <div class="mosaic" data-tiles={mosaic.length}>
      {mosaic.map((image, index) => (
        <button
          type="button"
          class="mosaic-tile"
          data-lightbox={largest(image, HERO_WIDTHS)}
          data-alt={image.alt ?? ''}
          data-room={roomLabel(image)}
          aria-label={t('listing.openPhoto')}
        >
          <img
            src={largest(image, index === 0 ? HERO_WIDTHS : GALLERY_WIDTHS)}
            srcset={srcset(image, index === 0 ? HERO_WIDTHS : GALLERY_WIDTHS) || undefined}
            sizes={index === 0 ? '(min-width: 960px) 55vw, 100vw' : '(min-width: 960px) 22vw, 80vw'}
            width={image.width}
            height={image.height}
            alt={image.alt ?? ''}
            style={index === 0 ? objectPosition : undefined}
            fetchpriority={index === 0 ? 'high' : undefined}
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
          {image.room && <span class="mosaic-room">{roomLabel(image)}</span>}
        </button>
      ))}
      {photos.length > 1 && (
        <a class="mosaic-all" href="#listing-gallery">
          {t('listing.showAllPhotos')} <bdi>{photos.length}</bdi>
        </a>
      )}
    </div>

    <div class="stage-body">
      {place && <p class="stage-place"><Prose text={place} /></p>}
      <h1 class="stage-title">
        {lines.map((line) => (
          <span class="hero-line"><span><Prose text={line} /></span></span>
        ))}
      </h1>
      <PriceBar {...priceProps} />
      {key.length > 0 && (
        <dl class="numerals" aria-label={t('listing.keyFacts')}>
          {key.map((cell) => (
            <div>
              <dt>{cell.label}</dt>
              <dd>
                {cell.bdi ? (
                  <bdi data-count={cell.countFrom}>{cell.displayValue}</bdi>
                ) : (
                  cell.displayValue
                )}
              </dd>
            </div>
          ))}
        </dl>
      )}
      <HighlightChips highlights={listing.highlights} facts={listing.facts} />
    </div>
  </section>
)}

{layout === 'aurora' && (
  <section class="stage stage-aurora ls-grain">
    <div class="cine-frame">
      {/* The accent, breathing behind the title. Depth parallax (M6) lands
          here in P7, once the worker produces a depth map per cover. */}
      <span class="aurora-glow" aria-hidden="true"></span>
      <img
        class="cine-img ls-breathe"
        src={largest(cover, HERO_WIDTHS)}
        srcset={srcset(cover, HERO_WIDTHS) || undefined}
        sizes="100vw"
        width={cover.width}
        height={cover.height}
        alt={cover.alt ?? ''}
        style={objectPosition}
        fetchpriority="high"
        decoding="async"
      />
      <span class="cine-rules" aria-hidden="true"><span></span><span></span><span></span></span>
      <div class="cine-head">
        {place && <p class="stage-place"><Prose text={place} /></p>}
        {/* Living Surfaces (P2 proof): condensed display face, lines rise
            (M1) and the width axis tightens as the title scrolls away (M3). */}
        <h1 class="stage-title ls-display ls-swell">
          {lines.map((line, i) => (
            <span class="ls-line"><span style={`--i:${i}`}><Prose text={line} /></span></span>
          ))}
        </h1>
      </div>
    </div>

    {key.length > 0 && (
      <div class="cine-panel ls-glass" data-metric>
        <ol class="cine-metrics" aria-label={t('listing.keyFacts')}>
          {key.map((cell, index) => (
            <li class:list={['cine-metric', { 'is-on': index === 0 }]}>
              <span class="cine-metric-lbl">{cell.label}</span>
              <span class="cine-metric-val">
                {cell.bdi ? <bdi data-count={cell.countFrom}>{cell.displayValue}</bdi> : cell.displayValue}
              </span>
            </li>
          ))}
        </ol>
        {key.length > 1 && (
          <div class="cine-steps">
            <button type="button" data-metric-step="-1" aria-label={t('listing.metricPrev')}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" data-metric-step="1" aria-label={t('listing.metricNext')}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        )}
        {floorPlan ? (
          <button
            type="button"
            class="cine-plan"
            data-lightbox={largest(floorPlan, HERO_WIDTHS)}
            data-alt={floorPlan.alt ?? t('listing.floorPlan')}
            aria-label={t('listing.floorPlan')}
          >
            <img src={largest(floorPlan, GALLERY_WIDTHS)} alt="" width={floorPlan.width} height={floorPlan.height} loading="lazy" decoding="async" />
          </button>
        ) : photos.length > 1 ? (
          <div class="cine-thumbs">
            {photos.slice(1, 3).map((image) => (
              <button
                type="button"
                data-lightbox={largest(image, HERO_WIDTHS)}
                data-alt={image.alt ?? ''}
                data-room={roomLabel(image)}
                aria-label={t('listing.openPhoto')}
              >
                <img src={largest(image, GALLERY_WIDTHS)} alt="" width="120" height="120" loading="lazy" decoding="async" />
              </button>
            ))}
          </div>
        ) : null}
      </div>
    )}

    <div class="cine-band">
      <PriceBar {...priceProps} />
      {!sold && (
        <a class="cine-cta ls-sheen" href={waHref}>{t('listing.whatsappCta')}</a>
      )}
      <HighlightChips highlights={listing.highlights} facts={listing.facts} />
    </div>
  </section>
)}

{layout === 'blueprint' && (
  <section class="stage stage-blueprint">
    <div class="bp-head">
      {place && <p class="stage-place"><Prose text={place} /></p>}
      <h1 class="stage-title ls-display">
        {lines.map((line, i) => (
          <span class="ls-line"><span style={`--i:${i}`}><Prose text={line} /></span></span>
        ))}
      </h1>
      <PriceBar {...priceProps} />
    </div>

    <div class:list={['bp-board', { 'has-plan': Boolean(floorPlan) }]}>
      {floorPlan && (
        <button
          type="button"
          class="bp-plan"
          data-lightbox={largest(floorPlan, HERO_WIDTHS)}
          data-alt={floorPlan.alt ?? t('listing.floorPlan')}
          aria-label={t('listing.floorPlan')}
        >
          <img
            src={largest(floorPlan, HERO_WIDTHS)}
            alt=""
            width={floorPlan.width}
            height={floorPlan.height}
            decoding="async"
          />
          <span class="bp-plan-tag">{t('listing.floorPlan')}</span>
        </button>
      )}
      <figure class="bp-viewer" data-bp-viewer>
        {shots.map((image, index) => (
          <img
            class:list={['bp-shot', { 'is-on': index === 0 }]}
            src={largest(image, HERO_WIDTHS)}
            srcset={srcset(image, HERO_WIDTHS) || undefined}
            sizes="(min-width: 960px) 50vw, 100vw"
            width={image.width}
            height={image.height}
            alt={image.alt ?? ''}
            style={image === cover ? objectPosition : undefined}
            fetchpriority={index === 0 ? 'high' : undefined}
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
            data-bp-shot={index}
          />
        ))}
        {shots[0] && roomLabel(shots[0]) && (
          <figcaption class="bp-label" aria-live="polite">{roomLabel(shots[0])}</figcaption>
        )}
      </figure>
    </div>

    {/* Rooms as chips. Hidden until the script can act on them: a button
        that does nothing is worse than no button. Every photo is in the tour
        and gallery below either way. */}
    {rooms.length > 1 && (
      <div class="bp-rooms" role="group" aria-label={t('listing.blueprintRooms')} hidden>
        {rooms.map((image, index) => (
          <button type="button" data-bp-room={index} aria-pressed={index === 0 ? 'true' : 'false'}>
            {roomLabel(image)}
          </button>
        ))}
      </div>
    )}

    {key.length > 0 && (
      <dl class="numerals" aria-label={t('listing.keyFacts')}>
        {key.map((cell) => (
          <div>
            <dt>{cell.label}</dt>
            <dd>
              {cell.bdi ? <bdi data-count={cell.countFrom}>{cell.displayValue}</bdi> : cell.displayValue}
            </dd>
          </div>
        ))}
      </dl>
    )}
    <HighlightChips highlights={listing.highlights} facts={listing.facts} />
  </section>
)}

{layout === 'showcase' && (
  <section class="stage stage-showcase">
    <div class="show-head">
      {place && <p class="stage-place"><Prose text={place} /></p>}
      <h1 class="stage-title">
        {lines.map((line) => (
          <span class="hero-line"><span><Prose text={line} /></span></span>
        ))}
      </h1>
    </div>
    <div class="show-grid">
      <button
        type="button"
        class="show-photo"
        data-lightbox={largest(cover, HERO_WIDTHS)}
        data-alt={cover.alt ?? ''}
        data-room={roomLabel(cover)}
        aria-label={t('listing.openPhoto')}
      >
        <img
          src={largest(cover, HERO_WIDTHS)}
          srcset={srcset(cover, HERO_WIDTHS) || undefined}
          sizes="(min-width: 960px) 60vw, 100vw"
          width={cover.width}
          height={cover.height}
          alt={cover.alt ?? ''}
          style={objectPosition}
          fetchpriority="high"
          decoding="async"
        />
      </button>
      <div class="show-card">
        {key.length > 0 && (
          <dl class="numerals" aria-label={t('listing.keyFacts')}>
            {key.map((cell) => (
              <div>
                <dt>{cell.label}</dt>
                <dd>
                  {cell.bdi ? <bdi data-count={cell.countFrom}>{cell.displayValue}</bdi> : cell.displayValue}
                </dd>
              </div>
            ))}
          </dl>
        )}
        <PriceBar {...priceProps} />
        <AgentCard seller={listing.seller} waHref={waHref} sold={sold} as="div" />
      </div>
    </div>
    <HighlightChips highlights={listing.highlights} facts={listing.facts} />
  </section>
)}

{layout === 'monolith' && <MonolithStage listing={listing} cells={cells} perUnit={perUnit} />}
{layout === 'atelier' && <AtelierStage listing={listing} cells={cells} perUnit={perUnit} />}
{layout === 'glass' && <GlassStage listing={listing} cells={cells} perUnit={perUnit} />}
{layout === 'showroom' && <ShowroomStage listing={listing} cells={cells} perUnit={perUnit} />}
