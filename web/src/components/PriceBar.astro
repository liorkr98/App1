---
import { ils } from '../lib/format';
import { priceHeadline } from '@/features/listings/control-surface';
import { t } from '../lib/i18n';
import type { PerUnitPrice } from '../lib/price';

interface Props {
  price: number;
  /** Book price. Its presence selects the comparison form. */
  listPrice?: number;
  /** Free text used when there is no listPrice. */
  priceNote?: string;
  /** exact / from / on_request. Absent is exact. */
  priceDisplay?: 'exact' | 'from' | 'on_request';
  /** Derived, never declared. See lib/price.ts. */
  perUnit?: PerUnitPrice;
  /**
   * The asking price it came down from, while the drop is news
   * (features/listings/price-drop.ts, migration 0043). The seller's own
   * figure: a price history, never a valuation.
   */
  priceWas?: number;
}

const { price, listPrice, priceNote, priceDisplay, perUnit, priceWas } = Astro.props;

/**
 * DIVERGENCE #2 (DESIGN-CONTRACT §5.2) — and it is still driven by DATA,
 * never by listing.category.
 *
 * Price is optional. 0 means unanswered, not free — printing ₪0 would claim
 * the opposite of what the seller meant. on_request is the same honesty with
 * a label: לפי פנייה, no figure.
 */
const headline = priceHeadline(priceDisplay);
const priced = headline.showAmount && Number.isFinite(price) && price > 0;
const onRequest = priceDisplay === 'on_request';
const note = listPrice !== undefined ? `מחיר מחירון: ` : priceNote;
const showBar = priced || onRequest || Boolean(note) || Boolean(perUnit);
const dropped = priced && priceWas !== undefined && priceWas > price;
---
{showBar ? (
<div class:list={['price-bar', { 'has-drop': dropped }]}>
  {dropped && (
    <p class="price-drop">
      <span class="price-drop-tag">{t('listing.priceDropped')}</span>
      <span class="visually-hidden">{t('listing.priceWas')}</span>
      <s><bdi>{ils(priceWas)}</bdi></s>
    </p>
  )}
  {onRequest ? (
    <div class="price">{t('listing.priceOnRequest')}</div>
  ) : priced ? (
    <div class="price">
      {headline.prefix === 'from' ? <span class="price-from">{t('listing.priceFrom')}</span> : null}
      <bdi>{ils(price)}</bdi>
    </div>
  ) : null}

  {(note || perUnit) && (
    <div class="price-note label">
      {listPrice !== undefined ? (
        <Fragment>{note}<bdi>{ils(listPrice)}</bdi></Fragment>
      ) : (
        note
      )}

      {note && perUnit && <br />}

      {perUnit && (
        <Fragment><bdi>{perUnit.amount}</bdi> {perUnit.per}</Fragment>
      )}
    </div>
  )}
</div>
) : null}
