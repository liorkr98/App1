---
import { t } from '../lib/i18n';

interface Props {
  href?: string;
}

const { href = '/' } = Astro.props;
---
{/*
  Geometric mark, not a webfont letter.

  Favicons and SVG files cannot load Frank Ruhl Libre. A Hebrew glyph in an
  SVG therefore renders as a box or as mojibake — which is what the previous
  wordmark did. היעד means destination; concentric rings are that idea at
  16px, and the word itself is set next to them in the live page font.
*/}
<a class="brand-mark" href={href}>
  <svg viewBox="0 0 32 32" aria-hidden="true" width="28" height="28">
    <rect width="32" height="32" rx="8" fill="currentColor"></rect>
    <circle cx="16" cy="16" r="10" fill="none" stroke="var(--plaster)" stroke-width="1.8"></circle>
    <circle cx="16" cy="16" r="5.8" fill="none" stroke="var(--plaster)" stroke-width="1.8"></circle>
    <circle cx="16" cy="16" r="2.15" fill="var(--plaster)"></circle>
  </svg>
  <span>{t('common.brand')}</span>
</a>
