---
import { listingHighlights } from '@/features/listings/highlights';
import { t } from '../lib/i18n';

interface Props {
  highlights?: string[];
}

const chips = listingHighlights(Astro.props.highlights);
---
{chips.length > 0 ? (
  <ul class="highlights" aria-label={t('listing.highlights')}>
    {chips.map((chip) => (
      <li>{chip}</li>
    ))}
  </ul>
) : null}
