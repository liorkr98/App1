---
import type { Image, Listing } from '@/types/listing';
import { labeledWalkItems } from '@/features/listings/photo-rooms';
import { HERO_WIDTHS, largest, srcset } from '../../lib/images';
import type { FactCell } from '../../lib/facts';
import { t } from '../../lib/i18n';
import type { PerUnitPrice } from '../../lib/price';
import { coverStyle, priceProps, stagePlace, titleLines } from '../../lib/stage';
import HighlightChips from '../HighlightChips.astro';
import PriceBar from '../PriceBar.astro';
import Prose from '../Prose.astro';
import Numerals from './Numerals.astro';

interface Props {
  listing: Listing;
  /** Cover first, then the gallery: the contents line names their rooms. */
  photos: Image[];
  cells: FactCell[];
  perUnit?: PerUnitPrice | undefined;
}

/**
 * Chapters (Paper, homes; round three, 12 Oct 2026). A book of the flat: a
 * title page with the photograph, the price and the numbers, and, when the
 * seller named rooms, a contents line. Below, the gallery is set as the
 * chapters, one photograph to a page, numbered; the one movement on the
 * page is each chapter opening with a soft wipe from the reading side as it
 * reaches the screen, its caption sliding in beside it (chapters.css).
 * The title page itself is still.
 */
const { listing, photos, cells, perUnit } = Astro.props;
const cover = listing.media.cover;
const lines = titleLines(listing);
const place = stagePlace(listing);
const rooms = labeledWalkItems(photos)
  .map((image) => image.room)
  .filter((room, index, all): room is NonNullable<typeof room> => Boolean(room) && all.indexOf(room) === index);
---
<section class="stage stage-chapters">
  <div class="ch-title">
    {place && <p class="stage-place"><Prose text={place} /></p>}
    <h1 class="stage-title">
      {lines.map((line) => (
        <span class="ch-line"><Prose text={line} /></span>
      ))}
    </h1>
  </div>
  <button
    type="button"
    class="ch-photo"
    data-lightbox={largest(cover, HERO_WIDTHS)}
    data-alt={cover.alt ?? ''}
    aria-label={t('listing.openPhoto')}
  >
    <img
      src={largest(cover, HERO_WIDTHS)}
      srcset={srcset(cover, HERO_WIDTHS) || undefined}
      sizes="(min-width: 960px) 70vw, 100vw"
      width={cover.width}
      height={cover.height}
      alt={cover.alt ?? ''}
      style={coverStyle(listing)}
      fetchpriority="high"
      decoding="async"
    />
  </button>
  <div class="ch-facts">
    <PriceBar {...priceProps(listing, perUnit)} />
    <Numerals cells={cells} class="ch-nums" />
  </div>
  {rooms.length > 1 && (
    <p class="ch-contents">
      <b>{t('listing.chaptersContents')}</b>{' '}
      {rooms.map((room, index) => (
        <span>
          {index > 0 ? ' · ' : ''}
          {t(`editor.rooms.${room}`)}
        </span>
      ))}
    </p>
  )}
  <HighlightChips highlights={listing.highlights} facts={listing.facts} />
</section>
