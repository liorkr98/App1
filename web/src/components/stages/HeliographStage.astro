---
import type { Listing } from '@/types/listing';
import {
  ASPECT_BEARING,
  PLOT,
  bearingGap,
  dayArc,
  facadeSunMinutes,
  facadeWedge,
  plotPoint,
  seasonMoment,
  sunCoordinates,
  sunPosition,
  type Season,
} from '@/features/sun/sun';
import { HERO_WIDTHS, largest, srcset } from '../../lib/images';
import type { FactCell } from '../../lib/facts';
import { t } from '../../lib/i18n';
import type { PerUnitPrice } from '../../lib/price';
import { coverStyle, priceProps, stagePlace, titleLines } from '../../lib/stage';
import HighlightChips from '../HighlightChips.astro';
import PriceBar from '../PriceBar.astro';
import Prose from '../Prose.astro';
import Numerals from './Numerals.astro';

interface Props {
  listing: Listing;
  cells: FactCell[];
  perUnit?: PerUnitPrice | undefined;
}

/**
 * Heliograph (Paper, homes only). Scroll is one day: the sun crosses a sky
 * plot drawn over the balcony's direction, the page's light goes from dawn
 * to night, and the photographs warm with the hour (bindHeliograph).
 *
 * PRIVACY. The coordinates are never on the page (Listing.location says so).
 * The sun is computed here, on the server, from coordinates ROUNDED TO 0.1°
 * — about 11 km, which moves the sun by a fraction of a degree — and the
 * page receives only that table of positions. Nothing in it locates the flat.
 *
 * No aspect fact: the sun scene is omitted and the first screen is title,
 * photograph, price and numbers — never an empty plot. Missing coordinates
 * no longer omit it (sunCoordinates).
 */
const { listing, cells, perUnit } = Astro.props;
const cover = listing.media.cover;
const lines = titleLines(listing);
const place = stagePlace(listing);

const aspectFact = listing.facts.find((f) => f.key === 'aspect' && f.present && typeof f.value === 'string');
const aspect = typeof aspectFact?.value === 'string' ? aspectFact.value : undefined;
const facing = aspect !== undefined ? ASPECT_BEARING[aspect] : undefined;
// The listing's coordinates, else the street's midpoint, else the middle of
// Israel (sunCoordinates) — never "no sun" just because nothing geocoded.
const where = sunCoordinates(listing.location, listing.areaPlaces?.origin);
// Without an aspect the day still plays — the sun's path and the light —
// but nothing is said about the facade: no wedge, no hours on the balcony.
const sun: { facing: number | null; lat: number; lng: number } = {
  facing: facing ?? null,
  lat: where.lat,
  lng: where.lng,
};
const approx = where.approx || listing.location?.precision === 'area' || !listing.location?.street;

// The day the page scrolls through, as a table: [hour, bearing, altitude].
const FROM = 4.5;
const TO = 21;
const STEP = 0.25;
const table = (season: Season) => {
  if (!sun) return [];
  const rows: [number, number, number][] = [];
  for (let hour = FROM; hour <= TO + 1e-9; hour += STEP) {
    const p = sunPosition(seasonMoment(season, hour), sun.lat, sun.lng);
    rows.push([hour, Math.round(p.bearing * 10) / 10, Math.round(p.altitude * 10) / 10]);
  }
  return rows;
};
const tables = sun ? { summer: table('summer'), winter: table('winter') } : undefined;

// The resting frame: summer, a quarter to one — the sun near its highest.
const REST_HOUR = 12.75;
const rest = sun ? sunPosition(seasonMoment('summer', REST_HOUR), sun.lat, sun.lng) : undefined;
const [restX, restY] = rest ? plotPoint(rest) : [PLOT.cx, PLOT.cy];
// Facing within 60°, catching the facade at an angle within 90°, else behind.
const stateOf = (bearing: number, altitude: number) =>
  altitude < -6 ? 'night' : altitude < 0 ? 'twilight'
  : sun.facing === null ? 'up'
  : bearingGap(bearing, sun.facing) < 60 ? 'facing'
  : bearingGap(bearing, sun.facing) < 90 ? 'side' : 'behind';
const restState = rest ? stateOf(rest.bearing, rest.altitude) : 'behind';
const hhmm = (minutes: number) => `${Math.floor(minutes / 60)}:${String(minutes % 60).padStart(2, '0')}`;
const summerMinutes = sun.facing === null ? 0 : facadeSunMinutes('summer', sun.lat, sun.lng, sun.facing);
const winterMinutes = sun.facing === null ? 0 : facadeSunMinutes('winter', sun.lat, sun.lng, sun.facing);
const compassName = (bearing: number) =>
  Object.entries(ASPECT_BEARING).reduce((best, [name, deg]) =>
    bearingGap(bearing, deg) < bearingGap(bearing, ASPECT_BEARING[best]!) ? name : best, 'צפון');

const strings = {
  facing: t('listing.helio.facing'),
  behind: t('listing.helio.behind'),
  side: t('listing.helio.side'),
  twilight: t('listing.helio.twilight'),
  night: t('listing.helio.night'),
  up: t('listing.helio.up'),
  below: t('listing.helio.belowHorizon'),
  altitude: t('listing.helio.altitude'),
};
---
<section
  class="stage stage-helio"
  data-helio={sun ? JSON.stringify({ tables, facing: sun.facing, strings, names: ASPECT_BEARING }) : undefined}
>
  <div class="hl-head">
    {place && <p class="stage-place"><Prose text={place} /></p>}
    <h1 class="stage-title">
      {lines.map((line, i) => (
        <span class="ls-line"><span style={`--i:${i}`}><Prose text={line} /></span></span>
      ))}
    </h1>
    <PriceBar {...priceProps(listing, perUnit)} />
    {sun && <p class="hl-hint">{t('listing.helio.scrollHint')}</p>}
  </div>

  {sun && rest && (
    <div class="hl-sky">
      <svg class="hl-plot" viewBox="0 0 200 200" role="img" aria-label={t('listing.helio.plotLabel')}>
        <circle cx={PLOT.cx} cy={PLOT.cy} r={PLOT.r} class="hl-rim" />
        <circle cx={PLOT.cx} cy={PLOT.cy} r={(PLOT.r * 2) / 3} class="hl-ring" />
        <circle cx={PLOT.cx} cy={PLOT.cy} r={PLOT.r / 3} class="hl-ring" />
        {sun.facing !== null && <path d={facadeWedge(sun.facing)} class="hl-wedge" />}
        <path d={dayArc('summer', sun.lat, sun.lng)} class="hl-arc" data-arc="summer" />
        <path d={dayArc('winter', sun.lat, sun.lng)} class="hl-arc hl-arc-off" data-arc="winter" />
        <text x="100" y="9" class="hl-card" text-anchor="middle">{t('listing.helio.north')}</text>
        <text x="100" y="198" class="hl-card" text-anchor="middle">{t('listing.helio.south')}</text>
        <text x="197" y="104" class="hl-card" text-anchor="end">{t('listing.helio.east')}</text>
        <text x="3" y="104" class="hl-card">{t('listing.helio.west')}</text>
        {sun.facing !== null ? (
          <g transform={`rotate(${sun.facing} 100 100)`}>
            <rect x="92" y="92" width="16" height="16" rx="2" class="hl-home" />
            <line x1="100" y1="92" x2="100" y2="80" class="hl-balc" />
          </g>
        ) : (
          <rect x="92" y="92" width="16" height="16" rx="2" class="hl-home" />
        )}
        <circle cx={restX.toFixed(1)} cy={restY.toFixed(1)} r="8" class="hl-sun" data-sun />
      </svg>
      <div class="hl-read">
        <p class="hl-clock"><bdi data-clock>12:45</bdi></p>
        <div class="hl-seasons" role="group" aria-label={t('listing.helio.seasons')} aria-hidden="true">
          <button type="button" data-season="summer" aria-pressed="true"><bdi>21</bdi> {t('listing.helio.summer')}</button>
          <button type="button" data-season="winter" aria-pressed="false"><bdi>21</bdi> {t('listing.helio.winter')}</button>
        </div>
        <p class="hl-state" data-state>{strings[restState]}</p>
        <p class="hl-meta" data-meta>{strings.altitude} <bdi>{Math.round(rest.altitude)}°</bdi> · {compassName(rest.bearing)}</p>
      </div>
    </div>
  )}

  {sun.facing !== null && (
    <dl class="hl-hours">
      <div>
        <dt>{t('listing.helio.hoursOn')} · <bdi>21</bdi> {t('listing.helio.summer')}</dt>
        <dd><bdi>{hhmm(summerMinutes)}</bdi> {t('listing.helio.hours')}</dd>
      </div>
      <div>
        <dt>{t('listing.helio.hoursOn')} · <bdi>21</bdi> {t('listing.helio.winter')}</dt>
        <dd><bdi>{hhmm(winterMinutes)}</bdi> {t('listing.helio.hours')}</dd>
      </div>
    </dl>
  )}
  {sun && (
    <p class="hl-honest">
      {sun.facing === null ? t('listing.helio.honestNoAspect') : t('listing.helio.honest')}
      {approx ? ` ${t('listing.helio.approx')}` : ''}
    </p>
  )}

  <button
    type="button"
    class="hl-photo"
    data-lightbox={largest(cover, HERO_WIDTHS)}
    data-alt={cover.alt ?? ''}
    aria-label={t('listing.openPhoto')}
  >
    <img
      src={largest(cover, HERO_WIDTHS)}
      srcset={srcset(cover, HERO_WIDTHS) || undefined}
      sizes="(min-width: 960px) 60vw, 100vw"
      width={cover.width}
      height={cover.height}
      alt={cover.alt ?? ''}
      style={coverStyle(listing)}
      fetchpriority="high"
      decoding="async"
    />
  </button>
  <Numerals cells={cells} class="hl-nums" />
  <HighlightChips highlights={listing.highlights} facts={listing.facts} />
</section>
