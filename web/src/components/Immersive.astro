---
import type { Immersive } from '@/types/listing';
import { num } from '../lib/format';

interface Props {
  immersive: Immersive;
  posterUrl: string;
  /** Hebrew alt for the poster. */
  posterAlt: string;
}

const { immersive, posterUrl, posterAlt } = Astro.props;

/**
 * The immersive block.
 *
 * The poster, scrim, button and note are the reference markup, unchanged.
 * Stage C adds the mount target, the status line and the JSON payload
 * alongside them — nothing that existed was restyled.
 *
 * The viewer loads on tap and never on page view: a tour is several megabytes
 * and the reader is on cellular.
 */
const isTour = immersive.type === 'tour';

const label = isTour ? 'כניסה לסיור' : 'צפייה מכל הזוויות';

const note = isTour
  ? { count: num(immersive.scenes.length), unit: 'חדרים' }
  : { count: num(immersive.frameCount), unit: 'זוויות' };

const prefix = isTour ? null : 'חוץ ופנים';
const megabytes = immersive.payloadMb;
---
<figure class="immersive" data-viewer>
  <img src={posterUrl} alt={posterAlt} loading="lazy" decoding="async" width="900" height="563">

  <div class="immersive-scrim" data-viewer-scrim>
    <button class="immersive-enter" type="button" data-viewer-open>{label}</button>
    <span class="immersive-note">
      {prefix ? (
        <Fragment>{prefix} · <bdi>{note.count}</bdi> {note.unit}</Fragment>
      ) : (
        <Fragment><bdi>{note.count}</bdi> {note.unit}</Fragment>
      )}
      {megabytes !== undefined && <Fragment> · <bdi>{num(megabytes)}</bdi> מ״ב</Fragment>}
    </span>
  </div>

  {/* Real progress, not a spinner — the user has just agreed to spend data. */}
  <div class="viewer-status" data-viewer-status hidden role="status" aria-live="polite">
    <span></span>
    <button class="immersive-enter" type="button" data-viewer-retry hidden>נסה שוב</button>
  </div>

  <div class="viewer-stage" data-viewer-stage hidden></div>

  {/* Payload for the client. A JSON script block rather than a data attribute:
      scene lists contain Hebrew labels and URLs, and attribute escaping is a
      needless place for those to break. */}
  <script type="application/json" is:inline set:html={JSON.stringify(immersive)} />
</figure>

<style is:global>
/* Additive only — nothing above this comment changes the ported rules. */
.viewer-stage{
  position:absolute;inset:0;background:var(--ink);
}
.viewer-stage .psv-container{width:100%;height:100%}

.spin-stage{
  width:100%;height:100%;
  background-repeat:no-repeat;
  touch-action:pan-y;      /* let the page scroll vertically, we take x */
  cursor:grab;
}
.spin-stage:focus-visible{outline:3px solid var(--plaster);outline-offset:-3px}

.viewer-status{
  position:absolute;inset:0;
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.7rem;
  background:rgba(25,26,21,.34);color:var(--plaster);
  font-size:.9rem;
}
</style>

<script>
  import { initViewers } from '../lib/viewers/mount';
  initViewers();
</script>
