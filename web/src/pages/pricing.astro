---
import { PRICING, type Plan } from '@/features/billing/pricing-config';
import { planByKey } from '@/features/billing/price';
import Msg from '../components/Msg.astro';
import PlanCard from '../components/PlanCard.astro';
import { t } from '../lib/i18n';
import { amount, cohortCap, noteValues, offerLd, termsPath } from '../lib/plan-copy';
import Site from '../layouts/Site.astro';
import '../styles/pricing.css';

/**
 * The price list (docs/PRICING.md, 12 Oct 2026). Every number comes from
 * src/features/billing/pricing-config.ts — the page holds no price literal,
 * and scripts/verify-no-price-literals.mjs fails the build if one appears.
 *
 * DISPLAY ONLY — CLAUDE.md §8. Nothing here reads or decides entitlement;
 * until an Israeli PSP is signed, a paid plan's button leads to /contact/.
 *
 * NO LAYOUT SHIFT WHEN IT SWITCHES: both variants share one grid cell and
 * trade visibility, and the seat line keeps its height while empty (the
 * speed test measured 0.26 when they did not).
 *
 * THE LAUNCH PRICE IS SHOWN ONLY WHILE A SEAT DEMONSTRABLY REMAINS
 * (PRICING §6, "never fake scarcity"). The page is static, so it renders the
 * regular price, and the script below reads the real `cohort_counters` and
 * switches a card to the launch price, with the true count, only when a seat
 * is left. A full cohort, or a count that could not be read, keeps the
 * regular price. No deploy is needed when a cohort fills.
 */

const origin = Astro.site ?? new URL(Astro.url.origin);
const url = new URL('/pricing/', origin).href;

const free = planByKey('free');
const agentBasic = planByKey('agent_basic');
const agent = planByKey('agent');
const agentUnlimited = planByKey('agent_unlimited');
const agentLaunch = planByKey('agent_launch');
const office = planByKey('office');
const dealer = planByKey('dealer');
const dealerLaunch = planByKey('dealer_launch');
const privates = [planByKey('private_sale'), planByKey('private_rent'), planByKey('private_car')];

/**
 * The agent plans first, by active pages (18 Oct 2026): 5, 10, unlimited,
 * with 10 in the middle and recommended. Three real plans; none is there to
 * make another look good (docs/AGENT-TOOLS.md). In RTL the first is the
 * rightmost, so the row reads 5 → 10 → unlimited.
 */
const agentCards: { regular: Plan; launch: Plan | null; featured: boolean }[] = [
  { regular: agentBasic, launch: null, featured: false },
  { regular: agent, launch: agentLaunch, featured: true },
  { regular: agentUnlimited, launch: null, featured: false },
];

/** A subscription card: regular by default, the launch variant hidden until a seat is proven. */
const otherCards: { regular: Plan; launch: Plan | null; featured: boolean }[] = [
  { regular: office, launch: null, featured: false },
  { regular: dealer, launch: dealerLaunch, featured: false },
];

const ld = [
  {
    '@type': 'Product',
    name: t('common.brand'),
    description: t('pricing.lead'),
    url,
    brand: { '@id': new URL('/#organization', origin).href },
    offers: PRICING.plans.map((plan) => offerLd(plan, url, t(`billing.plans.${plan.key}`))),
  },
];
---

<Site title={`${t('pricing.title')} · ${t('common.brand')}`} description={t('pricing.lead')} ld={ld}>
  {/*
    The headline and the line under it carry numbers, and digits live in the
    faces' Latin files, not their Hebrew ones. Without these the text set in
    the fallback first, wrapped differently, then jumped (a 0.25 layout shift).
  */}
  <link slot="head" rel="preload" href="/fonts/noto-sans-hebrew-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link slot="head" rel="preload" href="/fonts/heebo-latin.woff2" as="font" type="font/woff2" crossorigin />
  <section class="pr-hero">
    <div class="site-shell pr-head">
      <h1 class="site-h2 pr-title">
        <Msg path="pricing.headline" values={{ price: amount(agentBasic) }} />
      </h1>
      <p class="site-sub">
        <Msg path="pricing.sub" values={{ free: PRICING.freePageLimit, seats: cohortCap('agent_launch'), months: PRICING.lockMonths }} />
      </p>
      <p class="pr-seats is-off" data-seats="agent_launch"></p>
    </div>

    <ul class="site-shell pr-tiers">
      {agentCards.map((card, i) => (
        <PlanCard {...card} index={i} />
      ))}
      <li class="pr-tier ls-fade" style="--i:3">
        <p class="pr-name">{t(`billing.plans.${free.key}`)}</p>
        <p class="pr-sum is-free">{t('billing.terms.free')}</p>
        <p class="pr-note"><Msg path={`billing.notes.${free.key}`} values={noteValues(free)} /></p>
        <a class="site-btn site-btn-primary pr-go" href="/new/?fresh=1">{t('pricing.start')}</a>
      </li>
      {otherCards.map((card, i) => (
        <PlanCard {...card} index={i + 4} />
      ))}
    </ul>

    <div class="site-shell pr-private">
      <h2 class="site-h3">{t('pricing.privateTitle')}</h2>
      <p class="site-sub"><Msg path="pricing.privateLine" values={{ price: amount(privates[0]!) }} /></p>
      <ul class="pr-private-list">
        {privates.map((plan) => (
          <li>
            <b>{t(`billing.plans.${plan.key}`)}</b>
            <span class="pr-sum"><Msg path={termsPath(plan)} values={{ price: amount(plan) }} /></span>
            <span class="pr-note"><Msg path={`billing.notes.${plan.key}`} values={noteValues(plan)} /></span>
          </li>
        ))}
      </ul>
    </div>

    <p class="site-shell site-note pr-off"><Msg path="pricing.vatNote" values={{ vat: PRICING.vatPercent }} /></p>
    <p class="site-shell site-note pr-off">
      {t('pricing.checkoutOff')} <a href="/contact/">{t('pricing.contact')}</a>
    </p>
  </section>

  <section class="site-sect">
    <div class="site-shell pr-faq">
      <h2 class="site-h2">{t('pricing.faqTitle')}</h2>
      <details>
        <summary>{t('pricing.faqMark')}</summary>
        <p>{t('pricing.faqMarkA')}</p>
      </details>
      <details>
        <summary>{t('pricing.faqTrial')}</summary>
        <p>{t('pricing.faqTrialA')}</p>
      </details>
      <details>
        <summary>{t('pricing.faqCancel')}</summary>
        <p><Msg path="pricing.faqCancelA" values={{ free: PRICING.freePageLimit }} /></p>
      </details>
      <details>
        <summary>{t('pricing.faqExpire')}</summary>
        <p><Msg path="pricing.faqExpireA" values={{ sale: planByKey('private_sale').pageTtlDays ?? 0, rent: planByKey('private_rent').pageTtlDays ?? 0 }} /></p>
      </details>
      <details>
        <summary>{t('pricing.faqListing')}</summary>
        <p>{t('pricing.faqListingA')} <bdi>25</bdi> {t('pricing.faqListingB')}</p>
      </details>
      <details>
        <summary>{t('pricing.faqLicence')}</summary>
        <p>{t('pricing.faqLicenceA')}</p>
      </details>
      <details>
        <summary>{t('pricing.faqAi')}</summary>
        <p>{t('pricing.faqAiA')}</p>
      </details>
      <details>
        <summary>{t('pricing.faqPay')}</summary>
        <p>{t('pricing.faqPayA')}</p>
      </details>
    </div>
  </section>
</Site>

<script>
  import { recordBillingEventPlain } from '../lib/billing-event-plain';
  import { showLaunchOffers } from '../lib/launch-offer';
  import { showLaunchText } from '../lib/launch-text';

  void recordBillingEventPlain('paywall_shown', null);
  void showLaunchOffers().then((counts) => showLaunchText(counts));
</script>
