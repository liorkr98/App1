---
import { ils } from '../lib/format';
import { t } from '../lib/i18n';
import { ADDONS, PRICE_TIERS } from '../lib/tiers';
import Site from '../layouts/Site.astro';
import '../styles/pricing.css';

/**
 * The price list (P5, Onyx). Glass cards over a slow aurora.
 *
 * DISPLAY ONLY — CLAUDE.md §8. The numbers come from lib/tiers.ts, the same
 * list the homepage strip reads. Checkout is a disabled control until an
 * Israeli PSP is signed (ADR 0003): "עדיין לא פתוח", not a fake pay button.
 * Nothing on this page reads or decides entitlement.
 *
 * Add-ons are listed with בקרוב and no price: their vendors and prices are
 * still the owner's decision, and a number published here is a promise.
 * The FAQ states the product rules as they are — no subscription trial, the
 * mark comes off every page with one purchase, AI images are always
 * labelled with the original beside them.
 */
---

<Site title={`${t('pricing.title')} · ${t('common.brand')}`} description={t('pricing.lead')}>
  <section class="pr-hero">
    <div class="pr-aurora" aria-hidden="true"></div>
    <div class="site-shell pr-head">
      <p class="site-eyebrow">{t('pricing.eyebrow')}</p>
      <h1 class="site-h2 pr-title">{t('pricing.headline')}</h1>
      <p class="site-sub">{t('pricing.freeLine')}</p>
    </div>

    <ul class="site-shell pr-tiers">
      {PRICE_TIERS.map((tier, i) => (
        <li class:list={['pr-tier ls-fade', tier.featured && 'is-featured']} style={`--i:${i}`}>
          {tier.featured && <p class="pr-flag">{t('pricing.agentFlag')}</p>}
          {!tier.featured && <p class="pr-name">{t(`pricing.${tier.id}`)}</p>}
          <p class="pr-sum">{tier.price === 0 ? t('pricing.freePrice') : <bdi>{ils(tier.price)}</bdi>}</p>
          <p class="pr-note">{t(`pricing.${tier.id}Note`)}</p>
          {tier.price === 0 ? (
            <a class="site-btn site-btn-primary pr-go" href="/new/?fresh=1">{t('pricing.start')}</a>
          ) : (
            <button type="button" class="site-btn pr-go" disabled>{t('pricing.disabled')}</button>
          )}
        </li>
      ))}
    </ul>
    <p class="site-shell site-note pr-off">{t('pricing.checkoutOff')}</p>
  </section>

  <section class="site-sect ls-sect">
    <div class="site-shell">
      <p class="site-eyebrow">{t('pricing.addonsLabel')}</p>
      <h2 class="site-h2">{t('pricing.addonsTitle')}</h2>
      <p class="site-sub">{t('pricing.addonsBody')}</p>
      <ul class="pr-addons">
        {ADDONS.map((id) => (
          <li>
            <span class="site-tag is-soon">{t('pricing.soon')}</span>
            <b>{t(`pricing.addon_${id}`)}</b>
            <span>{t(`pricing.addon_${id}Note`)}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="site-sect" data-ls="paper">
    <div class="site-shell pr-faq">
      <h2 class="site-h2">{t('pricing.faqTitle')}</h2>
      <details>
        <summary>{t('pricing.faqMark')}</summary>
        <p>{t('pricing.faqMarkA')}</p>
      </details>
      <details>
        <summary>{t('pricing.faqTrial')}</summary>
        <p>{t('pricing.faqTrialA')}</p>
      </details>
      <details>
        <summary>{t('pricing.faqListing')}</summary>
        <p>{t('pricing.faqListingA')} <bdi>25</bdi> {t('pricing.faqListingB')}</p>
      </details>
      <details>
        <summary>{t('pricing.faqAi')}</summary>
        <p>{t('pricing.faqAiA')}</p>
      </details>
      <details>
        <summary>{t('pricing.faqPay')}</summary>
        <p>{t('pricing.faqPayA')}</p>
      </details>
    </div>
  </section>
</Site>
