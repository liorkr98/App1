---
import { t } from '../lib/i18n';
import Site from '../layouts/Site.astro';
import '../styles/dash.css';

/**
 * The agent's dashboard.
 *
 * THIS IS THE PRODUCT SURFACE NOW, not a list. The pivot of 11 September 2026
 * made the product a fast way for an agent to produce a professional,
 * shareable page — so the place they live is here: every property and vehicle
 * they own, each one a tap from the link they are about to paste into
 * WhatsApp. See docs/PRODUCT.md.
 *
 * It replaces a flat <ul> of rows whose only action was "share". An agent with
 * nine listings could not tell at a glance which were published, could not
 * copy a link without opening a second page, and could not mark a sold
 * property as sold at all — there was no UI for `status` anywhere in the
 * product, though the column has supported 'sold' since 0002.
 *
 * RENDERED IN THE BROWSER, not at build time. These rows belong to whoever is
 * signed in and a statically built page cannot know that. Row Level Security
 * decides what comes back: the query says `select` with no owner filter, and
 * the database returns only this agent's rows because the policy in 0002 says
 * so. The filter is not in this file, deliberately — a filter in the client
 * is a suggestion, and one that looks like security is worse than none.
 *
 * THE NUMBERS ARE COUNTS, NOT ESTIMATES (September 2026 redesign). Views
 * and WhatsApp taps come from listing_events — recorded by the SSR route and
 * the /wa redirect, no IP, no user agent — rolled up per Israel day by
 * listing_event_daily (0029). The arithmetic lives in
 * src/features/analytics/dashboard-stats.ts, where it is tested. If the daily
 * view is unavailable the tiles fall back to all-time totals and SAY so;
 * the charts are omitted rather than drawn from nothing.
 *
 * EVERY STATE IS IN THE MARKUP and hidden by script, never created by it.
 * /me shipped the other way round and rendered a blank page the first time a
 * stale dependency made the module fail. A dashboard that can go blank is a
 * dashboard an agent cannot trust in front of a client.
 *
 * V2 (P5, September 2026): Living Surfaces Onyx through layouts/Site.astro
 * (styles/dash.css), a read-through tile (scroll_75, migration 0030), the
 * panel as a sheet on phones — it was display:none below 1100px — and Share
 * Studio in the panel. Queries, RLS assumptions and actions are unchanged.
 */
---

<Site title={`${t('dash.title')} · ${t('common.brand')}`} robots="noindex,nofollow" account={false}>
  <Fragment slot="nav">
    <a class="site-link" href="/me/">{t('agent.editDetails')}</a>
    <a class="site-link" id="nav-admin" href="/admin/" hidden>{t('admin.link')}</a>
    <a class="site-btn site-btn-primary dash-new" href="/new/?fresh=1">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
      {t('dash.new')}
    </a>
  </Fragment>

  <div class="dash shell">
    <div class="head">
      <div>
        <p class="hello" id="hello" hidden></p>
        <h1>{t('dash.title')}</h1>
        <p class="lead" id="lead">{t('dash.lead')}</p>
      </div>
    </div>

    {/*
      FIRST-RUN ONBOARDING. Shown only while the profile is genuinely
      untouched (isProfileEmpty), not while it is merely incomplete: nagging
      somebody who has already been to the page is how a banner gets
      ignored.
    */}
    <div class="onboard" id="onboard" hidden>
      <div>
        <b>{t('dash.onboardTitle')}</b>
        <p>{t('dash.onboardBody')}</p>
      </div>
      <a class="cta dark" href="/me/?welcome">{t('dash.onboardCta')}</a>
    </div>

    {/*
      The four tiles. In the markup from the start and filled by script;
      hidden until there is at least one listing, because a zero on every
      tile is not information.
    */}
    <section class="kpis" id="kpis" aria-label={t('dash.title')} hidden>
      <div class="kpi" style="--i:0">
        <span class="kpi-lbl">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3" fill="currentColor"/></svg>
          {t('dash.kpiViews')} · <span data-window></span>
        </span>
        <span class="kpi-num"><bdi id="k-views">0</bdi></span>
        <span class="kpi-note plain">{t('dash.kpiViewsNote')}</span>
        <svg class="spark" id="s-views" viewBox="0 0 200 44" aria-hidden="true" data-empty></svg>
      </div>
      <div class="kpi" style="--i:1">
        <span class="kpi-lbl">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7A2.5 2.5 0 0 1 17.5 16H9l-4 3.2A.8.8 0 0 1 4 18.6V6.5Z"/></svg>
          {t('dash.kpiTaps')} · <span data-window></span>
        </span>
        <span class="kpi-num"><bdi id="k-taps">0</bdi></span>
        <span class="kpi-note">{t('dash.kpiTapsNote')}</span>
        <svg class="spark" id="s-taps" viewBox="0 0 200 44" aria-hidden="true" data-empty></svg>
      </div>
      <div class="kpi" style="--i:2">
        <span class="kpi-lbl">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M7.5 9a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM16.5 18a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          {t('dash.kpiRate')}
        </span>
        <span class="kpi-num"><bdi id="k-rate">—</bdi></span>
        <span class="kpi-note plain" id="k-rate-note">{t('dash.kpiRateNote')}</span>
      </div>
      <div class="kpi" style="--i:3">
        <span class="kpi-lbl">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
          {t('dash.kpiLive')}
        </span>
        <span class="kpi-num"><bdi id="k-live">0</bdi><small id="k-of"></small></span>
        <span class="kpi-note plain" id="k-live-note"></span>
        <div class="meter" aria-hidden="true"><span id="k-meter"></span></div>
      </div>
      <div class="kpi is-wide" id="k-read-tile" style="--i:4" hidden>
        <span class="kpi-lbl">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v13M6 11l6 6 6-6M5 20h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {t('dash.kpiRead')} · <span data-window></span>
        </span>
        <span class="kpi-num"><bdi id="k-read">—</bdi></span>
        <span class="kpi-note plain">{t('dash.kpiReadNote')}</span>
      </div>
    </section>

    {/*
      Present from the start, hidden by script. The filter is a radio group
      so the browser owns the "one of five" behaviour; the script only reads
      which one is checked.
    */}
    <div class="filters" id="filters" hidden>
      <input type="radio" name="filter" id="f-all" value="all" checked />
      <label for="f-all">{t('dash.filterAll')}</label>
      <input type="radio" name="filter" id="f-published" value="published" />
      <label for="f-published">{t('dash.filterPublished')}</label>
      <input type="radio" name="filter" id="f-draft" value="draft" />
      <label for="f-draft">{t('dash.filterDraft')}</label>
      <input type="radio" name="filter" id="f-sold" value="sold" />
      <label for="f-sold">{t('dash.filterSold')}</label>
      <input type="radio" name="filter" id="f-archived" value="archived" />
      <label for="f-archived">{t('dash.filterArchived')}</label>
      <span class="count" id="count"></span>
    </div>

    <p class="state" id="loading">{t('common.loading')}</p>
    <div class="state" id="anon" hidden>
      <b>{t('dash.signedOut')}</b>
      <a href="/enter/">{t('dash.signIn')}</a>
    </div>
    <div class="state" id="empty" hidden>
      <b>{t('dash.emptyTitle')}</b>
      {t('dash.emptyBody')} <a href="/new/?fresh=1">{t('dash.new')}</a>
    </div>
    <p class="state" id="none" hidden>{t('dash.emptyFiltered')}</p>
    <p class="state" id="failed" hidden>{t('dash.failed')}</p>

    <div class="workspace" id="workspace" hidden>
      <ul class="grid" id="grid"></ul>
      <aside class="detail" id="detail" aria-live="polite" hidden></aside>
    </div>
  </div>

  <p class="say dash" id="say" role="status" aria-live="polite" hidden></p>

  <script>
      import { isProfileEmpty } from '@/features/agents/profile';
      import {
        contactRate,
        daysSincePublished,
        lastDays,
        readRate,
        readThrough,
        series,
        totals,
        type DailyRow,
        type DayPoint,
        type ReadRow,
      } from '@/features/analytics/dashboard-stats';
      import { formatValue, parts, t, type Values } from '../lib/i18n';
      import { loadProfile } from '../lib/profile';
      import { supabase, supabaseConfigured } from '../lib/supabase';
      import { revealIfSiteAdmin } from '../lib/site-admin';

      type Row = {
        id?: string;
        slug: string;
        title: string | null;
        price: number | null;
        status: string;
        category: string;
        template?: string | null;
        published_at: string | null;
        media: {
          cover?: { url?: string; alt?: string };
          gallery?: { url?: string; alt?: string }[];
          /** P7, written by the worker once rendered. */
          storyUrl?: string;
          flyerUrl?: string;
        } | null;
        location: { city?: string; street?: string } | null;
        views?: number;
        waTaps?: number;
      };

      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const grid = $<HTMLUListElement>('grid');
      const detail = $('detail');
      const filters = $('filters');
      const count = $('count');
      const say = $('say');
      const sparkViews = document.getElementById('s-views') as unknown as SVGSVGElement;
      const sparkTaps = document.getElementById('s-taps') as unknown as SVGSVGElement;

      const PANELS = ['loading', 'anon', 'empty', 'none', 'failed', 'workspace'];
      const show = (id: string) => {
        for (const name of PANELS) {
          const node = document.getElementById(name);
          if (node) node.hidden = name !== id;
        }
      };

      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const WINDOW = 30;
      const today = new Date();
      const windowDays = lastDays(today, WINDOW);

      const money = new Intl.NumberFormat('he-IL', {
        style: 'currency',
        currency: 'ILS',
        maximumFractionDigits: 0,
      });
      const num = (value: number) => formatValue(value);

      // Four weeks. The broker duty to update or remove an unavailable
      // listing (OPPORTUNITIES.md §1b); the copy asks rather than asserts.
      const STALE_AFTER_MS = 28 * 24 * 60 * 60 * 1000;
      const isStalePublished = (row: Row, now: number): boolean => {
        if (row.status !== 'published' || !row.published_at) return false;
        const published = Date.parse(row.published_at);
        if (!Number.isFinite(published)) return false;
        return now - published >= STALE_AFTER_MS;
      };

      let sayTimer = 0;
      const tell = (text: string, tone: 'good' | 'bad' = 'good') => {
        say.textContent = text;
        say.dataset.tone = tone;
        say.hidden = false;
        window.clearTimeout(sayTimer);
        sayTimer = window.setTimeout(() => {
          say.hidden = true;
        }, 3200);
      };

      /** Every row we loaded, so filtering never needs a second request. */
      let rows: Row[] = [];
      /** Per-day rows, or undefined when the daily view could not be read. */
      let daily: DailyRow[] | undefined;
      /** Read-through rows (0030), or undefined where that column is missing. */
      let reads: ReadRow[] | undefined;
      let chosen: string | undefined;

      const statusLabel = (status: string) =>
        t(`dash.status${status.charAt(0).toUpperCase()}${status.slice(1)}`);

      const publicUrl = (slug: string) => `${window.location.origin}/a/${slug}/`;

      /**
       * A message with its numbers isolated.
       *
       * Hebrew around a number reorders it without <bdi> (CLAUDE.md §4.2), so
       * interpolated values become their own elements rather than being
       * concatenated into the sentence.
       */
      const sentence = (path: string, values: Values): Node[] =>
        parts(path).map((part) => {
          if ('text' in part) return document.createTextNode(part.text);
          const bdi = document.createElement('bdi');
          const value = values[part.slot];
          bdi.textContent = value === undefined ? '' : formatValue(value);
          return bdi;
        });

      const svgNS = 'http://www.w3.org/2000/svg';
      const icon = (d: string, fill = false) => {
        const svg = document.createElementNS(svgNS, 'svg');
        svg.setAttribute('viewBox', '0 0 24 24');
        svg.setAttribute('aria-hidden', 'true');
        const path = document.createElementNS(svgNS, 'path');
        path.setAttribute('d', d);
        if (fill) path.setAttribute('fill', 'currentColor');
        else {
          path.setAttribute('fill', 'none');
          path.setAttribute('stroke', 'currentColor');
          path.setAttribute('stroke-width', '2');
          path.setAttribute('stroke-linecap', 'round');
        }
        svg.append(path);
        return svg;
      };
      const EYE = 'M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Zm10 3a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z';
      const CHAT = 'M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7A2.5 2.5 0 0 1 17.5 16H9l-4 3.2A.8.8 0 0 1 4 18.6V6.5Z';
      const CLOCK = 'M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z';

      /** Counts a <bdi> up to the value already written into it. */
      const countUp = (el: HTMLElement, to: number, text: string) => {
        el.textContent = text;
        if (reduced || !(to > 0)) return;
        const start = performance.now();
        const tick = (now: number) => {
          const k = Math.min(1, (now - start) / 1100);
          const eased = 1 - (1 - k) ** 3;
          el.textContent = k < 1 ? num(Math.round(to * eased)) : text;
          if (k < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };

      const copy = async (text: string) => {
        try {
          await navigator.clipboard.writeText(text);
          tell(t('dash.copied'));
        } catch {
          tell(t('dash.copyFailed'), 'bad');
        }
      };

      const markSold = async (slug: string, button: HTMLButtonElement) => {
        if (!window.confirm(t('dash.confirmSold'))) return;
        button.disabled = true;
        // No owner filter, for the same reason the select has none: the
        // update policy in 0002 is what restricts this to the agent's own row.
        const { error } = await supabase().from('listings').update({ status: 'sold' }).eq('slug', slug);
        button.disabled = false;
        if (error) return tell(t('dash.soldFailed'), 'bad');
        const row = rows.find((candidate) => candidate.slug === slug);
        if (row) row.status = 'sold';
        tell(t('dash.soldDone'));
        paint();
      };

      const deleteListing = async (slug: string, button: HTMLButtonElement) => {
        if (!window.confirm(t('dash.confirmDelete'))) return;
        button.disabled = true;
        const { error } = await supabase().from('listings').delete().eq('slug', slug);
        button.disabled = false;
        if (error) return tell(t('dash.deletedFailed'), 'bad');
        rows = rows.filter((candidate) => candidate.slug !== slug);
        if (chosen === slug) chosen = undefined;
        tell(t('dash.deletedDone'));
        paint();
      };

      const archiveListing = async (slug: string, button: HTMLButtonElement) => {
        if (!window.confirm(t('dash.confirmArchive'))) return;
        button.disabled = true;
        const { error } = await supabase()
          .from('listings')
          .update({ status: 'archived' })
          .eq('slug', slug);
        button.disabled = false;
        if (error) return tell(t('dash.archivedFailed'), 'bad');
        const row = rows.find((candidate) => candidate.slug === slug);
        if (row) row.status = 'archived';
        tell(t('dash.archivedDone'));
        paint();
      };

      const button = (label: string, className: string, onClick: (self: HTMLButtonElement) => void) => {
        const node = document.createElement('button');
        node.type = 'button';
        node.className = className;
        node.textContent = label;
        node.addEventListener('click', () => onClick(node));
        return node;
      };

      const link = (label: string, className: string, href: string) => {
        const node = document.createElement('a');
        node.className = className;
        node.href = href;
        node.textContent = label;
        return node;
      };

      const flatTitle = (row: Row) =>
        String(row.title ?? '').replace(/\s*\n\s*/g, ' ').trim() || '—';

      const priceNode = (row: Row) => {
        const price = document.createElement('div');
        price.className = 'price';
        const bdi = document.createElement('bdi');
        bdi.textContent = money.format(Number(row.price ?? 0));
        price.append(bdi);
        return price;
      };

      const daysLive = (row: Row) =>
        row.published_at
          ? Math.max(0, Math.floor((Date.now() - Date.parse(row.published_at)) / 86400000))
          : undefined;

      // ------------------------------------------------------------------
      // Tiles
      // ------------------------------------------------------------------

      /** A 2px line with a 10% wash under it and an end dot. One series. */
      const drawSpark = (svg: SVGSVGElement, values: number[]) => {
        svg.replaceChildren();
        const max = Math.max(...values, 1);
        const W = 200;
        const H = 44;
        const step = values.length > 1 ? W / (values.length - 1) : W;
        // Oldest on the start side, i.e. the right in RTL.
        const x = (index: number) => W - index * step;
        const y = (value: number) => H - 4 - (value / max) * (H - 10);
        const points = values.map((value, index) => `${x(index).toFixed(1)},${y(value).toFixed(1)}`);
        const area = document.createElementNS(svgNS, 'path');
        area.setAttribute('d', `M${points.join('L')}L${x(values.length - 1)},${H}L${x(0)},${H}Z`);
        area.setAttribute('fill', 'var(--olive)');
        area.setAttribute('fill-opacity', '0.1');
        const line = document.createElementNS(svgNS, 'path');
        line.setAttribute('class', 'line');
        line.setAttribute('d', `M${points.join('L')}`);
        line.setAttribute('fill', 'none');
        line.setAttribute('stroke', 'var(--olive)');
        line.setAttribute('stroke-width', '2');
        line.setAttribute('stroke-linejoin', 'round');
        line.setAttribute('stroke-linecap', 'round');
        const last = values.length - 1;
        const dot = document.createElementNS(svgNS, 'circle');
        dot.setAttribute('cx', String(x(last)));
        dot.setAttribute('cy', String(y(values[last] ?? 0)));
        dot.setAttribute('r', '4');
        dot.setAttribute('fill', 'var(--olive)');
        dot.setAttribute('stroke', '#fff');
        dot.setAttribute('stroke-width', '2');
        svg.append(area, line, dot);
        svg.removeAttribute('data-empty');
      };

      const paintTiles = () => {
        const live = rows.filter((row) => row.status === 'published');
        const kept = rows.filter((row) => row.status !== 'archived');
        const liveIds = new Set(rows.filter((row) => row.status !== 'draft').map((row) => row.id));

        let views: number;
        let taps: number;
        const windowLabel = daily ? t('dash.kpiWindow30') : t('dash.kpiWindowAll');
        for (const node of document.querySelectorAll<HTMLElement>('[data-window]')) {
          node.textContent = windowLabel;
        }

        if (daily) {
          const own = daily.filter((row) => liveIds.has(row.listing_id));
          const points = series(own, windowDays);
          ({ views, taps } = totals(points));
          drawSpark(sparkViews, points.map((p) => p.views));
          drawSpark(sparkTaps, points.map((p) => p.taps));
        } else {
          views = rows.reduce((sum, row) => sum + (row.views ?? 0), 0);
          taps = rows.reduce((sum, row) => sum + (row.waTaps ?? 0), 0);
        }

        countUp($('k-views'), views, num(views));
        countUp($('k-taps'), taps, num(taps));

        const rate = contactRate(views, taps);
        $('k-rate').textContent = rate === undefined ? '—' : `${rate.toFixed(1)}%`;
        $('k-rate-note').textContent = rate === undefined ? t('dash.kpiRateNone') : t('dash.kpiRateNote');

        countUp($('k-live'), live.length, num(live.length));
        $('k-of').replaceChildren(...sentence('dash.kpiOf', { total: kept.length }));
        $('k-live-note').replaceChildren(
          ...sentence('dash.kpiLiveNote', {
            drafts: rows.filter((row) => row.status === 'draft').length,
            sold: rows.filter((row) => row.status === 'sold').length,
          }),
        );
        const share = kept.length > 0 ? Math.round((live.length / kept.length) * 100) : 0;
        $('k-meter').style.setProperty('--share', `${share}%`);

        const readTile = $('k-read-tile');
        if (reads) {
          const own = reads.filter((row) => liveIds.has(row.listing_id));
          const through = readThrough(own, windowDays);
          const rate = readRate(through.views, through.reads);
          $('k-read').textContent = rate === undefined ? '—' : `${rate}%`;
          readTile.hidden = false;
          $('kpis').classList.add('has-read');
        } else {
          readTile.hidden = true;
          $('kpis').classList.remove('has-read');
        }

        $('lead').replaceChildren(
          ...sentence(daily ? 'dash.leadLive' : 'dash.leadLiveAll', { live: live.length, taps }),
        );
        $('kpis').hidden = false;
      };

      // ------------------------------------------------------------------
      // Cards
      // ------------------------------------------------------------------

      const card = (row: Row, index: number) => {
        const item = document.createElement('li');
        item.className = 'card';
        item.dataset.status = row.status;
        item.dataset.slug = row.slug;
        item.style.setProperty('--i', String(Math.min(index, 8)));
        if (row.slug === chosen) item.classList.add('is-chosen');
        const href = publicUrl(row.slug);
        const sendable = row.status === 'published';

        // --- Cover -------------------------------------------------------
        const shot = document.createElement(sendable ? 'a' : 'div');
        shot.className = 'shot';
        if (sendable) (shot as HTMLAnchorElement).href = href;
        const cover = row.media?.cover?.url;
        if (cover) {
          const image = document.createElement('img');
          image.src = cover;
          // The alt the agent wrote, never the title: a decorative duplicate
          // of text already beside it is noise to a screen reader.
          image.alt = row.media?.cover?.alt ?? '';
          image.loading = 'lazy';
          image.decoding = 'async';
          image.style.viewTransitionName = `cover-${row.slug}`;
          shot.append(image);
        } else {
          const none = document.createElement('div');
          none.className = 'none';
          none.textContent = t('dash.noPhoto');
          shot.append(none);
        }
        const pill = document.createElement('span');
        pill.className = 'pill';
        pill.textContent = statusLabel(row.status);
        shot.append(pill);
        if (row.template) {
          const tpl = document.createElement('span');
          tpl.className = 'tpl';
          tpl.textContent = t(`editor.templates.${row.template}`);
          shot.append(tpl);
        }

        // --- Body --------------------------------------------------------
        const body = document.createElement('div');
        body.className = 'body';
        const title = document.createElement('b');
        // textContent, never innerHTML: the agent typed this.
        title.textContent = flatTitle(row);
        const priceRow = document.createElement('div');
        priceRow.className = 'price-row';
        priceRow.append(priceNode(row));
        const place = [row.location?.street, row.location?.city].filter(Boolean).join(', ');
        if (place) {
          const where = document.createElement('span');
          where.className = 'where';
          where.textContent = place;
          priceRow.append(where);
        }
        body.append(title, priceRow);

        if (row.status === 'published' || row.status === 'sold') {
          const stats = document.createElement('div');
          stats.className = 'stats';
          const stat = (d: string, fill: boolean, value: number, label: string) => {
            const span = document.createElement('span');
            const bdi = document.createElement('bdi');
            bdi.textContent = num(value);
            span.append(icon(d, fill), bdi, document.createTextNode(` ${label}`));
            return span;
          };
          stats.append(
            stat(EYE, false, row.views ?? 0, t('dash.views')),
            stat(CHAT, true, row.waTaps ?? 0, t('dash.waTaps')),
          );
          const days = daysLive(row);
          if (days !== undefined) stats.append(stat(CLOCK, false, days, t('dash.daysLive')));
          body.append(stats);
        }

        item.append(shot, body);

        let hint = '';
        if (row.status === 'draft') hint = t('dash.draftHint');
        else if (row.status === 'archived') hint = t('dash.archivedHint');
        else if (isStalePublished(row, Date.now())) hint = t('dash.staleHint');
        if (hint) {
          const note = document.createElement('p');
          note.className = 'hint';
          note.textContent = hint;
          item.append(note);
        }

        // --- Actions -----------------------------------------------------
        const acts = document.createElement('div');
        acts.className = 'acts';
        if (sendable) {
          acts.append(
            link(t('dash.share'), 'act primary', `/a/${row.slug}/share/`),
            button(t('dash.copyLink'), 'act', () => void copy(href)),
          );
        }
        // The listing this card is for, not a blank new one.
        acts.append(link(t('dash.edit'), 'act', `/new/?id=${encodeURIComponent(row.slug)}`));
        if (row.status === 'published') {
          acts.append(button(t('dash.markSold'), 'act', (self) => void markSold(row.slug, self)));
        }
        if (row.status !== 'archived') {
          acts.append(button(t('dash.archive'), 'act', (self) => void archiveListing(row.slug, self)));
        }
        acts.append(button(t('dash.delete'), 'act', (self) => void deleteListing(row.slug, self)));
        item.append(acts);

        // Choosing a card opens it in the panel. Clicks on the card's own
        // links and buttons keep doing what they say.
        item.addEventListener('click', (event) => {
          if ((event.target as Element).closest('a, button')) return;
          choose(row.slug);
        });

        return item;
      };

      // ------------------------------------------------------------------
      // Detail panel
      // ------------------------------------------------------------------

      const chart = (points: DayPoint[]) => {
        const wrap = document.createElement('div');
        wrap.className = 'chart';
        const heading = document.createElement('h3');
        heading.textContent = t('dash.chartTitle');
        wrap.append(heading);

        const { views } = totals(points);
        if (views === 0) {
          const empty = document.createElement('p');
          empty.className = 'd-note';
          empty.textContent = t('dash.chartEmpty');
          wrap.append(empty);
          return wrap;
        }

        const max = Math.max(...points.map((p) => p.views));
        const peak = points.findIndex((p) => p.views === max);
        const summary = document.createElement('p');
        summary.className = 'd-note';
        summary.append(...sentence('dash.chartSummary', { views, days: points.length, max }));

        // The bars are for the eye; the table below carries the same numbers
        // for everyone else.
        const bars = document.createElement('ol');
        bars.className = 'bars';
        bars.setAttribute('aria-hidden', 'true');
        points.forEach((point, index) => {
          const item = document.createElement('li');
          if (index === points.length - 1) item.classList.add('is-last');
          const bar = document.createElement('span');
          bar.className = 'b';
          const height = `${Math.round((point.views / max) * 100)}%`;
          item.style.setProperty('--h', height);
          bar.style.setProperty('--i', String(index));
          item.append(bar);
          // Selective labels: the peak and today, never every bar.
          if (index === peak || index === points.length - 1) {
            const cap = document.createElement('span');
            cap.className = 'cap';
            cap.textContent = num(point.views);
            item.append(cap);
          }
          const tip = document.createElement('span');
          tip.className = 'tip';
          if (index < points.length * 0.25) tip.classList.add('at-start');
          else if (index > points.length * 0.75) tip.classList.add('at-end');
          tip.hidden = true;
          const [, month, day] = point.day.split('-');
          const date = document.createElement('bdi');
          date.textContent = `${Number(day)}/${Number(month)}`;
          const v = document.createElement('bdi');
          v.textContent = num(point.views);
          const w = document.createElement('bdi');
          w.textContent = num(point.taps);
          tip.append(date, ' · ', v, ` ${t('dash.views')} · `, w, ` ${t('dash.waTaps')}`);
          item.append(tip);
          item.addEventListener('pointerenter', () => (tip.hidden = false));
          item.addEventListener('pointerleave', () => (tip.hidden = true));
          bars.append(item);
        });

        const axis = document.createElement('div');
        axis.className = 'axis';
        axis.setAttribute('aria-hidden', 'true');
        const label = (point: DayPoint | undefined) => {
          const bdi = document.createElement('bdi');
          if (point) {
            const [, month, day] = point.day.split('-');
            bdi.textContent = `${Number(day)}/${Number(month)}`;
          }
          return bdi;
        };
        axis.append(label(points[0]), label(points.at(-1)));

        const table = document.createElement('details');
        table.className = 'table-view';
        const toggle = document.createElement('summary');
        toggle.textContent = t('dash.chartTable');
        const grid = document.createElement('table');
        const head = grid.createTHead().insertRow();
        for (const text of [t('dash.colDay'), t('dash.views'), t('dash.waTaps')]) {
          const th = document.createElement('th');
          th.textContent = text;
          head.append(th);
        }
        const tbody = grid.createTBody();
        for (const point of points) {
          const tr = tbody.insertRow();
          const [, month, day] = point.day.split('-');
          for (const text of [`${Number(day)}/${Number(month)}`, num(point.views), num(point.taps)]) {
            const td = tr.insertCell();
            const bdi = document.createElement('bdi');
            bdi.textContent = text;
            td.append(bdi);
          }
        }
        table.append(toggle, grid);

        wrap.append(summary, bars, axis, table);
        return wrap;
      };

      const paintDetail = (fresh = false) => {
        const row = rows.find((candidate) => candidate.slug === chosen);
        if (!row) {
          detail.hidden = true;
          return;
        }
        detail.replaceChildren();
        detail.hidden = false;
        detail.classList.toggle('is-new', fresh);

        // Only seen on a phone, where the panel is a sheet over the page.
        const close = document.createElement('button');
        close.type = 'button';
        close.className = 'd-close';
        close.setAttribute('aria-label', t('dash.close'));
        close.append(icon('M6 6l12 12M18 6 6 18'));
        close.addEventListener('click', closeSheet);
        detail.append(close);

        const pics = document.createElement('div');
        pics.className = 'd-pics';
        const images = [row.media?.cover, ...(row.media?.gallery ?? [])]
          .map((image) => image?.url)
          .filter((url): url is string => Boolean(url))
          .slice(0, 3);
        pics.dataset.n = String(images.length);
        for (const url of images) {
          const image = document.createElement('img');
          image.src = url;
          image.alt = '';
          image.loading = 'lazy';
          pics.append(image);
        }
        if (images.length > 0) detail.append(pics);

        const head = document.createElement('div');
        head.className = 'd-head';
        const title = document.createElement('h2');
        title.textContent = flatTitle(row);
        const where = document.createElement('div');
        where.className = 'where';
        where.textContent = [
          row.location?.city,
          row.template ? t(`editor.templates.${row.template}`) : '',
          statusLabel(row.status),
        ]
          .filter(Boolean)
          .join(' · ');
        head.append(title, where, priceNode(row));
        detail.append(head);

        if (row.status === 'draft') {
          const note = document.createElement('p');
          note.className = 'd-note';
          note.textContent = t('dash.detailDraft');
          detail.append(note);
        } else {
          const views = row.views ?? 0;
          const taps = row.waTaps ?? 0;
          const rate = contactRate(views, taps);
          const stats = document.createElement('dl');
          stats.className = 'd-stats';
          const cells: [string, string][] = [
            [t('dash.views'), num(views)],
            [t('dash.waTaps'), num(taps)],
            [t('dash.rateShort'), rate === undefined ? '—' : `${rate.toFixed(1)}%`],
          ];
          if (reads && row.id) {
            const through = readThrough(reads, windowDays, row.id);
            const read = readRate(through.views, through.reads);
            cells.push([t('dash.readShort'), read === undefined ? '—' : `${read}%`]);
          }
          stats.style.setProperty('--n', String(cells.length));
          for (const [label, value] of cells) {
            const cell = document.createElement('div');
            const dt = document.createElement('dt');
            dt.textContent = label;
            const dd = document.createElement('dd');
            const bdi = document.createElement('bdi');
            bdi.textContent = value;
            dd.append(bdi);
            cell.append(dt, dd);
            stats.append(cell);
          }
          detail.append(stats);

          if (daily && row.id && row.published_at) {
            const days = daysSincePublished(row.published_at, today, WINDOW);
            if (days.length > 0) detail.append(chart(series(daily, days, row.id)));
          }
        }

        if (row.status === 'published') detail.append(studio(row));

        const acts = document.createElement('div');
        acts.className = 'd-acts';
        acts.append(link(t('dash.edit'), 'act', `/new/?id=${encodeURIComponent(row.slug)}`));
        if (row.status === 'published') {
          acts.append(button(t('dash.markSold'), 'act', (self) => void markSold(row.slug, self)));
        }
        detail.append(acts);
      };

      // ------------------------------------------------------------------
      // Share Studio
      // ------------------------------------------------------------------

      /**
       * Everything that leaves the dashboard, in one place: the card WhatsApp
       * will draw, the link, the ready message (the share kit page) and a QR
       * for a flyer or a sign. The QR encoder is imported only here, so the
       * dashboard's first load carries none of it.
       */
      const studio = (row: Row) => {
        const box = document.createElement('section');
        box.className = 'studio';
        const heading = document.createElement('h3');
        heading.textContent = t('dash.studio');
        box.append(heading);

        const card = document.createElement('div');
        card.className = 'studio-card';
        const cover = row.media?.cover?.url;
        if (cover) {
          const image = document.createElement('img');
          image.src = cover;
          image.alt = '';
          image.loading = 'lazy';
          card.append(image);
        }
        const text = document.createElement('div');
        const title = document.createElement('b');
        title.append(document.createTextNode(`${flatTitle(row)} · `));
        const price = document.createElement('bdi');
        price.textContent = money.format(Number(row.price ?? 0));
        title.append(price);
        const domain = document.createElement('small');
        domain.dir = 'ltr';
        domain.textContent = window.location.host;
        text.append(title, domain);
        card.append(text);
        const cap = document.createElement('p');
        cap.className = 'studio-cap';
        cap.textContent = t('dash.studioCard');
        box.append(card, cap);

        const linkBox = document.createElement('div');
        linkBox.className = 'linkbox';
        const label = document.createElement('span');
        label.textContent = t('dash.linkLabel');
        const url = document.createElement('bdi');
        url.textContent = publicUrl(row.slug).replace(/^https?:\/\//, '');
        linkBox.append(label, url, button(t('dash.copyLink'), 'act primary', () => void copy(publicUrl(row.slug))));
        box.append(linkBox);

        const qr = document.createElement('div');
        qr.className = 'studio-qr';
        const slot = document.createElement('span');
        slot.className = 'qr-slot';
        slot.setAttribute('aria-hidden', 'true');
        const side = document.createElement('div');
        const about = document.createElement('span');
        about.textContent = t('dash.studioQr');
        side.append(about);
        qr.append(slot, side);
        box.append(qr);

        void import('../lib/qr')
          .then(({ qrDrawing, qrSvgFile }) => {
            const target = publicUrl(row.slug);
            const { box: size, d } = qrDrawing(target);
            const svg = document.createElementNS(svgNS, 'svg');
            svg.setAttribute('viewBox', `0 0 ${size} ${size}`);
            svg.setAttribute('role', 'img');
            svg.setAttribute('aria-label', t('dash.studioQr'));
            svg.setAttribute('shape-rendering', 'crispEdges');
            const paper = document.createElementNS(svgNS, 'rect');
            paper.setAttribute('width', String(size));
            paper.setAttribute('height', String(size));
            paper.setAttribute('fill', '#ffffff');
            const ink = document.createElementNS(svgNS, 'path');
            ink.setAttribute('d', d);
            ink.setAttribute('fill', '#0b0c0a');
            svg.append(paper, ink);
            slot.replaceWith(svg);

            const file = new Blob([qrSvgFile(target)], { type: 'image/svg+xml' });
            const save = document.createElement('a');
            save.className = 'act';
            save.href = URL.createObjectURL(file);
            save.download = `hasivuv-${row.slug}-qr.svg`;
            save.textContent = t('dash.qrDownload');
            side.append(save);
          })
          .catch(() => qr.remove());

        // The story image and the flyer, once the worker has made them.
        // Before that they are simply not offered — never a dead link.
        const https = (url: unknown) => (typeof url === 'string' && url.startsWith('https://') ? url : undefined);
        const story = https(row.media?.storyUrl);
        const flyer = https(row.media?.flyerUrl);
        if (story || flyer) {
          const made = document.createElement('div');
          made.className = 'studio-made';
          if (story) {
            const figure = document.createElement('a');
            figure.className = 'studio-story';
            figure.href = story;
            figure.target = '_blank';
            figure.rel = 'noopener';
            const image = document.createElement('img');
            image.src = story;
            image.alt = t('dash.studioStory');
            image.loading = 'lazy';
            const label = document.createElement('span');
            label.textContent = t('dash.studioStory');
            figure.append(image, label);
            made.append(figure);
          }
          if (flyer) {
            const file = document.createElement('a');
            file.className = 'act';
            file.href = flyer;
            file.target = '_blank';
            file.rel = 'noopener';
            file.textContent = t('dash.studioFlyer');
            made.append(file);
          }
          box.append(made);
        }

        const acts = document.createElement('div');
        acts.className = 'd-acts';
        acts.append(link(t('dash.studioMessage'), 'act primary', `/a/${row.slug}/share/`));
        box.append(acts);
        return box;
      };

      const closeSheet = () => {
        detail.classList.remove('is-open');
        document.documentElement.classList.remove('dash-sheet');
        grid.querySelector<HTMLElement>(`.card[data-slug="${CSS.escape(chosen ?? '')}"]`)?.focus();
      };

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && detail.classList.contains('is-open')) closeSheet();
      });

      const choose = (slug: string) => {
        chosen = slug;
        for (const node of grid.querySelectorAll<HTMLElement>('.card')) {
          node.classList.toggle('is-chosen', node.dataset.slug === slug);
        }
        paintDetail(true);
        // A phone gets the panel as a sheet; a wide screen already shows it.
        if (!matchMedia('(min-width: 1100px)').matches) {
          detail.classList.add('is-open');
          document.documentElement.classList.add('dash-sheet');
          detail.querySelector<HTMLElement>('.d-close')?.focus();
        }
      };

      /** Renders whatever the current filter selects. */
      const paint = () => {
        const filter =
          (document.querySelector('input[name="filter"]:checked') as HTMLInputElement | null)?.value ??
          'all';
        const shown =
          filter === 'all'
            ? rows.filter((row) => row.status !== 'archived')
            : rows.filter((row) => row.status === filter);

        const shownCount = document.createElement('bdi');
        shownCount.textContent = num(shown.length);
        count.replaceChildren(shownCount, document.createTextNode(` ${t('dash.countSuffix')}`));
        paintTiles();
        filters.hidden = false;

        if (shown.length === 0) {
          show('none');
          return;
        }
        // The panel opens on the first listing that has something to show.
        if (!chosen || !rows.some((row) => row.slug === chosen)) {
          chosen = (shown.find((row) => row.status === 'published') ?? shown[0])?.slug;
        }
        grid.replaceChildren(...shown.map(card));
        paintDetail();
        show('workspace');
      };

      const load = async () => {
        if (!supabaseConfigured) return show('failed');
        const client = supabase();
        const { data: session } = await client.auth.getSession();
        if (!session.session) return show('anon');

        void revealIfSiteAdmin(document.getElementById('nav-admin'));

        /*
         * No `.eq('owner_id', …)`, on purpose.
         *
         * The policy in 0002 restricts this to the signed-in agent's own rows.
         * Adding the filter here would LOOK like the security and quietly
         * become the security the day somebody edits the policy.
         */
        const { data, error } = await client
          .from('listings')
          .select('id, slug, title, price, status, category, template, media, location, published_at')
          .order('created_at', { ascending: false });
        if (error) return show('failed');
        rows = (data ?? []) as Row[];

        const [counts, perDay, perDayReads] = await Promise.all([
          client.from('listing_event_counts').select('listing_id, views, wa_taps'),
          // The same RLS: listing_event_daily is security_invoker (0029).
          client
            .from('listing_event_daily')
            .select('listing_id, day, views, wa_taps')
            .gte('day', windowDays[0] ?? ''),
          // Its own request: a database without 0030 answers this with an
          // error, and only the read-through numbers go missing.
          client
            .from('listing_event_daily')
            .select('listing_id, day, views, read_to_agent')
            .gte('day', windowDays[0] ?? ''),
        ]);

        if (!counts.error && counts.data) {
          const byId = new Map(
            (counts.data as { listing_id: string; views: number; wa_taps: number }[]).map((row) => [
              row.listing_id,
              row,
            ]),
          );
          rows = rows.map((row) => {
            const tally = row.id ? byId.get(row.id) : undefined;
            return { ...row, views: Number(tally?.views ?? 0), waTaps: Number(tally?.wa_taps ?? 0) };
          });
        }
        // Unavailable (0029 not applied, or an error) leaves daily undefined:
        // the tiles then say "since publishing" and the charts are omitted.
        daily = perDay.error ? undefined : ((perDay.data ?? []) as DailyRow[]);
        reads = perDayReads.error ? undefined : ((perDayReads.data ?? []) as ReadRow[]);

        /*
         * The first-run prompt and the greeting, decided by the profile.
         * Failure is silent: a banner is a convenience and must never be the
         * reason the dashboard does not appear.
         */
        void loadProfile()
          .then((result) => {
            if (!('profile' in result)) return;
            if (isProfileEmpty(result.profile)) $('onboard').hidden = false;
            const first = result.profile.displayName?.trim().split(/\s+/)[0];
            if (first) {
              $('hello').textContent = t('dash.hello', { name: first });
              $('hello').hidden = false;
            }
          })
          .catch(() => undefined);

        if (rows.length === 0) return show('empty');
        paint();
      };

      for (const input of document.querySelectorAll('input[name="filter"]')) {
        input.addEventListener('change', paint);
      }

      // A rejection must not leave the spinner up forever. The agent gets a
      // state they can act on instead of a page that never resolves.
      void load().catch(() => show('failed'));
    </script>
</Site>
