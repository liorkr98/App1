---
import { t } from '../lib/i18n';
import { ils } from '../lib/format';
import { ogDescription, ogTitle } from '../lib/og';
import { CATEGORY_PRESENTATION } from '../lib/category-presentation';
import { GALLERY_WIDTHS, HERO_WIDTHS, largest } from '../lib/images';
import { golfListing, tlvListing } from '../lib/fixtures';
import Prose from '../components/Prose.astro';
import PriceTiers from '../components/PriceTiers.astro';
import Site from '../layouts/Site.astro';
import { TEMPLATE_IDS } from '@/types/listing';
import { templateFits, templateSpec } from '@/features/templates/manifest';
import '../styles/home.css';
import '../styles/film.css';
import Film from '../components/Film.astro';
import { filmDuration } from '@/features/listings/ken-burns';
import { softwareLd } from '../lib/seo';
import { demoPath } from '../lib/template-pages';
import { MAX_IMAGES } from '@/features/listings/editor';
import Testimonials from '../components/Testimonials.astro';

/**
 * The homepage (עמוד מכירה 2.0, plan §7.1). Onyx: the product demo is the page.
 *
 * REWRITTEN for P5 from the approved prototype. The September version sold
 * "a few professional options" with miniature re-drawings of the 1.x
 * templates; the catalogue is now twelve composed templates, and a
 * re-drawing of those would be a second implementation of each, drifting
 * from the first.
 *
 * WHAT IS REAL, WHAT IS A PICTURE
 *   - The hero phone assembles the Tel Aviv fixture: its own photographs,
 *     room labels, title and price. The motion is a demonstration of the
 *     editor's steps, and the aria-label says so.
 *   - The template row shows SCREENSHOTS of the real pages
 *     (/home/templates/{id}.webp, the first screen of /template-check at 390
 *     px, Hebrew, reduced motion). Each one links to the same page's public
 *     copy, /templates/{id}/demo/. When a
 *     template's first screen changes, its screenshot is retaken —
 *     scripts/verify-template-ids.mjs fails if one is missing.
 *   - The WhatsApp card is built by ogTitle/ogDescription, the functions
 *     that write the real meta tags, so it cannot promise a card the product
 *     does not make.
 *   - Only features that work today are on this page (14 Oct 2026): the
 *     בקרוב tiles went, because an unfinished feature beside a finished one
 *     makes both look unfinished.
 *
 * No OSM-derived data is shown here any more (the "around" section went with
 * the redesign), so there is no ODbL line to carry.
 */

const home = tlvListing;
const builderPhotos = [home.media.cover, ...home.media.gallery].slice(0, 4);
const titleLines = home.title.split('\n');

// The catalogue: the Living Surfaces templates, in TEMPLATE_IDS order.
// Each links to its live example under /templates/ — never /template-check/,
// which is a CI fixture that is not deployed (e2e/links.spec.ts).
const catalogue = TEMPLATE_IDS.filter((id) => templateSpec(id).ls !== undefined).map((id) => {
  return { id, car: !templateFits(id, 'property'), href: demoPath(id) };
});
// The general templates fit a car too, but their pictures show the flat; the
// car pill shows only the ones pictured with the car and counts the rest.
const sharedWithCars = catalogue.filter((tpl) => !tpl.car && templateFits(tpl.id, 'vehicle')).length;

const cardTitle = ogTitle(home);
const cardFacts = ogDescription(home, CATEGORY_PRESENTATION.property.ogFactKeys);
const cardImage = largest(home.media.cover, HERO_WIDTHS);
// The scroll story's third screen: the first template the catalogue shows,
// whose picture the templates row already loads.
const storyTemplate = catalogue[0]?.id ?? 'aurora';
const roomsValue = home.facts.find((fact) => fact.key === 'rooms')?.value;
const storyRooms = typeof roomsValue === 'number' ? String(roomsValue) : '';
const storySteps = [1, 2, 3, 4] as const;

const photoOf = (index: number) => {
  const image = [home.media.cover, ...home.media.gallery][index] ?? home.media.cover;
  return largest(image, GALLERY_WIDTHS);
};
const plan = home.media.floorPlan;

const wow = [
  { key: 'Plan', live: true, href: demoPath('blueprint'), image: plan ? largest(plan, GALLERY_WIDTHS) : photoOf(0), contain: Boolean(plan) },
  { key: 'Sun', live: true, href: demoPath('heliograph'), drawing: 'sun' },
  { key: 'Walk', live: true, href: demoPath('walk'), drawing: 'walk' },
  // Built in P7 (the editor takes the frames, Showroom turns them); no demo
  // listing has a real sequence yet, so the tile says so without a link.
  { key: 'Spin', live: true, image: largest(golfListing.media.cover, GALLERY_WIDTHS) },
  { key: 'Video', live: true, href: '#hero', image: photoOf(1) },
] as const;

const title = `${t('common.brand')} — ${t('home.tagline')}`;
const ogImage = new URL('/og-home.webp', Astro.site).href;
---

<Site
  title={title}
  description={t('home.subTagline')}
  og={{ image: ogImage, title: t('common.brand'), description: t('home.subTagline') }}
  ld={[softwareLd(Astro.site ?? new URL(Astro.url.origin))]}
>
  {/*
    The demo phone waits for the faces (home.css, html.hm-wait). When Heebo
    and Noto arrive the hero copy rewraps shorter and the phone moved up
    63px under the reader: 0.11 layout shift on CI's cheap phone, over the
    0.05 limit (e2e/speed.spec.ts). Something that appears is not a shift;
    something that moves is. Without script the class is never set, and the
    phone shows from the start; with it, never later than six seconds.

    It waits for the two faces the hero copy is set in, not fonts.ready,
    which also waits for faces that move nothing (and the phone is the
    first screen's largest paint). The script runs before the stylesheets
    that declare the faces, and until they are parsed load() finds no face
    and resolves at once, so it asks again until both exist and loaded.
  */}
  <script is:inline slot="head">
    document.documentElement.classList.add('hm-wait');
    (function () {
      var root = document.documentElement;
      var done = function () { root.classList.remove('hm-wait'); };
      var tries = 0;
      var wait = function () {
        Promise.all([
          document.fonts.load('900 1em "Noto Sans Hebrew"', 'א'),
          document.fonts.load('400 1em Heebo', 'א'),
        ]).then(function (faces) {
          if ((faces[0].length && faces[1].length) || ++tries > 100) done();
          else setTimeout(wait, 50);
        }, done);
      };
      if (document.fonts && document.fonts.load) wait();
      else done();
      setTimeout(done, 6000);
    })();
  </script>
  <section class="hm-hero ls-grain" id="hero">
    <div class="site-shell hm-hero-grid">
      <div class="hm-copy">
        <h1 class="hm-title">
          <span class="ls-line"><span style="--i:0">{t('home.heroLine1')}</span></span>
          <span class="ls-line"><span class="hm-line2" style="--i:1">{t('home.heroLine2')}</span></span>
        </h1>
        <p class="site-sub ls-fade" style="--i:2">{t('home.heroSub')}</p>
        <div class="site-actions hm-actions ls-fade" style="--i:3">
          <a class="site-btn site-btn-primary ls-sheen" href="/new/?fresh=1">{t('home.cta')}</a>
          <a class="site-btn site-btn-ghost" href="#templates">{t('home.ctaTemplates')}</a>
        </div>
        <p class="site-note ls-fade" style="--i:4">{t('home.ctaNote')}</p>
      </div>

      {/* Rests on the finished listing (state 3). The script plays the steps
          only when motion is allowed and the phone is on screen. */}
      <div class="hm-phone" role="img" aria-label={t('home.builderLabel')}>
        <div class="hm-screen" data-builder data-state="3" data-film-ms={Math.round(filmDuration(builderPhotos.length) * 1000)}>
          <p class="hm-step" data-step aria-hidden="true">
            <span data-n="0">{t('home.build1')}</span>
            <span data-n="1">{t('home.build2')}</span>
            <span data-n="2">{t('home.build3')}</span>
            <span data-n="3">{t('home.build4')}</span>
          </p>
          {builderPhotos.map((image, i) => (
            <div class="hm-photo" data-i={i}>
              <img
                src={largest(image, GALLERY_WIDTHS)}
                alt=""
                width={image.width}
                height={image.height}
                decoding="async"
                fetchpriority={i === 0 ? 'high' : undefined}
                loading={i === 0 ? 'eager' : 'lazy'}
              />
              {image.room && <span class="hm-room">{t(`editor.rooms.${image.room}`)}</span>}
            </div>
          ))}
          <Film images={builderPhotos} mode="hero" />
          <div class="hm-shade"></div>
          <div class="hm-ui">
            <p class="hm-ui-title">{titleLines.map((line) => <span><Prose text={line} /></span>)}</p>
            <p class="hm-ui-price"><bdi>{ils(home.price)}</bdi></p>
            <span class="hm-ui-wa">{t('home.waButton')}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="site-sect ls-sect">
    <div class="site-shell">
      <h2 class="site-h2">{t('home.raceTitle')}</h2>
      <div class="hm-race" data-race>
        <div class="hm-race-card">
          <h3>{t('home.raceOld')}</h3>
          <p class="hm-clock hm-clock-old">{t('home.raceOldClock')}</p>
          <ul>
            <li>{t('home.raceOld1')}</li>
            <li>{t('home.raceOld2')}</li>
            <li>{t('home.raceOld3')}</li>
            <li><Prose text={t('home.raceOld4')} /></li>
          </ul>
        </div>
        <div class="hm-race-card is-us">
          <h3>{t('home.raceNew')}</h3>
          <p class="hm-clock"><bdi data-clock>4:00</bdi></p>
          <ul data-race-steps>
            <li class="is-done">{t('home.raceNew1')}</li>
            <li class="is-done">{t('home.raceNew2')}</li>
            <li class="is-done">{t('home.raceNew3')}</li>
            <li class="is-done">{t('home.raceNew4')}</li>
            <li class="is-done">{t('home.raceNew5')}</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/*
    The scroll story (16 Oct 2026): the four minutes, one screen per step.
    The phone stays while the steps pass; the step nearest the middle of the
    screen decides what it shows. Every picture in it is one the page
    already loads. Without script the phone rests on the last screen and the
    four steps read as a list; under reduced motion the screens swap without
    a fade.
  */}
  <section class="site-sect hm-story" aria-labelledby="hm-story-title">
    <div class="site-shell hm-story-grid">
      <h2 class="site-h2 hm-story-title" id="hm-story-title">{t('home.storyTitle')}</h2>
      <div class="hm-story-stage">
        <div class="hm-story-phone" data-story-phone data-step="4" role="img" aria-label={t('home.storyPhone')}>
          <div class="hm-story-screen" data-n="1">
            <div class="hm-story-photos">
              {builderPhotos.map((image) => (
                <img src={largest(image, GALLERY_WIDTHS)} alt="" loading="lazy" decoding="async" width={image.width} height={image.height} />
              ))}
            </div>
          </div>
          <div class="hm-story-screen" data-n="2">
            <dl class="hm-story-form">
              <div><dt>{t('editor.details.city')}</dt><dd>{home.location?.city}</dd></div>
              <div><dt>{t('editor.steps.rooms')}</dt><dd><bdi>{storyRooms}</bdi></dd></div>
              <div><dt>{t('editor.details.price')}</dt><dd><bdi>{ils(home.price)}</bdi></dd></div>
            </dl>
          </div>
          <div class="hm-story-screen is-page" data-n="3">
            <img class="hm-story-page" src={`/home/templates/${storyTemplate}.webp`} alt="" loading="lazy" decoding="async" width="400" height="866" />
          </div>
          <div class="hm-story-screen hm-story-wa" data-n="4">
            <div class="hm-bubble">
              <div class="hm-card">
                <img src={cardImage} alt="" loading="lazy" decoding="async" width="1200" height="630" />
                <div>
                  <b><Prose text={cardTitle} /></b>
                  <small dir="ltr">amudsell.com</small>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <ol class="hm-story-steps">
        {storySteps.map((n) => (
          <li class="hm-story-step" data-story-step={n}>
            <span class="hm-story-n" aria-hidden="true"><bdi>{n}</bdi></span>
            <h3>{t(`home.story${n}`)}</h3>
            <p><Prose text={t(`home.story${n}Body`, { max: MAX_IMAGES })} /></p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="site-sect hm-templates" id="templates">
    {/*
      The category pills (16 Oct 2026): radio inputs and CSS, no script.
      Each template has one picture, of the flat or of the car, so each pill
      shows the same listing across its templates. The inputs come first so
      the row and the labels can follow their state.
    */}
    <input class="hm-cat visually-hidden" type="radio" name="hm-cat" id="hm-cat-property" checked />
    <input class="hm-cat visually-hidden" type="radio" name="hm-cat" id="hm-cat-vehicle" />
    <div class="site-shell">
      <h2 class="site-h2">{t('home.templatesTitle')}</h2>
      <p class="site-sub">{t('home.templatesBody')}</p>
      <div class="hm-pills" role="group" aria-label={t('home.pillsLabel')}>
        <label class="hm-pill" for="hm-cat-property">{t('home.pillProperty')}</label>
        <label class="hm-pill" for="hm-cat-vehicle">{t('home.pillVehicle')}</label>
      </div>
    </div>
    <ul class="hm-row">
      {catalogue.map((tpl) => (
        <li data-cat={tpl.car ? 'vehicle' : 'property'}>
          <a class="hm-device" href={tpl.href} aria-label={`${t('home.templatesOpen')} ${t(`editor.templates.${tpl.id}`)}`}>
            <span class="hm-device-screen">
              <img
                src={`/home/templates/${tpl.id}.webp`}
                alt=""
                width="400"
                height="866"
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="hm-device-name">
              {t(`editor.templates.${tpl.id}`)}
              {tpl.car && <span class="hm-car">{t('home.templatesCar')}</span>}
            </span>
            <span class="hm-device-note">{t(`editor.templates.${tpl.id}Note`)}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="site-shell hm-pill-note">
      <Prose text={t('home.pillNote', { n: sharedWithCars })} /> <a href="/templates/">{t('home.pillAll')}</a>
    </p>
  </section>

  <section class="site-sect ls-sect">
    <div class="site-shell">
      <h2 class="site-h2">{t('home.wowTitle')}</h2>
      <ul class="hm-wow">
        {wow.map((item) => {
          const body = (
            <>
              <span class="hm-wow-vis" aria-hidden="true">
                {'image' in item && item.image && (
                  <img
                    src={item.image}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class:list={['contain' in item && item.contain ? 'is-plan' : 'ls-breathe']}
                  />
                )}
                {'drawing' in item && item.drawing === 'sun' && (
                  <svg viewBox="0 0 200 120" class="hm-draw">
                    <path d="M16 110 A84 84 0 0 1 184 110" class="hm-draw-arc" />
                    <path d="M100 110 L60 118 L140 118 Z" class="hm-draw-wedge" />
                    <circle cx="146" cy="44" r="10" class="hm-draw-sun" />
                    <line x1="8" y1="110" x2="192" y2="110" class="hm-draw-ground" />
                  </svg>
                )}
                {'drawing' in item && item.drawing === 'walk' && (
                  <svg viewBox="0 0 200 120" class="hm-draw">
                    <path d="M24 100 C70 100 60 40 108 44 S170 24 180 18" class="hm-draw-route" />
                    <circle cx="24" cy="100" r="7" class="hm-draw-home" />
                    <circle cx="74" cy="72" r="5" class="hm-draw-stop" />
                    <circle cx="124" cy="40" r="5" class="hm-draw-stop" />
                    <circle cx="180" cy="18" r="5" class="hm-draw-stop" />
                  </svg>
                )}
              </span>
              <b>{t(`home.wow${item.key}`)}</b>
              <span>{t(`home.wow${item.key}Body`)}</span>
            </>
          );
          return (
            <li class="hm-wow-card is-live">
              {'href' in item ? <a href={item.href}>{body}</a> : <div>{body}</div>}
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="site-sect ls-sect">
    <div class="site-shell hm-wa-grid">
      <div>
        <h2 class="site-h2">{t('home.waTitle')}</h2>
        <p class="site-sub">{t('home.waNote')}</p>
      </div>
      {/*
        Before and after (16 Oct 2026): the same chat, sent the usual way and
        sent as a page. A real range input carries the comparison, so it
        works with a keyboard and a screen reader; the divider and the clip
        follow its value. Without script it rests at the middle.
      */}
      <div class="hm-compare" data-compare>
        <div class="hm-chat hm-chat-before" aria-hidden="true">
          <p class="hm-chat-top">{t('home.waBuyer')}</p>
          <div class="hm-chat-body">
            <p class="hm-bubble is-them">{t('home.waAsk')}</p>
            <p class="hm-bubble is-text">
              <span><Prose text={t('home.beforeMsg', { facts: cardFacts })} /></span>
              <bdi class="hm-bare-link" dir="ltr">{t('home.beforeLink')}</bdi>
            </p>
            <p class="hm-bubble is-them">{t('home.beforeBack')}</p>
          </div>
        </div>
        <div class="hm-chat hm-chat-after" aria-hidden="true">
          <p class="hm-chat-top">{t('home.waBuyer')}</p>
          <div class="hm-chat-body">
            <p class="hm-bubble is-them">{t('home.waAsk')}</p>
            <div class="hm-bubble">
              <div class="hm-card">
                <img src={cardImage} alt="" loading="lazy" decoding="async" width="1200" height="630" />
                <div>
                  <b><Prose text={cardTitle} /></b>
                  <small><Prose text={cardFacts} /></small>
                  <small dir="ltr">amudsell.com</small>
                </div>
              </div>
              <p>{t('home.waReply')}</p>
            </div>
            <p class="hm-bubble is-them">{t('home.waBack')}</p>
          </div>
        </div>
        <span class="hm-compare-tag is-before" aria-hidden="true">{t('home.compareBefore')}</span>
        <span class="hm-compare-tag is-after" aria-hidden="true">{t('home.compareAfter')}</span>
        <input class="hm-compare-range" type="range" min="0" max="100" value="50" aria-label={t('home.compareLabel')} />
        <span class="hm-compare-line" aria-hidden="true"><span class="hm-compare-knob"></span></span>
      </div>
    </div>
  </section>

  <Testimonials />

  <section class="site-sect">
    <div class="site-shell">
      <h2 class="site-h2">{t('home.pricingTitle')}</h2>
      <PriceTiers />
      <p class="hm-more"><a class="site-link" href="/pricing/">{t('home.pricingLink')}</a></p>
      <p class="hm-more">
        {t('audiences.homeLine')}{' '}
        <a href="/agents/">{t('audiences.navAgents')}</a> · <a href="/dealers/">{t('audiences.navDealers')}</a> · <a href="/private/">{t('audiences.navPrivate')}</a>
      </p>
    </div>
  </section>

  <section class="site-sect hm-closing">
    <div class="site-shell">
      <h2 class="site-h2">{t('home.closingTitle')}</h2>
      <p class="site-sub">{t('home.closingBody')}</p>
      <div class="site-actions">
        <a class="site-btn site-btn-primary" href="/new/?fresh=1">{t('home.cta')}</a>
        <a class="site-btn site-btn-ghost" href="/pricing/">{t('pricing.title')}</a>
      </div>
    </div>
  </section>

  <script>
    /**
     * Two small pieces of motion, both off for reduced motion, both
     * starting from — and resting on — a finished state already in the
     * markup, so a script that never runs leaves a whole page.
     */
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // The hero phone: scattered → tagged → cover and title → ready, looped
    // while it is on screen.
    const builder = document.querySelector<HTMLElement>('[data-builder]');
    if (builder && !still) {
      const filmMs = Number(builder.dataset.filmMs);
      const HOLD = [1500, 1900, 1900, Number.isFinite(filmMs) && filmMs > 0 ? filmMs + 400 : 3400];
      let state = 3;
      let timer = 0;
      const step = () => {
        state = (state + 1) % 4;
        builder.dataset.state = String(state);
        timer = window.setTimeout(step, HOLD[state]);
      };
      new IntersectionObserver(([entry]) => {
        window.clearTimeout(timer);
        if (entry?.isIntersecting) {
          state = 3;
          step();
        } else {
          builder.dataset.state = '3';
        }
      }, { threshold: 0.3 }).observe(builder);
    }

    // The scroll story: the step crossing the middle of the screen decides
    // which screen the phone shows. Reduced motion still switches (the swap
    // is the content); only the fade is dropped, in home.css.
    const story = document.querySelector<HTMLElement>('.hm-story');
    const storyPhone = story?.querySelector<HTMLElement>('[data-story-phone]');
    const storySteps = [...(story?.querySelectorAll<HTMLElement>('[data-story-step]') ?? [])];
    if (story && storyPhone && storySteps.length > 0) {
      const show = (step: HTMLElement) => {
        storyPhone.dataset.step = step.dataset.storyStep ?? '4';
        for (const item of storySteps) item.classList.toggle('is-on', item === step);
      };
      story.classList.add('is-live');
      show(storySteps[0]!);
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) if (entry.isIntersecting) show(entry.target as HTMLElement);
        },
        // On a phone the phone itself holds the top half of the screen, so a
        // step counts once it is readable below it.
        { rootMargin: matchMedia('(min-width: 900px)').matches ? '-45% 0px -45% 0px' : '-66% 0px -24% 0px' },
      );
      for (const step of storySteps) io.observe(step);
    }

    // Before and after: the range input's value is how far the divider sits
    // from the start side, and the clip and the line follow it.
    const compare = document.querySelector<HTMLElement>('[data-compare]');
    const range = compare?.querySelector<HTMLInputElement>('.hm-compare-range');
    if (compare && range) {
      const follow = () => compare.style.setProperty('--split', `${range.value}%`);
      range.addEventListener('input', follow);
      follow();
    }

    // The race clock: counts to 4:00 the first time it scrolls into view.
    // A reader who arrives with it already on screen sees the result.
    const race = document.querySelector<HTMLElement>('[data-race]');
    const clock = race?.querySelector<HTMLElement>('[data-clock]');
    const steps = [...(race?.querySelectorAll<HTMLElement>('[data-race-steps] li') ?? [])];
    if (race && clock && !still && race.getBoundingClientRect().top > innerHeight) {
      const END = 240;
      const paint = (seconds: number) => {
        clock.textContent = `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
        steps.forEach((li, i) => li.classList.toggle('is-done', seconds >= (END / steps.length) * (i + 0.6)));
      };
      paint(0);
      const io = new IntersectionObserver(([entry]) => {
        if (!entry?.isIntersecting) return;
        io.disconnect();
        const start = performance.now();
        const tick = (now: number) => {
          const seconds = Math.min(END, Math.round(((now - start) / 3200) * END));
          paint(seconds);
          if (seconds < END) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }, { threshold: 0.5 });
      io.observe(race);
    }
  </script>
