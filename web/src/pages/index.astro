---
import { t } from '../lib/i18n';
import { toCells } from '../lib/facts';
import { perUnitPrice } from '../lib/price';
import { ogDescription, ogTitle } from '../lib/og';
import { CATEGORY_PRESENTATION } from '../lib/category-presentation';
import { HERO_WIDTHS, largest } from '../lib/images';
import MiniScreen from '../components/MiniScreen.astro';
import BrandMark from '../components/BrandMark.astro';
import Prose from '../components/Prose.astro';
import PriceTiers from '../components/PriceTiers.astro';
import SectionLabel from '../components/SectionLabel.astro';
import WalkMinutes from '../components/WalkMinutes.astro';
import { TEMPLATE_IDS } from '@/types/listing';
import { ACCENTS } from '@/features/agents/accents';
import { propertyListing, vehicleListing, withNamedRooms } from '../lib/listings';
import '../styles/tokens.css';

/**
 * The homepage.
 *
 * REWRITTEN 11 September 2026 for the pivot. The previous version sold the
 * enrichment layer: three provenance states shown as worked examples, copy
 * about what is verified and what the seller declared, a section arguing that
 * what we do not know we do not write.
 *
 * That was a faithful rendering of CLAUDE.md §1 — "the moat is the data, not
 * the page" — and the market said otherwise. An agent does not want validated
 * data. They want a page that looks professional and a link they can send
 * before the viewing ends. The doctrine has been updated to match rather than
 * left to contradict the product; see CLAUDE.md §1 and docs/PRODUCT.md.
 *
 * WHAT THAT CHANGES HERE. The provenance section is gone. The centrepiece is
 * now the thing an agent is actually choosing between: the SAME listing
 * rendered in all three templates, side by side. "A few options, all of them
 * professional" is the offer, and three screens make it in less time than a
 * sentence about it would take to read.
 *
 * THE SCREENS ARE STILL COMPOSED FROM REAL DATA. `propertyListing` comes from
 * the module `/a/{slug}` renders, through the same `toCells`, `ils` and
 * `perUnitPrice` the real pages use. The palettes below mirror the template
 * layer in BaseListing.astro. Those are two copies of the same eight colours
 * and they can drift — the reason it is a copy rather than an import is that
 * BaseListing's tokens are scoped to a whole document, and this page needs
 * three of them side by side inside one. If a fourth template is added, both
 * places need it.
 *
 * THE VALUE RHYTHM stays dark → light → tinted → dark, which is what the
 * listing page does on its own. The scene has not changed: an agent on a
 * phone, between viewings, in sunlight, where a plaster-on-plaster hierarchy
 * collapses to one flat sheet.
 */

const cells = toCells('property', propertyListing.facts).slice(0, 3);
const perUnit = perUnitPrice('property', propertyListing.facts, propertyListing.price);
const propertyShowcase = withNamedRooms(propertyListing);
const propertyEnrich = propertyListing.enrichment?.category === 'property'
  ? propertyListing.enrichment
  : undefined;
const sampleSchool = propertyEnrich?.schools[0];
const sampleBus = propertyEnrich?.transit.find((item) => item.mode === 'bus');
const sampleGrocery = propertyEnrich?.summary.nearestGrocery;
const odblLine = propertyEnrich?.attributions[0] ?? t('legal.odbl');

/*
  The WhatsApp card, built by the SAME two functions the real one is.
  `ogTitle` and `ogDescription` are what BaseListing writes into the meta tags,
  so the card shown on the homepage cannot promise a shape the product does not
  produce. The image is the demo listing's own cover.
*/
const cardTitle = ogTitle(propertyShowcase);
const cardFacts = ogDescription(
  propertyShowcase,
  CATEGORY_PRESENTATION.property.ogFactKeys,
);
const cardImage = largest(propertyShowcase.media.cover, HERO_WIDTHS);

const title = `${t('common.brand')} — ${t('home.tagline')}`;
const canonical = new URL('/', Astro.site).href;
const ogImage = new URL('/og-home.webp', Astro.site).href;
---

<!DOCTYPE html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FBFAF7" />

    <title>{title}</title>
    <meta name="description" content={t('home.subTagline')} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={t('common.brand')} />
    <meta property="og:title" content={t('common.brand')} />
    <meta property="og:description" content={t('home.subTagline')} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;500;700;900&family=Assistant:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      :root {
        --display: var(--t-display);
        --lead: var(--t-lead);
        --heading: var(--t-heading);
        --body: var(--t-body);
        --meta: var(--t-meta);

        --gutter: clamp(1.25rem, 5vw, 3rem);
        --rule: 1px solid var(--stone);
        --rule-dark: 1px solid rgba(251, 250, 247, 0.14);
        --dim: #9c9d93;
      }

      html {
        background: var(--plaster);
        color-scheme: light;
        touch-action: manipulation;
        -webkit-tap-highlight-color: rgba(74, 93, 58, 0.18);
      }

      body {
        font-family: 'Assistant', system-ui, sans-serif;
        background: var(--plaster);
        color: var(--ink);
        font-size: var(--body);
        /* Hebrew has no ascenders or descenders to separate its lines. */
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
      }

      ::selection {
        background: var(--olive);
        color: var(--plaster);
      }

      :focus-visible {
        outline: 2px solid var(--olive);
        outline-offset: 3px;
      }

      .dark :focus-visible {
        outline-color: var(--on-dark);
      }

      .shell {
        max-inline-size: 1120px;
        margin-inline: auto;
        padding-inline: var(--gutter);
      }

      /*
        THE DARK SECTIONS HAVE A GROUND, not a flat fill.
        The verdict on the first version was "empty, no background", and it was
        right: #111208 edge to edge is a void, and in the sunlight this page is
        read in it flattens completely. Two soft radials off-centre give it a
        light source, and a hairline grid gives the eye something to measure
        the depth against. Both are cheap — no image, no blur filter, no
        element. They are painted by the background property itself.
      */
      .dark {
        position: relative;
        background:
          radial-gradient(120% 90% at 82% 8%, rgba(126, 154, 98, 0.16), transparent 60%),
          radial-gradient(90% 70% at 10% 95%, rgba(126, 154, 98, 0.09), transparent 62%),
          var(--ink-deep);
        color: var(--on-dark);
      }

      .dark > * {
        position: relative;
      }

      /* The light band gets the quieter half of the same idea, so the page does
         not go from textured to blank at the fold. */
      .lit {
        background:
          radial-gradient(95% 70% at 78% 0%, rgba(74, 93, 58, 0.06), transparent 58%),
          var(--plaster);
      }

      h1,
      h2,
      h3 {
        font-family: 'Frank Ruhl Libre', serif;
        text-wrap: balance;
      }

      /* Hebrew takes no positive tracking and its counters close up past
         -.015em. That is the floor, not a preference. */
      h1 {
        font-weight: 900;
        font-size: var(--display);
        line-height: 1.04;
        letter-spacing: -0.015em;
        overflow-wrap: break-word;
      }

      h2 {
        font-weight: 700;
        font-size: var(--heading);
        line-height: 1.15;
        letter-spacing: -0.01em;
      }

      /* ---------- Masthead ---------- */

      .top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-block: 1.35rem;
      }

      .mark {
        font-family: 'Frank Ruhl Libre', serif;
        font-weight: 700;
        font-size: 1.4rem;
        letter-spacing: -0.01em;
      }

      .top .brand-mark {
        color: inherit;
      }

      .top nav {
        display: flex;
        align-items: center;
        gap: 1.1rem;
      }

      .top-link {
        display: inline-flex;
        align-items: center;
        min-block-size: 44px;
        font-size: var(--meta);
        font-weight: 800;
        /* 6.94:1 on --ink-deep. --olive-lift is 3.83:1 and fails here. */
        color: var(--dim);
        text-decoration: none;
      }

      /* Default show sign-in; the session script hides it after a login.
         Flex would otherwise keep the hidden link in the row. */
      .top nav [hidden] {
        display: none !important;
      }

        .lit .top-link {
          color: var(--muted);
        }
        .lit .top-link:hover {
          color: var(--ink);
        }
        .lit .hero-sub,
        .lit .hero-lead,
        .lit .actions-note {
          color: var(--muted);
        }

      /* ---------- Hero ----------
         In RTL the grid fills from the right, so the first child lands where a
         Hebrew reader starts. Nothing computes that; dir="rtl" does. */

      .hero {
        display: grid;
        gap: clamp(2rem, 4vw, 3rem);
        padding-block: clamp(2.25rem, 4.5vw, 3.25rem) clamp(2.25rem, 4.5vw, 3.25rem);
      }

      /*
        WIDER PHONE, TIGHTER SHELL.
        The stage column was capped at 330px and the copy at 32rem, which on a
        1280px screen left a column of nothing between them and a band of
        nothing under both — the "empty, a lot of blank spaces" the homepage
        was reported for. The two columns now claim the width they are given.
      */
      @media (min-width: 1000px) {
        .hero {
          grid-template-columns: minmax(0, 1fr) minmax(300px, 25rem);
          align-items: center;
          gap: clamp(2rem, 4vw, 3.5rem);
        }
      }

      .hero-copy {
        max-inline-size: 34rem;
      }

      .hero-sub {
        font-size: var(--lead);
        color: var(--dim);
        margin-block-start: 1.1rem;
        max-inline-size: 26ch;
        text-wrap: balance;
      }

      .hero-lead {
        margin-block-start: 1.5rem;
        max-inline-size: 46ch;
        color: rgba(251, 250, 247, 0.86);
      }

      .actions {
        display: flex;
        align-items: center;
        gap: 1.1rem;
        flex-wrap: wrap;
        margin-block-start: 2rem;
      }

      /*
        BOLDER, because they were not bold enough and that was the note.
        Three changes, and the weight is the one that mattered: Assistant goes
        to 800 and the page was only loading 700, so the button was asking for
        a weight the browser had to fake by not faking it.

        Then size — 1.15rem and a taller box — and a shadow tinted with the
        accent rather than with black, so the button reads as sitting on the
        page rather than cut out of it.
      */
      .cta {
        display: inline-block;
        padding: 1.1rem 2.6rem;
        background: var(--olive);
        color: var(--plaster);
        font-size: 1.15rem;
        font-weight: 800;
        letter-spacing: -0.01em;
        border: none;
        border-radius: 6px;
        text-decoration: none;
        box-shadow: 0 10px 24px -12px rgba(74, 93, 58, 0.9);
        transition:
          transform var(--press) var(--ease-out),
          box-shadow var(--press) var(--ease-out),
          background var(--press) var(--ease-out);
      }

      .cta:hover {
        background: var(--olive-lift);
        transform: scale(0.99);
        box-shadow: 0 14px 30px -12px rgba(74, 93, 58, 1);
      }

      /* 100–160ms is the band where a press reads as physical. */
      .cta:active {
        transform: scale(0.97);
        box-shadow: 0 4px 12px -8px rgba(74, 93, 58, 0.9);
      }

      .actions-note {
        font-size: var(--meta);
        color: var(--dim);
        max-inline-size: 22ch;
      }

      /* ---------- Device screens ----------
         Composed from the real listing data through the real formatters, so
         they cannot drift from the product. */

      /*
        One grid cell, three screens stacked in it. Grid rather than absolute
        positioning so the container still sizes to the tallest — nothing has
        to be measured and there is no fixed height to get wrong.
      */
      /*
        A PHONE-SHAPED WINDOW, and the shape is the fix.

        The five templates are genuinely different heights — that is what they
        are for — and this cell was auto-sized to the TALLEST while showing
        whichever one the cycle had reached. On a phone that left 296px of bare
        dark ground under the shortest of them: a third of the screen, directly
        below the headline, which reads as a page that failed to load. It is
        most of what "the homepage looks empty" was about.

        An aspect-ratio rather than a fixed height, so one rule holds at every
        width and the window is the same shape on a phone as on a desktop.
        `grid-template-rows` is the half that actually constrains it: a grid
        ROW is sized by its content regardless of the container's height, so
        without this the screens overflowed a 480px stage at 715px tall and
        nothing appeared to change.
      */
      .stage {
        display: grid;
        grid-template-rows: minmax(0, 1fr);
        justify-items: center;
        inline-size: 100%;
        aspect-ratio: 1 / 1.3;
        max-block-size: 70vh;
        overflow: hidden;
      }

      /* The screen takes the window's height and the caption keeps its own, so
         the five captions still sit on one line as they did. */
      .stage > .device {
        block-size: 100%;
        min-block-size: 0;
        grid-template-rows: minmax(0, 1fr) auto;
      }

      .stage .screen {
        block-size: 100%;
        min-block-size: 0;
        /* The crop, and the fade that admits to it: a listing page continues
           past the fold, and this says so instead of ending in a hard line. */
        mask-image: linear-gradient(to bottom, #000 86%, transparent 100%);
      }

      .stage > .device {
        grid-area: 1 / 1;
        /* Each screen hangs from the top of the cell rather than stretching to
           fill it: a stretched miniature is a listing page with its type in
           the wrong place. */
        align-content: start;
        /* A grid item under justify-items:center sizes to its CONTENT, and the
           content is a screen at inline-size:100% — which resolves against the
           item, which has no width yet. That circularity collapsed all three
           screens to zero. An explicit width breaks it. */
        inline-size: 100%;
      }

      /*
        The two screens SPLIT whatever width they are given rather than each
        claiming a width from the viewport. Flexing from a zero basis cannot
        overflow, because the basis is the space that actually exists — and a
        vw-based clamp has a floor problem below about 340px where the two
        minimums plus the gap exceed the shell.

        The type then follows a width only flex knows, which is what
        container-type is for: 6.25cqi is a sixteenth of the device's resolved
        width, so the screen scales as one object instead of shrinking its box
        while its type stays put.
      */
      .device {
        flex: 1 1 0;
        max-inline-size: 300px;
        min-inline-size: 140px;
        container-type: inline-size;
        display: grid;
        gap: 0.6rem;
        justify-items: center;
        text-decoration: none;
        color: inherit;
      }

      .screen {
        display: block;
        text-decoration: none;
        color: var(--s-ink);
        font-size: 6.25cqi;
        inline-size: 100%;
        border-radius: 1em;
        overflow: hidden;
        background: var(--s-ground);
        line-height: 1.5;
        box-shadow:
          0 0 0 1px rgba(251, 250, 247, 0.12),
          0 1.4em 3em -1em rgba(0, 0, 0, 0.55);
      }

      /*
        THE THREE PALETTES, mirroring the template layer in BaseListing.astro.
        Prefixed --s- because they style a miniature inside another document
        and must not collide with the page's own tokens.

        This IS a second copy of those colours. BaseListing's version is scoped
        to a whole document via [data-template] on <html>, and this page needs
        three of them side by side inside one document, so the values are
        repeated rather than imported. A fourth template needs both.
      */
      .device[data-tpl='editorial'] {
        --s-ground: #f3eee4;
        --s-ink: #191a15;
        --s-deep: #111208;
        --s-line: #e4e0d6;
        --s-warm: #f1ede3;
        --s-muted: #67685f;
        --s-accent: #2f5340;
        --s-lift: #6e9b80;
      }

      .device[data-tpl='agency'] {
        --s-ground: #ffffff;
        --s-ink: #191a15;
        --s-deep: #1c1917;
        --s-line: #e7e2da;
        --s-warm: #faf6f0;
        --s-muted: #6b6259;
        --s-accent: #4a5d3a;
        --s-lift: #7e9a62;
      }

      .device[data-tpl='dark'] {
        --s-ground: #14150f;
        --s-ink: #f3f1ea;
        --s-deep: #0a0b06;
        --s-line: #2c2e24;
        --s-warm: #1d1f16;
        --s-muted: #a3a498;
        --s-accent: #c7a24e;
        --s-lift: #c7a24e;
      }

      .device[data-tpl='walkFirst'] {
        --s-ground: #fbfaf7;
        --s-ink: #191a15;
        --s-deep: #111208;
        --s-line: #e4e0d6;
        --s-warm: #f1ede3;
        --s-muted: #67685f;
        --s-accent: #8c4a2f;
        --s-lift: #c17a55;
      }

      .device[data-tpl='brochure'] {
        --s-ground: #f7f1e4;
        --s-ink: #191a15;
        --s-deep: #111208;
        --s-line: #e4e0d6;
        --s-warm: #f1ede3;
        --s-muted: #67685f;
        --s-accent: #6e2639;
        --s-lift: #b06b80;
      }

      .device[data-tpl='linen'] {
        --s-ground: #f4e6cf;
        --s-ink: #2a1d12;
        --s-deep: #23180f;
        --s-line: #e2ccab;
        --s-warm: #efe0c4;
        --s-muted: #6d5844;
        --s-accent: #8c4a2f;
        --s-lift: #c17a55;
      }

      .device[data-tpl='studio'] {
        --s-ground: #f7f3ea;
        --s-ink: #1a1916;
        --s-deep: #141310;
        --s-line: #d9d2c4;
        --s-warm: #ece6d8;
        --s-muted: #67685f;
        --s-accent: #3a3a34;
        --s-lift: #9a9a90;
      }

      .s-agent {
        display: flex;
        align-items: center;
        gap: 0.4em;
        padding: 0.5em 0.7em;
        background: var(--s-deep);
        /* Never --s-ink: on the dark template that is the light ground, and
           this strip is dark in all three. The same trap BaseListing hit. */
        color: #fbfaf7;
        font-size: 0.55em;
      }

      .s-agent .dot {
        inline-size: 1.6em;
        block-size: 1.6em;
        border-radius: 50%;
        background: var(--s-lift);
        flex: 0 0 auto;
      }

      .s-agent .who {
        font-weight: 600;
      }

      .s-agent .brand {
        margin-inline-start: auto;
        color: #9c9d93;
      }

      /*
        The miniature is built from <span>s, not <div>s: the hero device wraps
        the whole screen in one element and nesting flow content inside it was
        not worth the argument. The cost is that every structural piece has to
        be told it is a block — an inline element ignores aspect-ratio, which
        clipped the price, the facts and the button off the bottom of all four
        screens. Caught on the running page.
      */
      .s-veil,
      .s-place,
      .s-title,
      .s-fact-val,
      .s-fact-lbl,
      .s-price,
      .s-price-note,
      .s-cta,
      .s-walk,
      .s-walk-film,
      .s-chips,
      .s-chip {
        display: block;
      }

      .s-hero {
        display: block;
        position: relative;
        aspect-ratio: 4 / 5;
        overflow: hidden;
        background: var(--s-line);
      }

      .s-hero img {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
        display: block;
      }

      .s-veil {
        position: absolute;
        inset-inline: 0;
        inset-block-end: 0;
        padding: 2.4em 0.75em 0.7em;
        background: linear-gradient(
          to top,
          rgba(17, 18, 8, 0.9) 12%,
          rgba(17, 18, 8, 0.55) 48%,
          transparent
        );
        color: #fbfaf7;
      }

      .s-place {
        font-size: 0.5em;
        opacity: 0.88;
      }

      .s-title {
        font-family: 'Frank Ruhl Libre', serif;
        font-weight: 900;
        font-size: 0.95em;
        line-height: 1.05;
        letter-spacing: -0.015em;
        margin-block-start: 0.15em;
        overflow-wrap: anywhere;
        max-inline-size: 100%;
      }

      .s-price-bar {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 0.5em;
        padding: 0.8em 0.75em 0.7em;
      }

      .s-price {
        font-family: 'Frank Ruhl Libre', serif;
        font-weight: 700;
        font-size: 1.15em;
        line-height: 1;
        letter-spacing: -0.02em;
        font-variant-numeric: tabular-nums;
      }

      .s-price-note {
        font-size: 0.48em;
        color: var(--s-muted);
        text-align: end;
        padding-block-end: 0.2em;
      }

      .s-facts {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1px;
        background: var(--s-line);
        border-block-start: 1px solid var(--s-line);
      }

      .s-fact {
        background: var(--s-ground);
        padding: 0.6em 0.3em 0.7em;
        text-align: center;
        /* The agency template cards its cells; mirrored so the miniature
           shows the structural difference and not only the colour one. */
        min-block-size: 3.6em;
      }

      /* Agency: a shorter photograph, a filled price band, and facts as a
         labelled two-column list. The same three moves the real template
         makes — see BaseListing. Without them these read as one design in
         three colours, which was the verdict on the first version. */
      .device[data-tpl='agency'] .s-hero {
        aspect-ratio: 4 / 3;
      }

      .device[data-tpl='agency'] .s-price-bar {
        background: var(--s-warm);
        border-block-end: 1px solid var(--s-line);
        align-items: center;
      }

      .device[data-tpl='agency'] .s-facts {
        grid-template-columns: repeat(2, 1fr);
        gap: 0.3em;
        background: transparent;
        border-block-start: 0;
        padding: 0.35em;
      }

      .device[data-tpl='agency'] .s-fact {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.3em;
        text-align: start;
        padding: 0.4em 0.5em;
        border: 1px solid var(--s-line);
        border-radius: 0.45em;
        min-block-size: 0;
      }

      .device[data-tpl='agency'] .s-fact-val {
        font-size: 0.62em;
        order: 2;
      }

      .device[data-tpl='agency'] .s-fact-lbl {
        margin-block-start: 0;
        order: 1;
      }

      /* Dark: the photograph takes more of the screen and the facts lose their
         cells entirely — three bare numbers with a hairline between. */
      .device[data-tpl='dark'] .s-hero {
        aspect-ratio: 3 / 5;
      }

      .device[data-tpl='dark'] .s-facts {
        gap: 0;
        background: transparent;
        border-block-start: 1px solid var(--s-line);
      }

      .device[data-tpl='dark'] .s-fact {
        background: transparent;
      }

      .device[data-tpl='dark'] .s-fact + .s-fact {
        border-inline-start: 1px solid var(--s-line);
      }

      .s-fact.off {
        background: var(--s-warm);
      }

      .s-fact-val {
        font-family: 'Frank Ruhl Libre', serif;
        font-weight: 500;
        font-size: 0.8em;
        line-height: 1.1;
        font-variant-numeric: tabular-nums;
      }

      .s-fact-lbl {
        font-size: 0.44em;
        color: var(--s-muted);
        margin-block-start: 0.2em;
      }

      .s-cta {
        margin: 0.55em 0.7em 0.8em;
        padding: 0.55em;
        text-align: center;
        font-size: 0.52em;
        font-weight: 700;
        border-radius: 0.4em;
        background: var(--s-accent);
        color: #fbfaf7;
      }

      /* On the dark template the accent is pale, so a pale fill with pale type
         would vanish. The button inverts — the only element that does. */
      .device[data-tpl='dark'] .s-cta {
        background: var(--s-ink);
        color: var(--s-ground);
      }

      /* Walk-first: the filmstrip is the page. Room chips name the stills;
         facts and the WhatsApp pill wait below the fold on the real listing. */
      .device[data-tpl='walkFirst'] .s-walk {
        display: grid;
        grid-template-columns: 2.15em minmax(0, 1fr);
        gap: 0.28em;
        padding: 0.32em;
        background: var(--s-deep);
      }

      .device[data-tpl='walkFirst'] .s-walk-film {
        display: flex;
        flex-direction: column;
        gap: 0.18em;
      }

      .device[data-tpl='walkFirst'] .s-walk-film img {
        display: block;
        inline-size: 100%;
        aspect-ratio: 1;
        object-fit: cover;
        border-radius: 0.12em;
      }

      .device[data-tpl='walkFirst'] .s-hero {
        aspect-ratio: 3 / 4;
      }

      .device[data-tpl='walkFirst'] .s-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.22em;
        padding: 0.4em 0.55em 0.1em;
      }

      .device[data-tpl='walkFirst'] .s-chip {
        font-size: 0.58em;
        font-weight: 700;
        padding: 0.22em 0.55em;
        border-radius: 999px;
        background: var(--s-deep);
        color: #fbfaf7;
      }

      .device[data-tpl='walkFirst'] .s-facts,
      .device[data-tpl='walkFirst'] .s-cta {
        display: none;
      }

      .device[data-tpl='walkFirst'] .s-price-bar {
        padding-block: 0.5em 0.65em;
      }

      /* Brochure: one photograph owns the screen; facts are a caption. */
      .device[data-tpl='brochure'] .s-hero {
        aspect-ratio: 3 / 5;
      }

      .device[data-tpl='brochure'] .s-title {
        font-size: 1.05em;
        font-weight: 700;
      }

      .device[data-tpl='brochure'] .s-facts {
        display: flex;
        background: transparent;
        border-block-start: 0;
        gap: 0;
        padding-inline: 0.2em;
      }

      .device[data-tpl='brochure'] .s-fact {
        flex: 1 1 0;
        background: transparent;
        min-block-size: 0;
        padding: 0.45em 0.15em 0.5em;
      }

      .device[data-tpl='brochure'] .s-cta {
        display: none;
      }

      .device[data-tpl='linen'] .s-hero {
        aspect-ratio: 4 / 5;
      }

      .device[data-tpl='linen'] .s-title {
        font-size: 1.05em;
        font-weight: 700;
      }

      .device[data-tpl='linen'] .s-price {
        color: var(--s-accent);
      }

      .device[data-tpl='linen'] .s-facts {
        grid-template-columns: 1fr 1fr;
        gap: 0.28em;
        background: transparent;
        padding: 0.35em;
      }

      .device[data-tpl='linen'] .s-fact {
        background: var(--s-warm);
        border-radius: 0.45em;
        text-align: start;
        min-block-size: 0;
        padding: 0.45em 0.5em;
      }

      .device[data-tpl='studio'] .s-hero {
        aspect-ratio: 1;
        margin: 0.4em;
        border-radius: 0.55em;
        overflow: hidden;
      }

      .device[data-tpl='studio'] .s-price-bar {
        border-inline-start: 0.28em solid var(--s-accent);
        margin-inline: 0.5em;
        padding-inline-start: 0.55em;
      }

      .device[data-tpl='studio'] .s-facts {
        display: flex;
        flex-wrap: wrap;
        gap: 0.22em;
        background: transparent;
        border-block-start: 0;
        padding: 0.35em 0.5em 0.6em;
      }

      .device[data-tpl='studio'] .s-fact {
        background: var(--s-deep);
        color: #fbfaf7;
        border-radius: 999px;
        min-block-size: 0;
        padding: 0.28em 0.55em;
      }

      .device[data-tpl='studio'] .s-fact-lbl {
        color: rgba(251, 250, 247, 0.7);
      }

      .device-label {
        font-size: var(--meta);
        font-weight: 600;
        color: var(--muted);
      }

      .dark .device-label {
        color: var(--dim);
      }

      /* ---------- Section furniture ----------
         More space above a heading than below it: the heading belongs to what
         follows, and even spacing leaves it floating between two blocks. */

      /* Tightened from 5rem. Six sections each holding a screen of padding is
         how a page with plenty in it reads as sparse. */
      section > .shell {
        padding-block: clamp(2.75rem, 5vw, 4rem);
      }

      .section-head {
        max-inline-size: 36rem;
        margin-block-end: clamp(2rem, 3.5vw, 2.75rem);
      }

      .section-head p {
        margin-block-start: 0.85rem;
        color: var(--muted);
        max-inline-size: 60ch;
        text-wrap: pretty;
      }

      .dark .section-head p {
        color: rgba(251, 250, 247, 0.84);
      }

      /* ---------- Templates ---------- */

      /*
        Stretch, not flex-start. The three templates are now genuinely
        different heights — that is the point of them — but their LABELS were
        floating at three different heights, which read as broken rather than
        as deliberate. Stretching the wrapper and pushing the label to the
        bottom keeps the screens honest and the captions on one line.
      */
      .tpl-row {
        display: flex;
        flex-wrap: wrap;
        gap: clamp(0.85rem, 2.2vw, 1.75rem);
        align-items: stretch;
        justify-content: center;
        inline-size: 100%;
      }

      @media (max-width: 719px) {
        .tpl-row {
          flex-wrap: nowrap;
          justify-content: start;
          overflow-x: auto;
          overscroll-behavior-inline: contain;
          scroll-snap-type: inline mandatory;
          padding-block-end: 0.4rem;
        }
        .tpl-row .device {
          flex: 0 0 10.75rem;
          max-inline-size: none;
          min-inline-size: 10.75rem;
          scroll-snap-align: start;
        }
      }

      .tpl-row .device {
        grid-template-rows: auto 1fr;
        flex: 1 1 9.25rem;
        max-inline-size: 13.75rem;
        min-inline-size: 8.25rem;
      }

      .tpl-row .device[data-tpl='dark'] {
        max-inline-size: 14.5rem;
      }

      .tpl-row .device[data-tpl='walkFirst'] {
        max-inline-size: 15rem;
      }

      .tpl-row .device[data-tpl='brochure'] {
        max-inline-size: 12rem;
      }

      .tpl-row .device-label,
      .cycle-name {
        align-self: end;
      }

      .cycle-name {
        font-size: var(--meta);
        font-weight: 600;
        color: var(--dim);
      }

      /* ---------- The WhatsApp card ----------
         A thread, not a screenshot: the bubble is built from the same markup
         the real card's metadata describes, so it stays true by construction
         and costs no image. */

      .link-grid {
        display: grid;
        gap: clamp(2rem, 4vw, 3rem);
        align-items: center;
      }

      @media (min-width: 900px) {
        .link-grid {
          grid-template-columns: minmax(0, 1fr) minmax(280px, 26rem);
        }
      }

      /* The chat ground. Muted on purpose — the card is the subject and a
         saturated green would make the mock the subject instead. */
      .thread {
        padding: clamp(1rem, 2.5vw, 1.5rem);
        background: var(--stone-warm);
        border: var(--rule);
        border-radius: 10px;
      }

      .bubble {
        max-inline-size: 22rem;
        /* Outgoing: the inline end of the thread. In Hebrew that is the left,
           and nothing here has to know that. */
        margin-inline-start: auto;
        padding: 0.4rem;
        background: #e7f3d8;
        border-radius: 10px 10px 4px 10px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12);
      }

      .card {
        background: var(--plaster);
        border-radius: 6px;
        overflow: hidden;
      }

      .card img {
        display: block;
        inline-size: 100%;
        /* The card is 1200x630 and WhatsApp crops nothing (§6). */
        aspect-ratio: 1200 / 630;
        /* NOT redundant. The element carries width/height attributes for the
           no-CSS case, and the height one is a presentational hint that beats
           `aspect-ratio` unless the height is explicitly released — which
           rendered the preview 630px tall and three times too deep. */
        block-size: auto;
        object-fit: cover;
      }

      .card-text {
        display: grid;
        gap: 0.15rem;
        padding: 0.5rem 0.6rem 0.6rem;
        line-height: 1.45;
      }

      .card-text strong {
        font-size: 0.9rem;
        font-weight: 700;
      }

      .card-text span {
        font-size: 0.78rem;
        color: var(--muted);
      }

      .card-text em {
        font-style: normal;
        font-size: 0.7rem;
        color: var(--muted);
      }

      .bubble-link {
        display: block;
        padding: 0.4rem 0.3rem 0.15rem;
        font-size: 0.78rem;
        color: #2c5a8a;
        text-decoration: underline;
        text-underline-offset: 2px;
        overflow-wrap: anywhere;
      }

      .thread-note {
        margin-block-start: 0.8rem;
        font-size: var(--meta);
        color: var(--muted);
        text-align: center;
      }

      /* ---------- Steps ----------
         A real sequence, so the numerals carry information rather than
         decorating a heading. */

      .steps-band {
        background: var(--stone-warm);
        border-block: var(--rule);
        /* --muted is 4.87:1 on plaster and 4.35:1 on this tinted ground.
           Carried down until it clears AA. */
        --muted: #67685f;
      }

      .steps {
        display: grid;
        gap: clamp(1.6rem, 3vw, 2.5rem);
        list-style: none;
        counter-reset: step;
        padding: 0;
        margin: 0;
      }

      @media (min-width: 760px) {
        .steps {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      .steps li {
        counter-increment: step;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 0 0.9rem;
        align-items: baseline;
        padding-block-start: 1rem;
        border-block-start: 1px solid var(--stone);
      }

      .steps li::before {
        content: counter(step);
        grid-row: span 2;
        font-family: 'Frank Ruhl Libre', serif;
        font-weight: 700;
        font-size: 1.9rem;
        line-height: 1;
        color: var(--ink);
        font-variant-numeric: tabular-nums;
      }

      .steps h3 {
        font-size: 1.1rem;
        font-weight: 700;
        line-height: 1.3;
      }

      .steps p {
        grid-column: 2;
        color: var(--muted);
        margin-block-start: 0.3rem;
        text-wrap: pretty;
      }

      /* ---------- Dashboard ---------- */

      .dash-grid {
        display: grid;
        gap: clamp(2rem, 4vw, 3.25rem);
        align-items: center;
      }

      @media (min-width: 900px) {
        .dash-grid {
          grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
        }
      }

      .dash-shot {
        border: var(--rule-dark);
        border-radius: 8px;
        overflow: hidden;
        background: var(--plaster);
        box-shadow: 0 1.2rem 3rem -1.2rem rgba(0, 0, 0, 0.7);
      }

      .dash-shot-bar {
        background: var(--ink-deep);
        padding: 0.5rem 0.7rem;
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--on-dark);
        font-family: 'Frank Ruhl Libre', serif;
      }

      .dash-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.4rem;
        padding: 0.55rem;
      }

      .dash-card {
        border: 1px solid var(--stone);
        border-radius: 4px;
        overflow: hidden;
        background: var(--plaster);
      }

      .dash-card img {
        inline-size: 100%;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        display: block;
      }

      .dash-card .none {
        aspect-ratio: 16 / 10;
        background: var(--stone-warm);
      }

      .dash-card span {
        display: block;
        padding: 0.3rem 0.4rem 0.45rem;
        font-size: 0.58rem;
        font-weight: 700;
        color: var(--ink);
      }

      .dash-card em {
        display: block;
        font-style: normal;
        font-size: 0.52rem;
        font-weight: 600;
        color: var(--plaster);
        background: var(--olive);
        padding: 0.04rem 0.3rem;
        border-radius: 2px;
        inline-size: fit-content;
        margin: 0 0.4rem 0.4rem;
      }

      /* ---------- Closing ---------- */

      .closing .shell {
        display: grid;
        gap: 1.25rem;
        justify-items: center;
        text-align: center;
        padding-block: clamp(3.5rem, 7vw, 5.5rem);
      }

      .closing h2 {
        max-inline-size: 18ch;
      }

      footer {
        border-block-start: var(--rule);
      }

      footer .shell {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        padding-block: 1.75rem;
        font-size: var(--meta);
        color: var(--muted);
      }

      footer a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-block-size: 44px;
        min-inline-size: 44px;
        color: var(--muted);
        text-underline-offset: 3px;
      }

      footer a:hover {
        color: var(--olive);
      }

      .hero-title {
        font-family: 'Frank Ruhl Libre', serif;
        font-weight: 700;
        font-size: var(--display);
        line-height: 1.08;
        letter-spacing: -0.03em;
      }
      .hero-line {
        display: block;
        overflow: hidden;
      }
      .hero-line > span {
        display: block;
      }
      .phone {
        inline-size: min(100%, 320px);
        margin-inline: auto;
        padding: 0.7rem;
        background: #1a1b16;
        border-radius: 28px;
        box-shadow: 0 24px 50px -24px rgba(0, 0, 0, 0.55);
        container-type: inline-size;
      }
      .phone .stage {
        aspect-ratio: 9 / 16;
        max-block-size: none;
        inline-size: 100%;
        --n: 7;
      }
      .phone .device {
        max-inline-size: none;
        min-inline-size: 0;
        gap: 0;
      }
      .phone .screen {
        display: block;
        overflow: hidden;
        border-radius: 20px;
        background: var(--s-ground, var(--plaster));
        box-shadow: none;
      }
      .phone-caption {
        margin-block-start: 0.7rem;
        text-align: center;
        color: var(--dim);
        font-size: var(--meta);
      }

      .proof-track {
        display: grid;
        gap: 0;
      }
      .proof-chapter {
        min-block-size: 85svh;
      }
      .proof-sticky {
        position: sticky;
        inset-block-start: 0;
        padding-block: 2.5rem;
        background: var(--plaster);
      }
      .proof-sticky h3 {
        font-family: 'Frank Ruhl Libre', serif;
        font-size: var(--heading);
        margin-block: 0.35rem 0.4rem;
      }
      .proof-sticky p {
        color: var(--muted);
        max-inline-size: 46ch;
      }
      .proof-index {
        font-variant-numeric: tabular-nums;
        color: var(--olive);
        font-weight: 700;
      }

      .compare {
        position: relative;
        isolation: isolate;
        max-inline-size: 320px;
        margin-inline: auto;
        aspect-ratio: 9 / 16;
        background: var(--stone-warm);
        overflow: hidden;
        --split: 50%;
        container-type: inline-size;
      }
      .compare-layer {
        position: absolute;
        inset: 0;
      }
      .compare-dump {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2px;
        padding: 0.4rem;
        background: #d9d4c8;
      }
      .compare-dump img {
        inline-size: 100%;
        aspect-ratio: 1;
        object-fit: cover;
      }
      .compare-reveal {
        clip-path: inset(0 0 0 calc(100% - var(--split)));
      }
      .compare-reveal .device {
        max-inline-size: none;
        min-inline-size: 0;
        inline-size: 100%;
        gap: 0;
      }
      .compare-reveal .screen {
        border-radius: 0;
        box-shadow: none;
      }
      .compare input[type='range'] {
        position: absolute;
        inset-inline: 0.6rem;
        inset-block-end: 0.6rem;
        z-index: 2;
        inline-size: calc(100% - 1.2rem);
        min-block-size: 44px;
      }
      .compare-hint {
        color: var(--muted);
        font-size: var(--meta);
        margin-block-start: 0.7rem;
        max-inline-size: 46ch;
      }

      .around-list,
      .verified-list {
        list-style: none;
        padding: 0;
        margin: 1rem 0 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
        gap: 0.8rem;
      }
      .around-list li,
      .verified-list li {
        padding: 1.05rem 1.15rem;
        background: var(--stone-warm);
        border-radius: 16px;
        border-block-end: 0;
      }
      .around-list strong {
        font-family: 'Frank Ruhl Libre', serif;
        font-weight: 500;
        display: block;
        font-size: 1.05rem;
      }
      .around-walk {
        display: block;
        font-family: 'Frank Ruhl Libre', serif;
        font-weight: 700;
        font-size: 2rem;
        line-height: 1.1;
        color: var(--olive);
        margin-block-start: 0.35rem;
      }
      .cite {
        display: block;
        color: var(--muted);
        font-size: var(--meta);
        margin-block-start: 0.35rem;
      }
      .verified-list .verified {
        font-size: 0.62rem;
        font-weight: 600;
        color: var(--olive);
        border: 1px solid var(--olive);
        border-radius: 2px;
        padding: 0.02rem 0.28rem;
      }

      .palette-band {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
        gap: 0.7rem;
        margin-block-start: 1.2rem;
      }
      .palette-swatch {
        display: grid;
        gap: 0.45rem;
        padding: 0.9rem 0.85rem 1rem;
        border-radius: 16px;
        background: var(--stone-warm);
        text-decoration: none;
        color: inherit;
      }
      .palette-swatch .chip {
        display: block;
        inline-size: 2.4rem;
        block-size: 2.4rem;
        border-radius: 50%;
        background: var(--chip);
        box-shadow: 0 8px 18px -10px var(--chip);
      }
      .palette-swatch strong {
        font-size: 0.92rem;
      }

      /* ---------- Motion ----------
         ONE authored entrance, capped at three steps, and nothing below the
         fold animates. The content is visible by default — animation only ever
         moves something that would already be on screen without it, because a
         reveal gated on a transition ships blank in a headless renderer. */

      /*
        THE DEFAULT STATE IS VISIBLE. Every rule below only ever moves
        something that is already on the page — nothing here can leave the
        homepage blank in a headless renderer, a background tab, or a browser
        that drops the feature.

        Only the first cycling screen shows without motion, which is correct:
        the other two are the same listing in another palette, so no content is
        lost, and a reader who asked for less movement gets one still page.
      */
      .stage > .device + .device {
        opacity: 0;
      }

      @media (prefers-reduced-motion: no-preference) {
        .hero-copy,
        .hero .phone {
          animation: arrive 0.62s both cubic-bezier(0.16, 1, 0.3, 1);
        }

        .hero-line > span {
          animation: line-rise var(--dur-reveal) var(--ease-out) both;
        }
        .hero-line:nth-child(2) > span {
          animation-delay: 80ms;
        }
        @keyframes line-rise {
          from {
            transform: translateY(110%);
          }
          to {
            transform: none;
          }
        }

        .hero .stage {
          animation-delay: 0.1s;
        }

        @keyframes arrive {
          from {
            opacity: 0;
            transform: translateY(14px);
          }
        }

        /*
          The cycle. 22.5s for five screens is 4.5s each — long enough to read
          a price and short enough that a reader who arrived for the headline
          sees a second one before they scroll.

          The fade is 4% of the loop on each side, which is about 540ms: slower
          than a UI transition because this is a scene change, not a response
          to a press.
        */
        .stage > .device {
          animation: cycle calc(var(--n, 5) * 4.5s) calc(var(--i) * 4.5s) infinite both;
        }

        @keyframes cycle {
          0% {
            opacity: 0;
            transform: translateY(10px) scale(0.985);
          }
          3%,
          17% {
            opacity: 1;
            transform: none;
          }
          20%,
          100% {
            opacity: 0;
            transform: translateY(-10px) scale(0.985);
          }
        }

        /* A card lifts toward the reader on hover. Transform only — animating
           a layout property here would reflow the whole row. */
        .tpl-row .device {
          transition: transform 0.35s var(--ease-out);
        }

        .tpl-row .device:hover {
          transform: translateY(-6px);
        }
      }

      /*
        SCROLL-DRIVEN REVEALS, and every rule is inside BOTH wrappers.

        @supports is the feature detection: outside it the declaration is
        dropped and whatever opacity it was driving is left applied, which is
        how a third of a page goes invisible in a browser that cannot animate
        it back. The reduced-motion query is the other half.
        scripts/verify-motion-fallbacks.mjs asserts both against the BUILT
        stylesheet, because the nesting is the whole difference and it looks
        correct either way in review.
      */
      @media (prefers-reduced-motion: no-preference) {
        @supports (animation-timeline: view()) {
          .reveal {
            animation: rise linear both;
            animation-timeline: view();
            animation-range: entry 5% cover 26%;
          }

          .reveal:nth-child(2) {
            animation-range: entry 2% cover 28%;
          }

          .reveal:nth-child(3) {
            animation-range: entry 0% cover 30%;
          }

          @keyframes rise {
            from {
              opacity: 0;
              transform: translateY(26px);
            }
          }
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .hero-copy,
        .hero .phone {
          animation: fade 0.4s both;
        }
        .hero-line > span {
          animation: none;
        }
        .proof-sticky {
          position: static;
        }

        @keyframes fade {
          from {
            opacity: 0;
          }
        }

        .cta,
        .tpl-row .device {
          transition: none;
        }
      }
    </style>
  </head>

  <body>
    <a class="skip" href="#main">{t('a11y.skip')}</a>
    <main id="main">
    <div class="dark">
      <div class="shell">
        <header class="top">
          <BrandMark href="/" />
          <nav>
            {/* Logged out: only sign-in. Logged in: only my listings.
                The homepage is static, so sign-in is the default paint and
                a client script swaps after getSession. Both must never show. */}
            <a class="top-link" id="nav-enter" href="/enter/">{t('home.ctaSecond')}</a>
            <a class="top-link" id="nav-mine" href="/mine/" hidden>{t('dash.title')}</a>
          </nav>
        </header>
      </div>

      <div class="shell">
        <div class="hero">
          <div class="hero-copy">
            <h1 class="hero-title">
              <span class="hero-line"><span>{t('home.taglineLine1')}</span></span>
              <span class="hero-line"><span>{t('home.taglineLine2')}</span></span>
            </h1>
            <p class="hero-sub">{t('home.subTagline')}</p>
            <p class="hero-lead">{t('home.lead')}</p>

            <div class="actions">
              <a class="cta" href="/new/?fresh=1">{t('home.cta')}</a>
              <span class="actions-note">{t('home.ctaNote')}</span>
            </div>
          </div>

          <div class="phone">
            <div class="stage">
              {
                TEMPLATE_IDS.map((tpl, index) => (
                  <div class="device" data-tpl={tpl} style={`--i: ${index}`}>
                    <MiniScreen
                      listing={{ ...propertyShowcase, template: tpl }}
                      cells={cells}
                      perUnit={perUnit}
                      eager={index === 0}
                    />
                  </div>
                ))
              }
            </div>
            <p class="phone-caption">{t('home.phoneCaption')}</p>
          </div>
        </div>
      </div>
    </div>

    {/*
      The centrepiece. One listing, five templates — the offer made in less
      time than a sentence about it would take to read.
    */}
    <section>
      <div class="shell">
        <div class="section-head">
          <h2>{t('home.templatesTitle')}</h2>
          <p>{t('home.templatesBody')}</p>
        </div>

        <div class="tpl-row">
          {
            TEMPLATE_IDS.map((tpl) => (
              <a class="device reveal" data-tpl={tpl} href={`/template-check/${tpl}/`}>
                <MiniScreen
                  listing={{ ...propertyShowcase, template: tpl }}
                  cells={cells}
                  perUnit={perUnit}
                />
                <span class="device-label">{t(`editor.templates.${tpl}`)}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section>
      <div class="shell">
        <div class="section-head">
          <h2>{t('home.paletteTitle')}</h2>
          <p>{t('home.paletteBody')}</p>
        </div>
        <div class="palette-band">
          {
            ACCENTS.map((accent) => (
              <a class="palette-swatch" href="/new/?fresh=1" style={`--chip: ${accent.base}`}>
                <span class="chip" />
                <strong>{t(`agent.accents.${accent.id}`)}</strong>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/*
      THE CARD THE LINK BECOMES.

      The highest-leverage thing in the product (CLAUDE.md §6) and the homepage
      never showed it — `home.linkTitle`, `home.linkBody` and
      `home.linkCaption` were written for this block and nothing rendered them,
      which is half the reason the page read as empty. An agent decides whether
      this is worth four minutes by looking at what lands in the group chat.

      OUTGOING, SO IT SITS AT THE INLINE END. In an RTL thread the message you
      sent is on the left; `margin-inline-start: auto` puts it there without
      naming a side (§4.1).
    */}
    <section class="link-band">
      <div class="shell">
        <div class="link-grid">
          <div class="section-head">
            <h2>{t('home.linkTitle')}</h2>
            <p>{t('home.linkBody')}</p>
          </div>

          <div class="thread">
            <div class="bubble">
              <div class="card">
                <img src={cardImage} alt="" loading="lazy" decoding="async" width="1200" height="630" />
                <div class="card-text">
                  <strong><Prose text={cardTitle} /></strong>
                  <span><Prose text={cardFacts} /></span>
                  <em dir="ltr">hasivuv.com</em>
                </div>
              </div>
              {/* bdi, not only dir="ltr": the slug carries digits inside a
                  Hebrew document, and §4.2 wants them isolated by the tag the
                  build gate can see. */}
              <span class="bubble-link"><bdi dir="ltr">hasivuv.com/a/A7K2M</bdi></span>
            </div>
            <p class="thread-note">{t('home.linkCaption')}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="proof">
      <div class="shell">
        <div class="section-head">
          <SectionLabel text={t('home.proofLabel')} />
          <h2>{t('home.proofTitle')}</h2>
        </div>
        <div class="proof-track">
          <article class="proof-chapter">
            <div class="proof-sticky">
              <p class="proof-index"><bdi>1</bdi> / <bdi>4</bdi></p>
              <h3>{t('home.proof1')}</h3>
              <p>{t('home.proof1Body')}</p>
            </div>
          </article>
          <article class="proof-chapter">
            <div class="proof-sticky">
              <p class="proof-index"><bdi>2</bdi> / <bdi>4</bdi></p>
              <h3>{t('home.proof2')}</h3>
              <p>{t('home.proof2Body')}</p>
            </div>
          </article>
          <article class="proof-chapter">
            <div class="proof-sticky">
              <p class="proof-index"><bdi>3</bdi> / <bdi>4</bdi></p>
              <h3>{t('home.proof3')}</h3>
              <p>{t('home.proof3Body')}</p>
            </div>
          </article>
          <article class="proof-chapter">
            <div class="proof-sticky">
              <p class="proof-index"><bdi>4</bdi> / <bdi>4</bdi></p>
              <h3>{t('home.proof4')}</h3>
              <p>{t('home.proof4Body')}</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section>
      <div class="shell">
        <div class="section-head">
          <SectionLabel text={t('home.compareLabel')} />
          <h2>{t('home.compareTitle')}</h2>
          <p>{t('home.compareAfter')}</p>
        </div>
        <div class="compare" style="--split: 50%">
          <div class="compare-layer compare-dump" aria-hidden="true">
            <img src={largest(propertyListing.media.cover, HERO_WIDTHS)} alt="" />
            {propertyListing.media.gallery.map((image) => (
              <img src={largest(image, HERO_WIDTHS)} alt="" />
            ))}
          </div>
          <div class="compare-layer compare-reveal">
            <div class="device" data-tpl="editorial">
              <MiniScreen listing={propertyShowcase} cells={cells} perUnit={perUnit} />
            </div>
          </div>
          <input
            type="range"
            min="0"
            max="100"
            value="50"
            dir="ltr"
            aria-label={t('home.compareHint')}
          />
        </div>
        <p class="compare-hint">{t('home.compareBefore')} {t('home.compareHint')}</p>
      </div>
    </section>

    <section>
      <div class="shell">
        <div class="section-head">
          <SectionLabel text={t('listing.section.around')} />
          <h2>{t('home.aroundTitle')}</h2>
          <p>{t('home.aroundBody')}</p>
        </div>
        <ul class="around-list">
          {sampleSchool && (
            <li>
              <strong>{sampleSchool.name}</strong>
              <span class="around-walk">
                <WalkMinutes minutes={sampleSchool.walkMinutes} walking />
              </span>
              <span class="cite">
                {sampleSchool.sourceName} · {t('source.asOf')}
                <bdi>{sampleSchool.sourceDate}</bdi>
              </span>
            </li>
          )}
          {sampleBus && (
            <li>
              <strong>{sampleBus.name}</strong>
              <span class="around-walk">
                <WalkMinutes minutes={sampleBus.walkMinutes} walking />
              </span>
              <span class="cite">
                {sampleBus.sourceName} · {t('source.asOf')}
                <bdi>{sampleBus.sourceDate}</bdi>
              </span>
            </li>
          )}
          {sampleGrocery && (
            <li>
              <strong>{sampleGrocery.name}</strong>
              <span class="around-walk">
                <WalkMinutes minutes={sampleGrocery.walkMinutes} walking />
              </span>
            </li>
          )}
        </ul>
        <p class="compare-hint">{odblLine}</p>
      </div>
    </section>

    <section>
      <div class="shell">
        <div class="section-head">
          <SectionLabel text={t('listing.section.verified')} />
          <h2>{t('home.verifiedTitle')}</h2>
          <p>{t('home.verifiedBody')}</p>
        </div>
        <ul class="verified-list">
          <li>
            <span class="verified">{t('source.verified')}</span>
            {' '}
            {t('listing.licenceVerified')}
          </li>
          <li>{t('source.seller')}</li>
        </ul>
      </div>
    </section>

    <section class="pricing-band">
      <div class="shell">
        <div class="section-head">
          <h2>{t('home.pricingTitle')}</h2>
        </div>
        <PriceTiers compact />
      </div>
    </section>

    {/* Sign in, and the library that is the reason to. */}
    <section class="dark">
      <div class="shell">
        <div class="dash-grid">
          <div>
            <div class="section-head">
              <h2>{t('home.dashTitle')}</h2>
              <p>{t('home.dashBody')}</p>
            </div>
            <a class="cta" href="/mine/">{t('home.dashCta')}</a>
          </div>

          <div class="dash-shot" aria-hidden="true">
            <div class="dash-shot-bar">{t('common.brand')}</div>
            <div class="dash-cards">
              <div class="dash-card">
                <img
                  src={largest(propertyListing.media.cover, HERO_WIDTHS)}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <em>פורסם</em>
              </div>
              <div class="dash-card">
                <img
                  src={largest(vehicleListing.media.cover, HERO_WIDTHS)}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <em>פורסם</em>
              </div>
              <div class="dash-card">
                <div class="none"></div>
                <em>טיוטה</em>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="closing">
      <div class="shell">
        <h2>{t('home.closingTitle')}</h2>
        <a class="cta" href="/new/?fresh=1">{t('home.cta')}</a>
        <span class="actions-note" style="color:var(--muted)">{t('home.ctaNote')}</span>
      </div>
    </section>
    </main>

    <footer>
      <div class="shell">
        <span><a href="/">{t('common.brand')}</a></span>
        <span>
          <a href="/about/">{t('legal.about')}</a>
          {' · '}
          <a href="/contact/">{t('legal.contact')}</a>
          {' · '}
          <a href="/legal/terms/">{t('legal.terms')}</a>
          {' · '}
          <a href="/legal/privacy/">{t('legal.privacy')}</a>
          {' · '}
          <a href="/legal/accessibility/">{t('legal.accessibility')}</a>
          {' · '}
          <a href="/pricing/">{t('pricing.title')}</a>
          {' · '}
          <a href="/new/?fresh=1">{t('home.cta')}</a>
        </span>
      </div>
    </footer>

    <script>
      import { supabase, supabaseConfigured } from '../lib/supabase';

      /**
       * One header link, not two. Sign-in is the static default so a logged-out
       * first paint never flashes "המודעות שלי". After a session exists the
       * script hides sign-in and shows the library.
       */
      if (supabaseConfigured) {
        const enter = document.getElementById('nav-enter');
        const mine = document.getElementById('nav-mine');
        const client = supabase();

        const paint = async () => {
          const { data } = await client.auth.getSession();
          const signedIn = Boolean(data.session);
          if (enter) enter.hidden = signedIn;
          if (mine) mine.hidden = !signedIn;
        };

        void paint();
        client.auth.onAuthStateChange(() => void paint());
      }

      const compare = document.querySelector<HTMLElement>('.compare');
      const slider = compare?.querySelector<HTMLInputElement>('input[type="range"]');
      slider?.addEventListener('input', () => {
        compare?.style.setProperty('--split', `${slider.value}%`);
      });
    </script>
  </body>
</html>
