---
import { t } from '../lib/i18n';
import { toCells } from '../lib/facts';
import { ils } from '../lib/format';
import { perUnitPrice } from '../lib/price';
import { HERO_WIDTHS, largest } from '../lib/images';
import MiniScreen from '../components/MiniScreen.astro';
import { TEMPLATE_IDS } from '@/types/listing';
import { propertyListing, vehicleListing } from '../lib/listings';
import '../styles/tokens.css';

/**
 * The homepage.
 *
 * REWRITTEN 11 September 2026 for the pivot. The previous version sold the
 * enrichment layer: three provenance states shown as worked examples, copy
 * about what is verified and what the seller declared, a section arguing that
 * what we do not know we do not write.
 *
 * That was a faithful rendering of CLAUDE.md §1 — "the moat is the data, not
 * the page" — and the market said otherwise. An agent does not want validated
 * data. They want a page that looks professional and a link they can send
 * before the viewing ends. The doctrine has been updated to match rather than
 * left to contradict the product; see CLAUDE.md §1 and docs/PRODUCT.md.
 *
 * WHAT THAT CHANGES HERE. The provenance section is gone. The centrepiece is
 * now the thing an agent is actually choosing between: the SAME listing
 * rendered in all three templates, side by side. "A few options, all of them
 * professional" is the offer, and three screens make it in less time than a
 * sentence about it would take to read.
 *
 * THE SCREENS ARE STILL COMPOSED FROM REAL DATA. `propertyListing` comes from
 * the module `/a/{slug}` renders, through the same `toCells`, `ils` and
 * `perUnitPrice` the real pages use. The palettes below mirror the template
 * layer in BaseListing.astro. Those are two copies of the same eight colours
 * and they can drift — the reason it is a copy rather than an import is that
 * BaseListing's tokens are scoped to a whole document, and this page needs
 * three of them side by side inside one. If a fourth template is added, both
 * places need it.
 *
 * THE VALUE RHYTHM stays dark → light → tinted → dark, which is what the
 * listing page does on its own. The scene has not changed: an agent on a
 * phone, between viewings, in sunlight, where a plaster-on-plaster hierarchy
 * collapses to one flat sheet.
 */

const cells = toCells('property', propertyListing.facts).slice(0, 3);
const perUnit = perUnitPrice('property', propertyListing.facts, propertyListing.price);
const vehicleCells = toCells('vehicle', vehicleListing.facts).slice(0, 3);
const vehiclePerUnit = perUnitPrice('vehicle', vehicleListing.facts, vehicleListing.price);

const title = `סיבוב — ${t('home.tagline')}`;
---

<!DOCTYPE html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#111208" />

    <title>{title}</title>
    <meta name="description" content={t('home.subTagline')} />
    <meta name="robots" content="index,follow" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:site_name" content="סיבוב" />
    <meta property="og:title" content="סיבוב" />
    <meta property="og:description" content={t('home.subTagline')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;500;700;900&family=Assistant:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      :root {
        --display: clamp(2.5rem, 5.8vw, 4.2rem);
        --lead: clamp(1.12rem, 2.1vw, 1.34rem);
        --heading: clamp(1.45rem, 2.6vw, 1.9rem);
        --body: 1.0625rem;
        --meta: 0.82rem;

        --gutter: clamp(1.25rem, 5vw, 3rem);
        --rule: 1px solid var(--stone);
        --rule-dark: 1px solid rgba(251, 250, 247, 0.14);
        --on-dark: #fbfaf7;
        --dim: #9c9d93;
      }

      html {
        background: var(--plaster);
        color-scheme: light;
        touch-action: manipulation;
        -webkit-tap-highlight-color: rgba(74, 93, 58, 0.18);
      }

      body {
        font-family: 'Assistant', system-ui, sans-serif;
        background: var(--plaster);
        color: var(--ink);
        font-size: var(--body);
        /* Hebrew has no ascenders or descenders to separate its lines. */
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
      }

      ::selection {
        background: var(--olive);
        color: var(--plaster);
      }

      :focus-visible {
        outline: 2px solid var(--olive);
        outline-offset: 3px;
      }

      .dark :focus-visible {
        outline-color: var(--on-dark);
      }

      .shell {
        max-inline-size: 1120px;
        margin-inline: auto;
        padding-inline: var(--gutter);
      }

      /*
        THE DARK SECTIONS HAVE A GROUND, not a flat fill.
        The verdict on the first version was "empty, no background", and it was
        right: #111208 edge to edge is a void, and in the sunlight this page is
        read in it flattens completely. Two soft radials off-centre give it a
        light source, and a hairline grid gives the eye something to measure
        the depth against. Both are cheap — no image, no blur filter, no
        element. They are painted by the background property itself.
      */
      .dark {
        position: relative;
        background:
          radial-gradient(120% 90% at 82% 8%, rgba(126, 154, 98, 0.16), transparent 60%),
          radial-gradient(90% 70% at 10% 95%, rgba(126, 154, 98, 0.09), transparent 62%),
          var(--ink-deep);
        color: var(--on-dark);
      }

      /* The grid sits under the content and over the wash. `mask` fades it out
         before it reaches an edge, so it reads as texture rather than as a
         table someone left on. */
      .dark::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(251, 250, 247, 0.045) 1px, transparent 1px),
          linear-gradient(90deg, rgba(251, 250, 247, 0.045) 1px, transparent 1px);
        background-size: 68px 68px;
        mask-image: radial-gradient(115% 85% at 50% 25%, #000 35%, transparent 78%);
        pointer-events: none;
      }

      .dark > * {
        position: relative;
      }

      /* The light band gets the quieter half of the same idea, so the page does
         not go from textured to blank at the fold. */
      .lit {
        background:
          radial-gradient(95% 70% at 78% 0%, rgba(74, 93, 58, 0.06), transparent 58%),
          var(--plaster);
      }

      h1,
      h2,
      h3 {
        font-family: 'Frank Ruhl Libre', serif;
        text-wrap: balance;
      }

      /* Hebrew takes no positive tracking and its counters close up past
         -.015em. That is the floor, not a preference. */
      h1 {
        font-weight: 900;
        font-size: var(--display);
        line-height: 1.04;
        letter-spacing: -0.015em;
      }

      h2 {
        font-weight: 700;
        font-size: var(--heading);
        line-height: 1.15;
        letter-spacing: -0.01em;
      }

      /* ---------- Masthead ---------- */

      .top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-block: 1.35rem;
      }

      .mark {
        font-family: 'Frank Ruhl Libre', serif;
        font-weight: 700;
        font-size: 1.4rem;
        letter-spacing: -0.01em;
      }

      .top nav {
        display: flex;
        align-items: center;
        gap: 1.1rem;
      }

      .top-link {
        font-size: var(--meta);
        font-weight: 600;
        /* 6.94:1 on --ink-deep. --olive-lift is 3.83:1 and fails here. */
        color: var(--dim);
        text-decoration: none;
      }

      .top-link:hover {
        color: var(--on-dark);
      }

      /* ---------- Hero ----------
         In RTL the grid fills from the right, so the first child lands where a
         Hebrew reader starts. Nothing computes that; dir="rtl" does. */

      .hero {
        display: grid;
        gap: clamp(2.5rem, 5vw, 4rem);
        padding-block: clamp(2.5rem, 5vw, 3.75rem) clamp(3rem, 6vw, 4.5rem);
      }

      @media (min-width: 1000px) {
        .hero {
          grid-template-columns: minmax(0, 1fr) minmax(260px, 330px);
          align-items: center;
          gap: clamp(2rem, 4vw, 3.5rem);
        }
      }

      .hero-copy {
        max-inline-size: 32rem;
      }

      .hero-sub {
        font-size: var(--lead);
        color: var(--dim);
        margin-block-start: 1.1rem;
        max-inline-size: 26ch;
        text-wrap: balance;
      }

      .hero-lead {
        margin-block-start: 1.5rem;
        max-inline-size: 46ch;
        color: rgba(251, 250, 247, 0.86);
      }

      .actions {
        display: flex;
        align-items: center;
        gap: 1.1rem;
        flex-wrap: wrap;
        margin-block-start: 2rem;
      }

      /*
        BOLDER, because they were not bold enough and that was the note.
        Three changes, and the weight is the one that mattered: Assistant goes
        to 800 and the page was only loading 700, so the button was asking for
        a weight the browser had to fake by not faking it.

        Then size — 1.15rem and a taller box — and a shadow tinted with the
        accent rather than with black, so the button reads as sitting on the
        page rather than cut out of it.
      */
      .cta {
        display: inline-block;
        padding: 1.1rem 2.6rem;
        background: var(--olive);
        color: var(--plaster);
        font-size: 1.15rem;
        font-weight: 800;
        letter-spacing: -0.01em;
        border: none;
        border-radius: 6px;
        text-decoration: none;
        box-shadow: 0 10px 24px -12px rgba(74, 93, 58, 0.9);
        transition:
          transform var(--press) var(--ease-out),
          box-shadow var(--press) var(--ease-out),
          background var(--press) var(--ease-out);
      }

      .cta:hover {
        background: var(--olive-lift);
        transform: translateY(-1px);
        box-shadow: 0 14px 30px -12px rgba(74, 93, 58, 1);
      }

      /* 100–160ms is the band where a press reads as physical. */
      .cta:active {
        transform: scale(0.97);
        box-shadow: 0 4px 12px -8px rgba(74, 93, 58, 0.9);
      }

      .actions-note {
        font-size: var(--meta);
        color: var(--dim);
        max-inline-size: 22ch;
      }

      /* ---------- Device screens ----------
         Composed from the real listing data through the real formatters, so
         they cannot drift from the product. */

      /*
        One grid cell, three screens stacked in it. Grid rather than absolute
        positioning so the container still sizes to the tallest — nothing has
        to be measured and there is no fixed height to get wrong.
      */
      .stage {
        display: grid;
        justify-items: center;
        inline-size: 100%;
      }

      .stage > .device {
        grid-area: 1 / 1;
        /* The cell is as tall as the TALLEST of the three, and without this
           the shorter screens stretch to fill it — which painted a block of
           empty white below the agency one. Each keeps its own height and
           hangs from the top of the cell. */
        align-content: start;
        /* A grid item under justify-items:center sizes to its CONTENT, and the
           content is a screen at inline-size:100% — which resolves against the
           item, which has no width yet. That circularity collapsed all three
           screens to zero. An explicit width breaks it. */
        inline-size: 100%;
      }

      /*
        The two screens SPLIT whatever width they are given rather than each
        claiming a width from the viewport. Flexing from a zero basis cannot
        overflow, because the basis is the space that actually exists — and a
        vw-based clamp has a floor problem below about 340px where the two
        minimums plus the gap exceed the shell.

        The type then follows a width only flex knows, which is what
        container-type is for: 6.25cqi is a sixteenth of the device's resolved
        width, so the screen scales as one object instead of shrinking its box
        while its type stays put.
      */
      .device {
        flex: 1 1 0;
        max-inline-size: 300px;
        container-type: inline-size;
        display: grid;
        gap: 0.6rem;
        justify-items: center;
      }

      .screen {
        display: block;
        text-decoration: none;
        color: var(--s-ink);
        font-size: 6.25cqi;
        inline-size: 100%;
        border-radius: 1em;
        overflow: hidden;
        background: var(--s-ground);
        line-height: 1.5;
        box-shadow:
          0 0 0 1px rgba(251, 250, 247, 0.12),
          0 1.4em 3em -1em rgba(0, 0, 0, 0.55);
      }

      /*
        THE THREE PALETTES, mirroring the template layer in BaseListing.astro.
        Prefixed --s- because they style a miniature inside another document
        and must not collide with the page's own tokens.

        This IS a second copy of those colours. BaseListing's version is scoped
        to a whole document via [data-template] on <html>, and this page needs
        three of them side by side inside one document, so the values are
        repeated rather than imported. A fourth template needs both.
      */
      .device[data-tpl='editorial'] {
        --s-ground: #fbfaf7;
        --s-ink: #191a15;
        --s-deep: #111208;
        --s-line: #e4e0d6;
        --s-warm: #f1ede3;
        --s-muted: #67685f;
        --s-accent: #4a5d3a;
        --s-lift: #5f7749;
      }

      .device[data-tpl='agency'] {
        --s-ground: #ffffff;
        --s-ink: #191a15;
        --s-deep: #1c1917;
        --s-line: #e7e2da;
        --s-warm: #faf6f0;
        --s-muted: #6b6259;
        /* Olive, like the other two. Orange lived here and gave the product a
           second brand colour depending on which template a listing used. The
           accent is the AGENT's choice now (migration 0011) and it is the same
           across all three, so these miniatures differ by SHAPE only. */
        --s-accent: #4a5d3a;
        --s-lift: #7e9a62;
      }

      .device[data-tpl='dark'] {
        --s-ground: #14150f;
        --s-ink: #f3f1ea;
        --s-deep: #0a0b06;
        --s-line: #2c2e24;
        --s-warm: #1d1f16;
        --s-muted: #a3a498;
        --s-accent: #93ab73;
        --s-lift: #aac28c;
      }

      .s-agent {
        display: flex;
        align-items: center;
        gap: 0.4em;
        padding: 0.5em 0.7em;
        background: var(--s-deep);
        /* Never --s-ink: on the dark template that is the light ground, and
           this strip is dark in all three. The same trap BaseListing hit. */
        color: #fbfaf7;
        font-size: 0.55em;
      }

      .s-agent .dot {
        inline-size: 1.6em;
        block-size: 1.6em;
        border-radius: 50%;
        background: var(--s-lift);
        flex: 0 0 auto;
      }

      .s-agent .who {
        font-weight: 600;
      }

      .s-agent .brand {
        margin-inline-start: auto;
        color: #9c9d93;
      }

      /*
        The miniature is built from <span>s, not <div>s: the hero device wraps
        the whole screen in one element and nesting flow content inside it was
        not worth the argument. The cost is that every structural piece has to
        be told it is a block — an inline element ignores aspect-ratio, which
        clipped the price, the facts and the button off the bottom of all four
        screens. Caught on the running page.
      */
      .s-veil,
      .s-place,
      .s-title,
      .s-fact-val,
      .s-fact-lbl,
      .s-price,
      .s-price-note,
      .s-cta {
        display: block;
      }

      .s-hero {
        display: block;
        position: relative;
        aspect-ratio: 4 / 5;
        overflow: hidden;
        background: var(--s-line);
      }

      .s-hero img {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
        display: block;
      }

      .s-veil {
        position: absolute;
        inset-inline: 0;
        inset-block-end: 0;
        padding: 2.4em 0.75em 0.7em;
        background: linear-gradient(
          to top,
          rgba(17, 18, 8, 0.9) 12%,
          rgba(17, 18, 8, 0.55) 48%,
          transparent
        );
        color: #fbfaf7;
      }

      .s-place {
        font-size: 0.5em;
        opacity: 0.88;
      }

      .s-title {
        font-family: 'Frank Ruhl Libre', serif;
        font-weight: 900;
        font-size: 0.95em;
        line-height: 1.05;
        letter-spacing: -0.015em;
        margin-block-start: 0.15em;
      }

      .s-price-bar {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 0.5em;
        padding: 0.8em 0.75em 0.7em;
      }

      .s-price {
        font-family: 'Frank Ruhl Libre', serif;
        font-weight: 700;
        font-size: 1.15em;
        line-height: 1;
        letter-spacing: -0.02em;
        font-variant-numeric: tabular-nums;
      }

      .s-price-note {
        font-size: 0.48em;
        color: var(--s-muted);
        text-align: end;
        padding-block-end: 0.2em;
      }

      .s-facts {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1px;
        background: var(--s-line);
        border-block-start: 1px solid var(--s-line);
      }

      .s-fact {
        background: var(--s-ground);
        padding: 0.6em 0.3em 0.7em;
        text-align: center;
        /* The agency template cards its cells; mirrored so the miniature
           shows the structural difference and not only the colour one. */
        min-block-size: 3.6em;
      }

      /* Agency: a shorter photograph, a filled price band, and facts as a
         labelled two-column list. The same three moves the real template
         makes — see BaseListing. Without them these read as one design in
         three colours, which was the verdict on the first version. */
      .device[data-tpl='agency'] .s-hero {
        aspect-ratio: 4 / 3;
      }

      .device[data-tpl='agency'] .s-price-bar {
        background: var(--s-warm);
        border-block-end: 1px solid var(--s-line);
        align-items: center;
      }

      .device[data-tpl='agency'] .s-facts {
        grid-template-columns: repeat(2, 1fr);
        gap: 0.3em;
        background: transparent;
        border-block-start: 0;
        padding: 0.35em;
      }

      .device[data-tpl='agency'] .s-fact {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.3em;
        text-align: start;
        padding: 0.4em 0.5em;
        border: 1px solid var(--s-line);
        border-radius: 0.45em;
        min-block-size: 0;
      }

      .device[data-tpl='agency'] .s-fact-val {
        font-size: 0.62em;
        order: 2;
      }

      .device[data-tpl='agency'] .s-fact-lbl {
        margin-block-start: 0;
        order: 1;
      }

      /* Dark: the photograph takes more of the screen and the facts lose their
         cells entirely — three bare numbers with a hairline between. */
      .device[data-tpl='dark'] .s-hero {
        aspect-ratio: 3 / 5;
      }

      .device[data-tpl='dark'] .s-facts {
        gap: 0;
        background: transparent;
        border-block-start: 1px solid var(--s-line);
      }

      .device[data-tpl='dark'] .s-fact {
        background: transparent;
      }

      .device[data-tpl='dark'] .s-fact + .s-fact {
        border-inline-start: 1px solid var(--s-line);
      }

      .s-fact.off {
        background: var(--s-warm);
      }

      .s-fact-val {
        font-family: 'Frank Ruhl Libre', serif;
        font-weight: 500;
        font-size: 0.8em;
        line-height: 1.1;
        font-variant-numeric: tabular-nums;
      }

      .s-fact-lbl {
        font-size: 0.44em;
        color: var(--s-muted);
        margin-block-start: 0.2em;
      }

      .s-cta {
        margin: 0.55em 0.7em 0.8em;
        padding: 0.55em;
        text-align: center;
        font-size: 0.52em;
        font-weight: 700;
        border-radius: 0.4em;
        background: var(--s-accent);
        color: #fbfaf7;
      }

      /* On the dark template the accent is pale, so a pale fill with pale type
         would vanish. The button inverts — the only element that does. */
      .device[data-tpl='dark'] .s-cta {
        background: var(--s-ink);
        color: var(--s-ground);
      }

      .device-label {
        font-size: var(--meta);
        font-weight: 600;
        color: var(--muted);
      }

      .dark .device-label {
        color: var(--dim);
      }

      /* ---------- Section furniture ----------
         More space above a heading than below it: the heading belongs to what
         follows, and even spacing leaves it floating between two blocks. */

      section > .shell {
        padding-block: clamp(3.25rem, 6vw, 5rem);
      }

      .section-head {
        max-inline-size: 36rem;
        margin-block-end: clamp(2rem, 3.5vw, 2.75rem);
      }

      .section-head p {
        margin-block-start: 0.85rem;
        color: var(--muted);
        max-inline-size: 60ch;
        text-wrap: pretty;
      }

      .dark .section-head p {
        color: rgba(251, 250, 247, 0.84);
      }

      /* ---------- Templates ---------- */

      /*
        Stretch, not flex-start. The three templates are now genuinely
        different heights — that is the point of them — but their LABELS were
        floating at three different heights, which read as broken rather than
        as deliberate. Stretching the wrapper and pushing the label to the
        bottom keeps the screens honest and the captions on one line.
      */
      .tpl-row {
        display: flex;
        gap: clamp(0.75rem, 2vw, 1.5rem);
        align-items: stretch;
        justify-content: center;
        inline-size: 100%;
      }

      .tpl-row .device {
        grid-template-rows: auto 1fr;
        align-content: start;
      }

      .tpl-row .device-label {
        align-self: end;
      }

      /* ---------- Steps ----------
         A real sequence, so the numerals carry information rather than
         decorating a heading. */

      .steps-band {
        background: var(--stone-warm);
        border-block: var(--rule);
        /* --muted is 4.87:1 on plaster and 4.35:1 on this tinted ground.
           Carried down until it clears AA. */
        --muted: #67685f;
      }

      .steps {
        display: grid;
        gap: clamp(1.6rem, 3vw, 2.5rem);
        list-style: none;
        counter-reset: step;
        padding: 0;
        margin: 0;
      }

      @media (min-width: 760px) {
        .steps {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      .steps li {
        counter-increment: step;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 0 0.9rem;
        align-items: baseline;
        padding-block-start: 1rem;
        border-block-start: 2px solid var(--olive);
      }

      .steps li::before {
        content: counter(step);
        grid-row: span 2;
        font-family: 'Frank Ruhl Libre', serif;
        font-weight: 700;
        font-size: 1.9rem;
        line-height: 1;
        color: var(--olive);
        font-variant-numeric: tabular-nums;
      }

      .steps h3 {
        font-size: 1.1rem;
        font-weight: 700;
        line-height: 1.3;
      }

      .steps p {
        grid-column: 2;
        color: var(--muted);
        margin-block-start: 0.3rem;
        text-wrap: pretty;
      }

      /* ---------- Dashboard ---------- */

      .dash-grid {
        display: grid;
        gap: clamp(2rem, 4vw, 3.25rem);
        align-items: center;
      }

      @media (min-width: 900px) {
        .dash-grid {
          grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
        }
      }

      .dash-shot {
        border: var(--rule-dark);
        border-radius: 8px;
        overflow: hidden;
        background: var(--plaster);
        box-shadow: 0 1.2rem 3rem -1.2rem rgba(0, 0, 0, 0.7);
      }

      .dash-shot-bar {
        background: var(--ink-deep);
        padding: 0.5rem 0.7rem;
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--on-dark);
        font-family: 'Frank Ruhl Libre', serif;
      }

      .dash-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.4rem;
        padding: 0.55rem;
      }

      .dash-card {
        border: 1px solid var(--stone);
        border-radius: 4px;
        overflow: hidden;
        background: var(--plaster);
      }

      .dash-card img {
        inline-size: 100%;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        display: block;
      }

      .dash-card .none {
        aspect-ratio: 16 / 10;
        background: var(--stone-warm);
      }

      .dash-card span {
        display: block;
        padding: 0.3rem 0.4rem 0.45rem;
        font-size: 0.58rem;
        font-weight: 700;
        color: var(--ink);
      }

      .dash-card em {
        display: block;
        font-style: normal;
        font-size: 0.52rem;
        font-weight: 600;
        color: var(--plaster);
        background: var(--olive);
        padding: 0.04rem 0.3rem;
        border-radius: 2px;
        inline-size: fit-content;
        margin: 0 0.4rem 0.4rem;
      }

      /* ---------- Closing ---------- */

      .closing .shell {
        display: grid;
        gap: 1.25rem;
        justify-items: center;
        text-align: center;
        padding-block: clamp(3.5rem, 7vw, 5.5rem);
      }

      .closing h2 {
        max-inline-size: 18ch;
      }

      footer {
        border-block-start: var(--rule);
      }

      footer .shell {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        padding-block: 1.75rem;
        font-size: var(--meta);
        color: var(--muted);
      }

      footer a {
        color: var(--muted);
        text-underline-offset: 3px;
      }

      footer a:hover {
        color: var(--olive);
      }

      /* ---------- Motion ----------
         ONE authored entrance, capped at three steps, and nothing below the
         fold animates. The content is visible by default — animation only ever
         moves something that would already be on screen without it, because a
         reveal gated on a transition ships blank in a headless renderer. */

      /*
        THE DEFAULT STATE IS VISIBLE. Every rule below only ever moves
        something that is already on the page — nothing here can leave the
        homepage blank in a headless renderer, a background tab, or a browser
        that drops the feature.

        Only the first cycling screen shows without motion, which is correct:
        the other two are the same listing in another palette, so no content is
        lost, and a reader who asked for less movement gets one still page.
      */
      .stage > .device + .device {
        opacity: 0;
      }

      @media (prefers-reduced-motion: no-preference) {
        .hero-copy,
        .hero .stage {
          animation: arrive 0.62s both cubic-bezier(0.16, 1, 0.3, 1);
        }

        .hero .stage {
          animation-delay: 0.1s;
        }

        @keyframes arrive {
          from {
            opacity: 0;
            transform: translateY(14px);
          }
        }

        /*
          The cycle. 13.5s for three screens is 4.5s each — long enough to read
          a price and short enough that a reader who arrived for the headline
          sees a second one before they scroll.

          The fade is 4% of the loop on each side, which is about 540ms: slower
          than a UI transition because this is a scene change, not a response
          to a press.
        */
        .stage > .device {
          animation: cycle 13.5s calc(var(--i) * 4.5s) infinite both;
        }

        @keyframes cycle {
          0% {
            opacity: 0;
            transform: translateY(10px) scale(0.985);
          }
          4%,
          29% {
            opacity: 1;
            transform: none;
          }
          33%,
          100% {
            opacity: 0;
            transform: translateY(-10px) scale(0.985);
          }
        }

        /* A card lifts toward the reader on hover. Transform only — animating
           a layout property here would reflow the whole row. */
        .tpl-row .device {
          transition: transform 0.35s var(--ease-out);
        }

        .tpl-row .device:hover {
          transform: translateY(-6px);
        }
      }

      /*
        SCROLL-DRIVEN REVEALS, and every rule is inside BOTH wrappers.

        @supports is the feature detection: outside it the declaration is
        dropped and whatever opacity it was driving is left applied, which is
        how a third of a page goes invisible in a browser that cannot animate
        it back. The reduced-motion query is the other half.
        scripts/verify-motion-fallbacks.mjs asserts both against the BUILT
        stylesheet, because the nesting is the whole difference and it looks
        correct either way in review.
      */
      @media (prefers-reduced-motion: no-preference) {
        @supports (animation-timeline: view()) {
          .reveal {
            animation: rise linear both;
            animation-timeline: view();
            animation-range: entry 5% cover 26%;
          }

          .reveal:nth-child(2) {
            animation-range: entry 2% cover 28%;
          }

          .reveal:nth-child(3) {
            animation-range: entry 0% cover 30%;
          }

          @keyframes rise {
            from {
              opacity: 0;
              transform: translateY(26px);
            }
          }
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .hero-copy,
        .hero .stage {
          animation: fade 0.4s both;
        }

        @keyframes fade {
          from {
            opacity: 0;
          }
        }

        .cta,
        .tpl-row .device {
          transition: none;
        }
      }
    </style>
  </head>

  <body>
    <div class="dark">
      <div class="shell">
        <header class="top">
          <span class="mark">סיבוב</span>
          <nav>
            <a class="top-link" href="/enter/">{t('home.ctaSecond')}</a>
            <a class="top-link" href="/mine/">{t('dash.title')}</a>
          </nav>
        </header>
      </div>

      <div class="shell">
        <div class="hero">
          <div class="hero-copy">
            <h1>{t('home.tagline')}</h1>
            <p class="hero-sub">{t('home.subTagline')}</p>
            <p class="hero-lead">{t('home.lead')}</p>

            <div class="actions">
              <a class="cta" href="/new/">{t('home.cta')}</a>
              <span class="actions-note">{t('home.ctaNote')}</span>
            </div>
          </div>

          <div class="stage">
            {/*
              THE HERO CYCLES THROUGH THE THREE TEMPLATES.

              This is the page's one piece of real motion and it is not
              decoration: the offer is "a few options, all professional", and a
              hero that shows the same listing becoming each of them in turn
              makes that argument while the reader is still reading the
              headline. It is also the honest demo — these are the real
              templates, not three drawings of them.

              CSS only, on a 13.5s loop. Stacked in one grid cell rather than
              absolutely positioned, so the container still sizes itself to the
              tallest screen and nothing has to be measured.

              Under prefers-reduced-motion the animation is simply never
              applied and the first screen stays visible — the content is in
              the markup and on screen by default, so nothing here can leave
              the hero blank.
            */}
            {TEMPLATE_IDS.map((tpl, index) => (
              <div class="device cycling" data-tpl={tpl} style={`--i:${index}`}>
                <MiniScreen
                  listing={propertyListing}
                  cells={cells}
                  perUnit={perUnit}
                  eager={index === 0}
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    {/*
      The centrepiece. One listing, three templates — the offer made in less
      time than a sentence about it would take to read.
    */}
    <section>
      <div class="shell">
        <div class="section-head">
          <h2>{t('home.templatesTitle')}</h2>
          <p>{t('home.templatesBody')}</p>
        </div>

        <div class="tpl-row">
          {
            TEMPLATE_IDS.map((tpl) => (
              <div class="device reveal" data-tpl={tpl}>
                <MiniScreen
                  listing={vehicleListing}
                  cells={vehicleCells}
                  perUnit={vehiclePerUnit}
                />
                <span class="device-label">{t(`editor.templates.${tpl}`)}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="steps-band">
      <div class="shell">
        <div class="section-head">
          <h2>{t('home.howTitle')}</h2>
        </div>

        <ol class="steps">
          <li>
            <h3>{t('home.step1')}</h3>
            <p>{t('home.step1Body')}</p>
          </li>
          <li>
            <h3>{t('home.step2')}</h3>
            <p>{t('home.step2Body')}</p>
          </li>
          <li>
            <h3>{t('home.step3')}</h3>
            <p>{t('home.step3Body')}</p>
          </li>
        </ol>
      </div>
    </section>

    {/* Sign in, and the library that is the reason to. */}
    <section class="dark">
      <div class="shell">
        <div class="dash-grid">
          <div>
            <div class="section-head">
              <h2>{t('home.dashTitle')}</h2>
              <p>{t('home.dashBody')}</p>
            </div>
            <a class="cta" href="/mine/">{t('home.dashCta')}</a>
          </div>

          <div class="dash-shot" aria-hidden="true">
            <div class="dash-shot-bar">סיבוב</div>
            <div class="dash-cards">
              <div class="dash-card">
                <img
                  src={largest(propertyListing.media.cover, HERO_WIDTHS)}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <em>פורסם</em>
              </div>
              <div class="dash-card">
                <img
                  src={largest(vehicleListing.media.cover, HERO_WIDTHS)}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <em>פורסם</em>
              </div>
              <div class="dash-card">
                <div class="none"></div>
                <em>טיוטה</em>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="closing">
      <div class="shell">
        <h2>{t('home.closingTitle')}</h2>
        <a class="cta" href="/new/">{t('home.cta')}</a>
        <span class="actions-note" style="color:var(--muted)">{t('home.ctaNote')}</span>
      </div>
    </section>

    <footer>
      <div class="shell">
        <span>hasivuv.com</span>
        <a href="/new/">{t('home.cta')}</a>
      </div>
    </footer>
  </body>
</html>
