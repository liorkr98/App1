---
import { t } from '../lib/i18n';
import '../styles/tokens.css';

/**
 * The homepage.
 *
 * REBUILT after seeing it on a desktop browser, where the first version was
 * plainly wrong: a 600px column stranded in the middle of a wide window with
 * a fixed bottom bar laid over the content behind it. The 600px column is the
 * LISTING page's shape — it is a document meant to be read on a phone. A
 * homepage is a different surface and needed its own.
 *
 * Grounded in the impeccable reference (pbakaus/impeccable), read directly:
 *
 *   typeset    body measure 65–75ch; tracking floor -0.04em; distinguish
 *              heading, body, label, metadata and data roles at a glance;
 *              never let two weights that are too close carry different jobs.
 *   craft      more space above a heading than below it; tabular numerals for
 *              data; style the browser surfaces — selection, focus ring,
 *              underline offset. No eyebrows above headings. No gradient
 *              text, no decorative blur, no emoji as icons.
 *   animate    one authored entrance, 500–800ms, cubic-bezier(.16,1,.3,1);
 *              never animate width/height/top/left; no generic fade-and-rise
 *              scroll reveals; cap stagger; strip movement under
 *              prefers-reduced-motion but keep opacity.
 *
 * THE PROOF ROWS ARE GONE. Two badge rows — a מאומת figure and a לפי המוכר
 * one — sat under the provenance paragraph. In context they read as stray
 * fragments of another screen rather than as a demonstration. The distinction
 * they were illustrating is the product's whole trust proposition, so it is
 * now shown the honest way: by the real listing page, running, below.
 *
 * THE PREVIEW IS NOT A MOCKUP. It is an iframe of the actual page at
 * /a/A7K2M, rendered at 320px — a real phone width, so nothing is scaled and
 * nothing is faked. It cannot drift from the product, because it IS the
 * product. Two radio inputs switch between the property and the vehicle with
 * no JavaScript at all.
 */

const title = `סיבוב — ${t('home.tagline')}`;
---

<!DOCTYPE html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>{title}</title>
    <meta name="description" content={t('home.tagline')} />
    <meta name="robots" content="index,follow" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:site_name" content="סיבוב" />
    <meta property="og:title" content="סיבוב" />
    <meta property="og:description" content={t('home.tagline')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;500;700;900&family=Assistant:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      /*
        A deliberate role scale, not arbitrary sizes. Five roles that are
        distinguishable at a glance: display, heading, lead, body, meta.
        clamp() carries them across widths without a breakpoint each.
      */
      :root {
        --display: clamp(2.5rem, 6vw, 3.6rem);
        --lead: clamp(1.15rem, 2.2vw, 1.4rem);
        --heading: clamp(1.2rem, 1.6vw, 1.4rem);
        --body: 1.0625rem;
        --meta: 0.8rem;

        --gutter: clamp(1.25rem, 5vw, 3rem);
        --rule: 1px solid var(--stone);
      }

      html {
        background: var(--plaster);
      }

      body {
        font-family: 'Assistant', system-ui, sans-serif;
        background: var(--plaster);
        color: var(--ink);
        font-size: var(--body);
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }

      /* Browser surfaces, styled rather than left to the defaults. */
      ::selection {
        background: var(--olive);
        color: var(--plaster);
      }

      :focus-visible {
        outline: 2px solid var(--olive);
        outline-offset: 3px;
      }

      .shell {
        max-inline-size: 1120px;
        margin-inline: auto;
        padding-inline: var(--gutter);
      }

      /* ---------- Masthead ---------- */

      .top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-block: 1.5rem;
        border-block-end: var(--rule);
      }

      .mark {
        font-family: 'Frank Ruhl Libre', serif;
        font-weight: 700;
        font-size: 1.35rem;
        letter-spacing: -0.02em;
      }

      .top-link {
        font-size: var(--meta);
        font-weight: 600;
        color: var(--muted);
        text-decoration: none;
        transition: color 0.15s ease;
      }

      .top-link:hover {
        color: var(--olive);
      }

      /*
        Two columns on a wide screen: the words on the reading side, the
        running product on the other. In RTL the grid fills from the right, so
        the first child lands where a Hebrew reader starts. Nothing computes
        that — `dir="rtl"` does, and the grid follows.
      */
      .hero {
        display: grid;
        gap: clamp(2.5rem, 5vw, 4rem);
        padding-block: clamp(2.25rem, 4vw, 3.5rem) clamp(2.5rem, 4vw, 3.5rem);
        align-items: center;
      }

      @media (min-width: 900px) {
        .hero {
          /* auto first: the words take the width they need and no more, so
             the column does not stretch a 46ch paragraph across 630px and
             leave the difference as air. */
          grid-template-columns: minmax(0, auto) auto;
          justify-content: space-between;
        }
      }

      .hero-copy {
        max-inline-size: 34rem;
      }

      h1 {
        font-family: 'Frank Ruhl Libre', serif;
        font-weight: 700;
        font-size: var(--display);
        line-height: 1.05;
        /* Tracking floor is -0.04em; large display type needs some. */
        letter-spacing: -0.03em;
      }

      .tagline {
        font-size: var(--lead);
        color: var(--muted);
        margin-block-start: 1rem;
        max-inline-size: 26ch;
        text-wrap: balance;
      }

      .lead {
        margin-block-start: 1.75rem;
        max-inline-size: 46ch;
      }

      .actions {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        flex-wrap: wrap;
        margin-block-start: 2rem;
      }

      .cta {
        display: inline-block;
        padding: 0.95rem 2rem;
        background: var(--olive);
        color: var(--plaster);
        font-size: 1.05rem;
        font-weight: 600;
        border: none;
        border-radius: 4px;
        text-decoration: none;
        /* Offset and a soft blur, not a hard drop. */
        box-shadow: 0 2px 8px rgba(25, 26, 21, 0.12);
        transition:
          transform 0.12s ease,
          box-shadow 0.12s ease;
      }

      .cta:hover {
        box-shadow: 0 4px 14px rgba(25, 26, 21, 0.16);
      }

      /* 100–150ms is the band for immediate feedback. */
      .cta:active {
        transform: translateY(1px);
        box-shadow: 0 1px 4px rgba(25, 26, 21, 0.14);
      }

      .actions-note {
        font-size: var(--meta);
        color: var(--muted);
      }

      /* ---------- The live preview ----------
         An iframe of the real page at a real phone width. Not a screenshot,
         not a drawing: it cannot go stale, because it is the product. */

      .preview {
        display: grid;
        justify-items: center;
        gap: 0.9rem;
      }

      .switch {
        display: flex;
        gap: 0.4rem;
      }

      .preview > input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
      }

      .switch label {
        padding: 0.35rem 0.9rem;
        font-size: var(--meta);
        font-weight: 600;
        color: var(--muted);
        border: var(--rule);
        border-radius: 999px;
        cursor: pointer;
        transition:
          color 0.15s ease,
          border-color 0.15s ease;
      }

      .switch label:hover {
        color: var(--ink);
      }

      #show-property:checked ~ .switch label[for='show-property'],
      #show-vehicle:checked ~ .switch label[for='show-vehicle'] {
        color: var(--olive);
        border-color: var(--olive);
      }

      #show-property:focus-visible ~ .switch label[for='show-property'],
      #show-vehicle:focus-visible ~ .switch label[for='show-vehicle'] {
        outline: 2px solid var(--olive);
        outline-offset: 3px;
      }

/*
        Rendered at 390px — a real iPhone viewport — and SCALED to fit the
        frame, rather than laid out at the frame's own width.

        Letting it lay out at 320px was the mistake: the listing page is
        designed at phone width but 320 is the floor, so the facts grid
        wrapped its paired cell onto two lines, the price clipped, and the
        document was tall enough to grow its own scrollbars inside the frame.
        What it showed was the page under stress, not the page.

        --dev is unitless so the scale can be derived from it. CSS cannot
        divide two lengths to get a number, but it can divide two numbers.
      */
      .device {
        --dev: 320;
        --viewport: 390;
        position: relative;
        inline-size: calc(var(--dev) * 1px);
        max-inline-size: 100%;
        /* 780px of page, scaled by the same factor as the width. */
        block-size: calc(780px * var(--dev) / var(--viewport));
        border: var(--rule);
        border-radius: 20px;
        overflow: hidden;
        background: var(--plaster);
        box-shadow: 0 18px 44px rgba(25, 26, 21, 0.1);
      }

      .device iframe {
        position: absolute;
        inset-block-start: 0;
        inset-inline-start: 0;
        inline-size: calc(var(--viewport) * 1px);
        block-size: 780px;
        border: 0;
        /* Anchored at the top of the inline start — the RIGHT edge in an RTL
           document — so the scale shrinks toward the corner it is pinned to. */
        transform-origin: 100% 0;
        transform: scale(calc(var(--dev) / var(--viewport)));
        /* The page inside is a document to look at, not to operate. Tapping
           anywhere opens the real one. */
        pointer-events: none;
      }

      /* On a narrow phone the frame gives up width; the scale follows it. */
      @media (max-width: 420px) {
        .device {
          --dev: 260;
        }
      }

      /* Only the checked frame is shown. Two radios, no JavaScript. */
      .device iframe {
        transition: opacity 0.2s ease;
      }

      #show-property:checked ~ .device .frame-vehicle,
      #show-vehicle:checked ~ .device .frame-property {
        opacity: 0;
        visibility: hidden;
      }

      @media (prefers-reduced-motion: reduce) {
        .device iframe {
          transition: none;
        }
      }

      .device-open {
        position: absolute;
        inset: 0;
        z-index: 1;
      }

      .preview-note {
        font-size: var(--meta);
        color: var(--muted);
        text-align: center;
        max-inline-size: 34ch;
      }

      /* ---------- Body sections ----------
         Space above a heading, less below it: the heading belongs to what
         follows, and even spacing makes it float between two blocks. */

      .band {
        border-block-start: var(--rule);
      }

      /* ---------- Steps ----------
         Numbered because they are a sequence, and the numeral is set in the
         serif at display weight so it reads as a marker rather than as data. */

      .steps {
        display: grid;
        gap: clamp(1.75rem, 3vw, 2.5rem);
        padding-block: clamp(2.5rem, 4vw, 3.5rem);
        list-style: none;
        counter-reset: step;
      }

      @media (min-width: 760px) {
        .steps {
          grid-template-columns: repeat(3, 1fr);
        }
      }

      .steps li {
        counter-increment: step;
        padding-block-start: 1rem;
        border-block-start: 2px solid var(--olive);
      }

      .steps li::before {
        content: counter(step);
        display: block;
        font-family: 'Frank Ruhl Libre', serif;
        font-weight: 700;
        font-size: 1.5rem;
        line-height: 1;
        color: var(--olive);
        font-variant-numeric: tabular-nums;
        margin-block-end: 0.5rem;
      }

      .steps h3 {
        font-size: 1.05rem;
        font-weight: 600;
        margin-block-end: 0.35rem;
      }

      .steps p {
        color: var(--muted);
        max-inline-size: 34ch;
      }

      /* ---------- Audience ----------
         The one claim on the page aimed at a specific reader, so it gets the
         page's only tinted band — the .flaws colour from the vehicle
         reference, already the product's shade for "worth knowing". */

      .audience {
        background: #f5f2ea;
        border-block-start: var(--rule);
      }

      .audience .shell {
        padding-block: clamp(2.5rem, 4vw, 3.5rem);
      }

      .audience h2 {
        max-inline-size: 20ch;
      }

      .audience p {
        color: var(--muted);
        max-inline-size: 60ch;
        margin-block-start: 0.65rem;
      }

      .band > .shell {
        display: grid;
        gap: clamp(2rem, 4vw, 3.5rem);
        padding-block: clamp(2.75rem, 5vw, 4rem);
      }

      @media (min-width: 760px) {
        .band > .shell {
          grid-template-columns: repeat(3, 1fr);
        }
      }

      h2 {
        font-family: 'Frank Ruhl Libre', serif;
        font-weight: 500;
        font-size: var(--heading);
        line-height: 1.3;
        margin-block-end: 0.65rem;
      }

      .band p {
        color: var(--muted);
        max-inline-size: 68ch;
      }

      /* ---------- Footer ---------- */

      footer {
        border-block-start: var(--rule);
      }

      footer .shell {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        padding-block: 2rem;
        font-size: var(--meta);
        color: var(--muted);
      }

      footer a {
        color: var(--muted);
        text-underline-offset: 3px;
      }

      footer a:hover {
        color: var(--olive);
      }

      /* ---------- Motion ----------
         ONE authored entrance. 600ms sits in the 500–800ms band for a focal
         arrival, on the exponential ease-out the reference recommends. The
         preview follows at 120ms — a capped two-step, not a scroll-reveal
         cascade, and nothing below the fold animates at all. */

      @media (prefers-reduced-motion: no-preference) {
        .hero > * {
          animation: arrive 0.6s both cubic-bezier(0.16, 1, 0.3, 1);
        }

        .hero > .preview {
          animation-delay: 0.12s;
        }

        @keyframes arrive {
          from {
            opacity: 0;
            transform: translateY(12px);
          }
        }
      }

      /* Movement removed, the arrival kept: opacity still carries the meaning. */
      @media (prefers-reduced-motion: reduce) {
        .hero > * {
          animation: fade 0.4s both;
        }

        @keyframes fade {
          from {
            opacity: 0;
          }
        }
      }
    </style>
  </head>

  <body>
    <div class="shell">
      <div class="top">
        <span class="mark">סיבוב</span>
        <a class="top-link" href="/new/">{t('home.cta')}</a>
      </div>
    </div>

    <div class="shell">
      <div class="hero">
        <div class="hero-copy">
          <h1>{t('home.tagline')}</h1>
          <p class="tagline">{t('home.subTagline')}</p>
          <p class="lead">{t('home.lead')}</p>

          <div class="actions">
            <a class="cta" href="/new/">{t('home.cta')}</a>
            <span class="actions-note">{t('home.ctaNote')}</span>
          </div>
        </div>

        <div class="preview">
          {/*
            The radios are siblings of BOTH .switch and .device, not children
            of .switch. A CSS-only tab is driven by ~ , which only reaches
            later siblings — nested inputs matched nothing, so both frames
            rendered and the second painted over the first.
          */}
          <input type="radio" name="preview" id="show-property" checked />
          <input type="radio" name="preview" id="show-vehicle" />

          <div class="switch">
            <label for="show-property">{t('home.previewProperty')}</label>
            <label for="show-vehicle">{t('home.previewVehicle')}</label>
          </div>

          <div class="device">
            <iframe
              class="frame-property"
              src="/a/A7K2M/"
              title={t('home.previewProperty')}
              loading="lazy"
              scrolling="no"
              tabindex="-1"></iframe>
            <iframe
              class="frame-vehicle"
              src="/a/V3M9Q/"
              title={t('home.previewVehicle')}
              loading="lazy"
              scrolling="no"
              tabindex="-1"></iframe>
            <a class="device-open" href="/a/A7K2M/" aria-label={t('home.previewOpen')}></a>
          </div>

          <p class="preview-note">{t('home.previewNote')}</p>
        </div>
      </div>
    </div>

    <div class="band">
      <div class="shell">
        <ol class="steps">
          <li>
            <h3>{t('home.step1')}</h3>
            <p>{t('home.step1Body')}</p>
          </li>
          <li>
            <h3>{t('home.step2')}</h3>
            <p>{t('home.step2Body')}</p>
          </li>
          <li>
            <h3>{t('home.step3')}</h3>
            <p>{t('home.step3Body')}</p>
          </li>
        </ol>
      </div>
    </div>

    <div class="audience">
      <div class="shell">
        <h2>{t('home.forWhoTitle')}</h2>
        <p>{t('home.forWhoBody')}</p>
      </div>
    </div>

    <div class="band">
      <div class="shell">
        <section>
          <h2>{t('home.sourcesTitle')}</h2>
          <p>{t('home.sourcesBody')}</p>
        </section>

        <section>
          <h2>{t('home.gapsTitle')}</h2>
          <p>{t('home.gapsBody')}</p>
        </section>

        <section>
          <h2>{t('home.linkTitle')}</h2>
          <p>{t('home.linkBody')}</p>
        </section>
      </div>
    </div>

    <footer>
      <div class="shell">
        <span>hasivuv.com</span>
        <a href="/new/">{t('home.cta')}</a>
      </div>
    </footer>
  </body>
</html>
