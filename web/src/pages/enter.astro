---
import { t } from '../lib/i18n';
import Site from '../layouts/Site.astro';
import '../styles/enter.css';

/**
 * Sign in.
 *
 * A magic link rather than a password. An agent signs in from a phone, between
 * viewings, perhaps twice a month — a password they set once and never type
 * again is a password they will reset, and a reset flow is two more screens
 * and an email template to get wrong.
 *
 * The link is the whole mechanism: Supabase mails a one-time token, the
 * browser reads it back out of the URL on return (detectSessionInUrl), and the
 * session refreshes itself from then on.
 *
 * Or Google (14 Oct 2026): the same session, from Google's sign-in instead of
 * a mailbox. Supabase holds the Google client; the browser only asks for it
 * and comes back here, where detectSessionInUrl reads the session the same
 * way. One tap on a phone already signed in to Google.
 *
 * Never indexed. It is a door, not a page.
 *
 * P5: on layouts/Site.astro, Onyx, one glass card. The mechanism is unchanged.
 */
---

<Site title={`${t('auth.title')} · ${t('common.brand')}`} robots="noindex,nofollow" account={false}>
  <div class="site-shell en">
    <div class="en-card">
      <h1 class="site-h2">{t('auth.title')}</h1>
      <p class="site-sub">{t('auth.lead')}</p>

      <form id="form">
        <button type="button" id="google" class="site-btn site-btn-ghost en-google">
          <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true">
            <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62z" />
            <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z" />
            <path fill="#FBBC05" d="M3.97 10.72A5.4 5.4 0 0 1 3.68 9c0-.6.1-1.18.29-1.72V4.95H.96A9 9 0 0 0 0 9c0 1.45.35 2.83.96 4.05l3.01-2.33z" />
            <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58z" />
          </svg>
          {t('auth.continueWithGoogle')}
        </button>
        <p class="en-or" aria-hidden="true"><span>{t('auth.or')}</span></p>
        <label for="email">{t('auth.email')}</label>
        <input
          id="email"
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          spellcheck="false"
          required
          dir="ltr"
          placeholder="name@example.com"
        />
        <button type="submit" id="submit" class="site-btn site-btn-primary">{t('auth.send')}</button>
      </form>

      <p class="said" role="status" aria-live="polite" id="said"></p>

      <div class="who" id="who" hidden>
        <span id="who-text"></span>
        <p><a class="site-btn site-btn-primary" href="/mine/">{t('auth.myListings')}</a></p>
        <button type="button" id="out" class="site-btn site-btn-ghost">{t('auth.signOut')}</button>
      </div>
    </div>
  </div>

  <script>
      import '../lib/copy/auth';
      import { t } from '../lib/i18n';
      import { markOwner } from '../lib/owner-cookie';
      import { supabase, supabaseConfigured } from '../lib/supabase';

      const form = document.getElementById('form') as HTMLFormElement;
      const email = document.getElementById('email') as HTMLInputElement;
      const submit = document.getElementById('submit') as HTMLButtonElement;
      const said = document.getElementById('said') as HTMLElement;
      const who = document.getElementById('who') as HTMLElement;
      const whoText = document.getElementById('who-text') as HTMLElement;
      const out = document.getElementById('out') as HTMLButtonElement;
      const google = document.getElementById('google') as HTMLButtonElement;

      const say = (text: string, tone: 'good' | 'bad' = 'good') => {
        said.textContent = text;
        said.dataset.tone = tone;
      };

      if (!supabaseConfigured) {
        say(t('auth.unconfigured'), 'bad');
        submit.disabled = true;
        google.disabled = true;
      } else {
        const client = supabase();

        const render = async () => {
          const { data } = await client.auth.getSession();
          const user = data.session?.user;
          markOwner(Boolean(user));

          who.hidden = !user;
          form.hidden = Boolean(user);

          if (user) whoText.textContent = `${t('auth.signedInAs')}${user.email ?? ''}`;
        };

        void render();
        client.auth.onAuthStateChange(() => void render());

        // A cancelled Google sign-in, or an expired email link, comes back here
        // as ?error= or #error=. Say so once and take it out of the address bar.
        if (/[?#&]error=/.test(window.location.search + window.location.hash)) {
          say(t('auth.returnFailed'), 'bad');
          history.replaceState(null, '', window.location.pathname);
        }

        google.addEventListener('click', async () => {
          google.disabled = true;
          // Leaves the page for Google on success; only a refusal returns here.
          const { error } = await client.auth.signInWithOAuth({
            provider: 'google',
            options: { redirectTo: `${window.location.origin}/enter/` },
          });
          if (error) {
            google.disabled = false;
            say(t('auth.googleFailed'), 'bad');
          }
        });

        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          submit.disabled = true;
          say(t('auth.sending'));

          const { error } = await client.auth.signInWithOtp({
            email: email.value.trim(),
            options: {
              // Back to this page, where detectSessionInUrl reads the token
              // out of the URL and the session begins.
              emailRedirectTo: `${window.location.origin}/enter/`,
            },
          });

          submit.disabled = false;
          say(t(error ? 'auth.failed' : 'auth.sent'), error ? 'bad' : 'good');
        });

        out.addEventListener('click', async () => {
          await client.auth.signOut();
          say('');
          void render();
        });
      }
    </script>
</Site>
