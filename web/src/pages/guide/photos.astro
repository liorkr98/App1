---
import GuidePage from '../../components/GuidePage.astro';
import { guideBySlug } from '@/features/guides/guides';
import { t } from '../../lib/i18n';

/**
 * The photo guide, the first of the guides. Its copy predates the guides
 * table (guide.* keys); since 13 Oct 2026 it renders through the same
 * GuidePage as the rest, so it carries the byline, the Article and the
 * related links.
 */
const sections = [
  {
    title: t('guide.beforeTitle'),
    items: [t('guide.before1'), t('guide.before2'), t('guide.before3'), t('guide.before4')],
  },
  {
    title: t('guide.shootTitle'),
    items: [t('guide.shoot1'), t('guide.shoot2'), t('guide.shoot3'), t('guide.shoot4'), t('guide.shoot5')],
  },
  {
    title: t('guide.orderTitle'),
    items: [t('guide.order1'), t('guide.order2'), t('guide.order3'), t('guide.order4'), t('guide.order5'), t('guide.order6')],
  },
  {
    title: t('guide.coverTitle'),
    items: [t('guide.cover1'), t('guide.cover2')],
  },
];
---
<GuidePage
  guide={guideBySlug('photos')}
  title={t('guide.photosTitle')}
  lead={t('guide.photosLead')}
  sections={sections}
/>
