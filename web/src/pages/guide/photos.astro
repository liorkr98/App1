---
import Plain from '../../layouts/Plain.astro';
import { t } from '../../lib/i18n';

const sections = [
  {
    title: t('guide.beforeTitle'),
    items: [t('guide.before1'), t('guide.before2'), t('guide.before3'), t('guide.before4')],
  },
  {
    title: t('guide.shootTitle'),
    items: [t('guide.shoot1'), t('guide.shoot2'), t('guide.shoot3'), t('guide.shoot4'), t('guide.shoot5')],
  },
  {
    title: t('guide.orderTitle'),
    items: [t('guide.order1'), t('guide.order2'), t('guide.order3'), t('guide.order4'), t('guide.order5'), t('guide.order6')],
  },
  {
    title: t('guide.coverTitle'),
    items: [t('guide.cover1'), t('guide.cover2')],
  },
];
---
<Plain title={t('guide.photosTitle')} robots="index,follow">
  <h1>{t('guide.photosTitle')}</h1>
  <p>{t('guide.photosLead')}</p>
  {sections.map((section) => (
    <section>
      <h2>{section.title}</h2>
      <ul>
        {section.items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>
  ))}
</Plain>
