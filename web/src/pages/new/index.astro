---
import Editor from '../../components/editor/Editor.tsx';
import Site from '../../layouts/Site.astro';
import { t } from '../../lib/i18n';
import '../../styles/editor.css';

/**
 * The editor (Stage E), on the 2.0 site shell (P6).
 *
 * Static, like everything else here — the shell is a file on the CDN and the
 * island boots on the client. There is no server rendering to wait for, which
 * matters because the seller arriving here is usually on cellular and already
 * holding a phone full of photographs.
 *
 * client:load, not client:visible: the island IS the page. Deferring it until
 * it scrolls into view would mean deferring it until after it is needed.
 *
 * PAPER, NOT ONYX, on purpose. The rest of the site went dark in P5; the
 * editor stays light because it is a form an agent fills for four minutes,
 * and editor.css says why a form should not shout. The drama is in the live
 * preview beside it, which is the real page, dark templates and all.
 *
 * Never indexed: a private workspace holding unpublished drafts.
 */
---

<Site title={`${t('listing.create')} · ${t('common.brand')}`} robots="noindex,nofollow" ls="paper">
  <div class="new-shell">
    <Editor client:load />
  </div>
</Site>
