---
import type { Listing, TemplateId } from '@/types/listing';
import { TEMPLATE_IDS } from '@/types/listing';
import ListingPage from '../../components/ListingPage.astro';
import {
  fixtures,
  listings,
  matrixListings,
  propertyListing,
  vehicleListing,
  withNamedRooms,
} from '../../lib/listings';
import { priceDropped, realShapedListings } from '../../lib/real-shaped';
import { CATALOGUE, templateFits } from '@/features/templates/manifest';

export function getStaticPaths() {
  const applyTemplate = (listing: Listing, id: TemplateId): Listing => {
    const next: Listing = { ...listing, template: id };
    if (id === 'walkFirst' && listing.slug === propertyListing.slug) {
      return withNamedRooms(next);
    }
    return next;
  };

  const demos = listings.map((listing) => ({ params: { slug: listing.slug }, props: { listing } }));
  const templates = TEMPLATE_IDS.map((id) => ({
    params: { slug: id },
    props: { listing: applyTemplate(propertyListing, id) },
  }));
  const fixturePages = fixtures.map((listing) => ({
    params: { slug: listing.slug },
    props: { listing },
  }));
  const combos = matrixListings.flatMap((listing) =>
    TEMPLATE_IDS.map((id) => ({
      params: { slug: `${listing.slug}-${id}` },
      props: { listing: applyTemplate(listing, id) },
    })),
  );
  // Every catalogue template on a listing shaped like a real one (no rooms,
  // no plan, no enrichment; with and without the stored neighbourhood).
  const real = realShapedListings.flatMap((listing) =>
    CATALOGUE.filter((id) => templateFits(id, listing.category)).map((id) => ({
      params: { slug: `${listing.slug}-${id}` },
      props: { listing: { ...listing, template: id } },
    })),
  );
  // A price that came down two days ago (0043): the composed first screen
  // and a 1.x template, each with "המחיר ירד" and the old price crossed out.
  const drops = (['aurora', 'agency'] as const).map((id) => ({
    params: { slug: `drop-${id}` },
    props: { listing: priceDropped(applyTemplate(propertyListing, id)) },
  }));
  // The showroom's 360 from four photographs, the fewest a gallery spin takes
  // (spinFromGallery): what e2e/spin.spec.ts turns with a mouse and keys.
  const { cover, gallery } = vehicleListing.media;
  const spin = {
    params: { slug: 'spin-showroom' },
    props: {
      listing: { ...vehicleListing, template: 'showroom', media: { ...vehicleListing.media, spin: [cover, ...gallery] } } as Listing,
    },
  };
  // What the agent turns on for a page (0047): the visit button, the
  // calculator, an open house (far ahead, so the page never ages out of it),
  // a warranty and a video link. And a sold page kept up as a record.
  const options = [
    {
      params: { slug: 'options-property' },
      props: {
        listing: {
          ...propertyListing,
          extras: {
            visit: true,
            calculator: true,
            openHouse: { start: '2030-05-03T10:00:00+03:00', end: '2030-05-03T12:00:00+03:00' },
          },
          media: { ...propertyListing.media, videoUrl: 'https://www.youtube.com/watch?v=example' },
        } as Listing,
      },
    },
    {
      params: { slug: 'options-vehicle' },
      props: { listing: { ...vehicleListing, extras: { visit: true, calculator: true, warranty: true } } as Listing },
    },
    {
      params: { slug: 'sold-kept' },
      props: { listing: { ...propertyListing, status: 'sold', soldPublic: true, extras: { visit: true, calculator: true } } as Listing },
    },
  ];
  return [...demos, ...templates, ...fixturePages, ...combos, ...real, ...drops, spin, ...options];
}

const { listing } = Astro.props;
---
<ListingPage listing={listing} robots="noindex,nofollow" />
