---
import ListingPage from '../../../components/ListingPage.astro';
import { publishedListing } from '../../../lib/listing-from-row';

/**
 * Public listing page.
 *
 * On-demand, because a real agent's slug is not known at build time. Demo
 * fixtures still win inside `publishedListing()` so `/a/A7K2M` and `/a/V3M9Q`
 * stay the visual contract. CI builds the same tree at `/template-check/`.
 */
export const prerender = false;

const slug = Astro.params.slug ?? '';
const listing = await publishedListing(slug);

if (!listing) {
  return Astro.rewrite('/404');
}
---
<ListingPage listing={listing} />
