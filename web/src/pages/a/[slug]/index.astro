---
import ListingEnded from '../../../components/ListingEnded.astro';
import DemoBar from '../../../components/DemoBar.astro';
import ListingPage from '../../../components/ListingPage.astro';
import { listingBySlug } from '../../../lib/listings';
import NotFound from '../../../components/NotFound.astro';
import { countListingEvent } from '../../../lib/listing-events';
import { publishedListing, purchaseExpired } from '../../../lib/listing-from-row';

/**
 * RENDERED PER REQUEST, not at build time.
 *
 * This route used getStaticPaths() over listings.ts, which meant exactly two
 * pages existed — A7K2M and V3M9Q — and A REAL LISTING HAD NO PAGE AT ALL. An
 * agent could finish the whole flow and the link they shared would 404. The
 * link is the product.
 *
 * Demo fixtures still win inside `publishedListing()` so `/a/A7K2M` and
 * `/a/V3M9Q` stay the visual contract even if this deploy's database is empty.
 * CI builds the same tree at `/template-check/`.
 *
 * It is the ONLY route that opts out of prerendering: the homepage, the
 * dashboard, /new and /me are still static files on the CDN.
 *
 * THE PAGE ITSELF IS ListingPage.astro. This file is routing and nothing else.
 */
export const prerender = false;

const slug = Astro.params.slug ?? '';
const listing = slug ? await publishedListing(slug, { sold: true }) : undefined;
// A fixture answering here is an example page: its contact buttons call no one.
const demo = Boolean(slug && listingBySlug(slug));

/*
 * A missing listing is a 404, and so is a DRAFT — publishedListing cannot see
 * one, because the public-read policy exposes only `published`. Sold and
 * archived slugs 404 the same way. Telling a stranger which unpublished slugs exist would be an
 * information leak dressed as a helpful error.
 *
 * RENDERED HERE, NOT REWRITTEN. `Astro.rewrite('/404')` threw on Cloudflare —
 * that route is prerendered, so the Worker has no component to instantiate —
 * and every unrenderable slug answered 500 with an empty body instead. See
 * NotFound.astro. A 404 has to be a 404: WhatsApp, Google and the seller all
 * read the status, and a 500 tells them the site is broken.
 */
if (!listing) {
  Astro.response.status = 404;
}

/*
 * A one-time page past its days: 410 Gone, so search engines drop it fast,
 * and nothing of the listing is served (docs/PRICING.md §2).
 */
const ended = listing ? await purchaseExpired(listing.id) : false;
if (ended) {
  Astro.response.status = 410;
}

/*
 * Noindex said twice: the page's <meta> for search engines, and this header
 * for the fetchers that read headers and never parse the HTML (some AI
 * assistants' among them). Only a seller who opted in is indexable (§7).
 */
if (!listing || listing.indexable !== true || listing.status === 'sold' || ended) {
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
}

/*
 * A view is a person opening the page: not a bot, a prefetch, a HEAD, the
 * agent's own browser, or the same browser again within 30 minutes
 * (count-rules.ts, 13 Oct 2026). Never a fixture: it is not in the table.
 */
// A sold page the agent kept up (0047) is a record, not an ad: no views.
if (listing && !ended && !demo && listing.status !== 'sold') {
  const counted = await countListingEvent(slug, 'view', Astro.request);
  if (counted) Astro.response.headers.append('Set-Cookie', counted);
}
---
{ended ? <ListingEnded /> : listing ? (
  <ListingPage listing={listing} demo={demo}>
    {demo && <DemoBar slot="top" template={listing.template} />}
  </ListingPage>
) : <NotFound />}
