---
import BaseListing from '../../../layouts/BaseListing.astro';
import CtaDock from '../../../components/CtaDock.astro';
import Disclosures from '../../../components/Disclosures.astro';
import Enrichment from '../../../components/Enrichment.astro';
import FactsGrid from '../../../components/FactsGrid.astro';
import Gallery from '../../../components/Gallery.astro';
import Hero from '../../../components/Hero.astro';
import MapSection from '../../../components/MapSection.astro';
import PriceBar from '../../../components/PriceBar.astro';
import Prose from '../../../components/Prose.astro';
import SellerBlock from '../../../components/SellerBlock.astro';
import { CATEGORY_PRESENTATION } from '../../../lib/category-presentation';
import { listings } from '../../../lib/listings';

/**
 * ONE template for both categories.
 *
 * Three of the four allowed divergences are selected by DATA, not by a
 * category check:
 *   price note   PriceBar branches on listPrice
 *   disclosures  rendered when the array is non-empty
 *   map          rendered when the location has a street
 *
 * The fourth — the hero block — comes from CATEGORY_PRESENTATION. That is the
 * only category lookup on the page, which is what keeps a fifth divergence
 * from appearing by accident.
 */
export function getStaticPaths() {
  return listings.map((listing) => ({ params: { slug: listing.slug }, props: { listing } }));
}

const { listing } = Astro.props;
const presentation = CATEGORY_PRESENTATION[listing.category];

const paragraphs = listing.description.split('\n\n');
const heading = listing.category === 'property' ? 'על הדירה' : 'על הרכב';

// A vehicle has no street, so no map. See DESIGN-CONTRACT §5.4.
const showMap = Boolean(listing.location?.street);
const mapImageUrl = 'https://placehold.co/800x400/E4E0D6/6E6F66?text=+';

/**
 * Licence attributions, carried by the data rather than the template.
 *
 * A page that renders no OpenStreetMap places carries no ODbL credit, and a
 * page that gains a new attributed source cannot forget to add one. Hardcoding
 * it in the footer would make the credit depend on a template remembering.
 */
const attributions =
  listing.enrichment?.category === 'property' ? listing.enrichment.attributions : [];
---
<BaseListing
  listing={listing}
  ogFactKeys={presentation.ogFactKeys}
  heroRatio={presentation.heroRatio}
  heroVeilPad={presentation.heroVeilPad}
>
  <Hero cover={listing.media.cover} title={listing.title} location={listing.location} />

  <PriceBar price={listing.price} listPrice={listing.listPrice} priceNote={listing.priceNote} />

  <FactsGrid category={listing.category} facts={listing.facts} />

  <section>
    <h2>{heading}</h2>
    {paragraphs.map((paragraph, index) => (
      <p style={index > 0 ? 'margin-top:.8rem' : undefined}><Prose text={paragraph} /></p>
    ))}
  </section>

  {listing.disclosures && listing.disclosures.length > 0 && (
    <Disclosures items={listing.disclosures} />
  )}

  <Gallery images={listing.media.gallery} />

  {/* Below the seller's own content, deliberately: what they came to publish
      comes first, and the enrichment is what makes the page worth forwarding
      (RESEARCH.md §5). */}
  {listing.enrichment && <Enrichment enrichment={listing.enrichment} />}

  {showMap && listing.location && (
    <MapSection location={listing.location} mapImageUrl={mapImageUrl} />
  )}

  <SellerBlock seller={listing.seller} />

  <CtaDock phone={listing.seller.phone} message={presentation.whatsappMessage} />

  {/* נבנה בסיבוב is the viral loop (CLAUDE.md §8) — a listing page is
      forwarded to 30-80 people who are by definition interested in buying
      something. The ODbL line beside it is a LICENCE CONDITION, not a
      courtesy (§10), and it is driven by the payload so a page with no OSM
      places carries no OSM credit. */}
  <footer>
    נבנה ב<a href="https://hasivuv.com">סיבוב</a>
    {attributions.map((attribution) => (
      <Fragment><br /><span class="attribution"><Prose text={attribution} /></span></Fragment>
    ))}
  </footer>
</BaseListing>
