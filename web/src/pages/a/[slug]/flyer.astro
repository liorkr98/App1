---
import { accentFor } from '@/features/agents/accents';
import { ogPriceFragment } from '@/features/listings/control-surface';
import { displayPhone } from '@/features/listings/phone';
import Prose from '../../../components/Prose.astro';
import QrCode from '../../../components/QrCode.astro';
import { toCells } from '../../../lib/facts';
import { ils } from '../../../lib/format';
import { t } from '../../../lib/i18n';
import { HERO_WIDTHS, largest } from '../../../lib/images';
import { publishedListing } from '../../../lib/listing-from-row';
import { coverStyle, firstSentence, stagePlace, titleLines } from '../../../lib/stage';
import '../../../styles/tokens.css';
import '../../../styles/fonts.css';
import '../../../styles/system/tokens.css';

/**
 * The A4 QR flyer (P7): for a sign in the window, a board in the lobby, a
 * print-out at a viewing. Rendered to PDF by the worker (render_pdf, scope
 * 'flyer') and stored as the listing's flyerUrl.
 *
 * The QR is drawn on the server (lib/qr) and opens this listing's page.
 * The legal lines travel with it: the licence number, the ODbL credit when
 * the page shows OpenStreetMap places (§10), and נבנה בהיעד when the listing
 * carries the mark (§8 — read from the row, decided by the publish trigger).
 * Absent facts show אין and unanswered ones are omitted, as on the page.
 *
 * Never indexed and never linked from the page; it exists to be printed.
 */
export const prerender = false;
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const slug = Astro.params.slug ?? '';
const listing = slug ? await publishedListing(slug) : undefined;
if (!listing) {
  return new Response('not found', { status: 404 });
}

const accent = accentFor(listing.accent);
const cells = toCells(listing.category, listing.facts, listing.audience).slice(0, 6);
// ogPriceFragment is written for og:title ("… · ₪x"); the separator is not ours.
const price = ogPriceFragment(listing.price, listing.priceDisplay, ils(listing.price), t('listing.priceFrom')).replace(/^[\s·]+/, '');
const place = stagePlace(listing);
const lead = firstSentence(listing.description, 260);
const pageUrl = new URL(`/a/${listing.slug}/`, Astro.site ?? Astro.url).href;
const shownUrl = pageUrl.replace(/^https?:\/\//, '').replace(/\/$/, '');
const attributions = [
  ...(listing.enrichment?.category === 'property' ? listing.enrichment.attributions : []),
  ...(listing.textAttributions ?? []),
];
const legal = [
  ...(listing.hyadMark !== false ? [`${t('common.builtByPrefix')}${t('common.brand')}`] : []),
  ...attributions,
];
---
<!DOCTYPE html>
<html lang="he" dir="rtl" data-ls="paper">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{listing.title.replace(/\s*\n\s*/g, ' ')}</title>
    <style is:global>
      @page { size: A4; margin: 0; }
      html, body { margin: 0; }
      body {
        inline-size: 210mm;
        min-block-size: 297mm;
        margin-inline: auto;
        background: #fff;
        color: var(--ls-ink);
        font-family: var(--ls-font-body);
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .fl { display: grid; grid-template-rows: 118mm auto 1fr auto; block-size: 297mm; }
      .fl-photo { overflow: hidden; }
      .fl-photo img { inline-size: 100%; block-size: 100%; object-fit: cover; display: block; }
      .fl-band { block-size: 5mm; background: var(--accent-base); }
      .fl-body { display: grid; grid-template-columns: 1fr 58mm; gap: 10mm; padding: 10mm 14mm 0; align-content: start; }
      .fl-place { margin: 0 0 2mm; font-size: 11pt; font-weight: 700; color: var(--ls-ink-2); }
      .fl-title {
        margin: 0;
        font-family: var(--ls-font-display);
        font-weight: 800;
        font-size: 30pt;
        line-height: 1.05;
        font-variation-settings: 'wdth' 80;
        display: grid;
      }
      .fl-price { margin: 4mm 0 0; font-family: var(--ls-font-display); font-weight: 800; font-size: 24pt; color: var(--accent-base); }
      .fl-lead { margin: 4mm 0 0; font-size: 11pt; line-height: 1.6; color: var(--ls-ink-2); }
      .fl-cells { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4mm 6mm; margin: 7mm 0 0; }
      .fl-cells div { display: grid; border-block-start: 0.4mm solid var(--ls-line); padding-block-start: 2mm; }
      .fl-cells dt { order: 2; font-size: 9pt; font-weight: 700; color: var(--ls-ink-2); }
      .fl-cells dd { margin: 0; font-family: var(--ls-font-display); font-size: 18pt; font-weight: 700; }
      .fl-cells div.is-absent dd, .fl-cells div.is-absent dt { opacity: 0.35; }
      .fl-qr { display: grid; gap: 3mm; justify-items: center; align-content: start; text-align: center; }
      .fl-qr .qr { inline-size: 52mm; block-size: 52mm; }
      .fl-qr p { margin: 0; font-size: 10pt; font-weight: 700; }
      .fl-qr bdi { font-size: 9pt; color: var(--ls-ink-2); }
      .fl-agent {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 8mm;
        margin: 0 14mm;
        padding-block: 6mm;
        border-block-start: 0.5mm solid var(--ls-ink);
        font-size: 11pt;
      }
      .fl-agent b { display: block; font-size: 15pt; }
      .fl-agent span { color: var(--ls-ink-2); }
      .fl-phone { font-family: var(--ls-font-display); font-weight: 800; font-size: 20pt; }
      .fl-legal { margin: 0 14mm 7mm; font-size: 8pt; color: var(--ls-ink-2); }
    </style>
  </head>
  <body style={`--accent-base:${accent.base}`}>
    <div class="fl">
      <div class="fl-photo">
        <img src={largest(listing.media.cover, HERO_WIDTHS)} alt="" style={coverStyle(listing)} />
      </div>
      <div class="fl-band"></div>
      <div class="fl-body">
        <div>
          {place && <p class="fl-place"><Prose text={place} /></p>}
          <h1 class="fl-title">{titleLines(listing).map((line) => <span><Prose text={line} /></span>)}</h1>
          {price && <p class="fl-price"><Prose text={price} /></p>}
          {lead && <p class="fl-lead"><Prose text={lead} /></p>}
          {cells.length > 0 && (
            <dl class="fl-cells">
              {cells.map((cell) => (
                <div class={cell.absent ? 'is-absent' : undefined}>
                  <dt>{cell.label}</dt>
                  <dd>{cell.absent ? t('listing.factsAbsent') : cell.bdi ? <bdi>{cell.displayValue}</bdi> : cell.displayValue}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
        <div class="fl-qr">
          <QrCode text={pageUrl} label={t('flyer.qrLabel')} />
          <p>{t('flyer.scan')}</p>
          <bdi dir="ltr">{shownUrl}</bdi>
        </div>
      </div>
      <div>
        <div class="fl-agent">
          <div>
            <b>{listing.seller.name}</b>
            <span>
              {listing.seller.agencyName ?? listing.seller.role}
              {listing.seller.licenceNumber && (
                <Fragment>{' · '}{t('listing.licenceNumber')}{' '}<bdi>{listing.seller.licenceNumber}</bdi></Fragment>
              )}
            </span>
          </div>
          <bdi class="fl-phone" dir="ltr">{displayPhone(listing.seller.phone)}</bdi>
        </div>
        {legal.length > 0 && (
          <p class="fl-legal">
            {legal.map((line, index) => <Fragment>{index > 0 ? ' · ' : ''}<Prose text={line} /></Fragment>)}
          </p>
        )}
      </div>
    </div>
  </body>
</html>
