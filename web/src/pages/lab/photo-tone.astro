---
import Plain from '../../layouts/Plain.astro';
import { t } from '../../lib/i18n';

/**
 * The automatic photo fix on sample photographs (19 Oct 2026), for
 * e2e/photo-tone.spec.ts: the editor's own stripAndResize, once on a sample
 * made dark and yellow the way an evening phone shot is, once on the sample
 * as it is. Noindex, and /lab/ is disallowed in robots.txt.
 */
---
<Plain title={t('lab.toneTitle')} robots="noindex,nofollow">
  <h1>{t('lab.toneTitle')}</h1>
  <p><button type="button" class="tone-lab-go" data-tone-make>{t('lab.toneMake')}</button></p>
</Plain>

<script>
  import { stripAndResize } from '../../lib/photo-strip';

  const SOURCE = '/fixtures/holon-room-1200.webp';
  const page = document.documentElement;

  const canvasOf = async (src: string) => {
    const image = new Image();
    image.src = src;
    await image.decode();
    const canvas = document.createElement('canvas');
    canvas.width = image.naturalWidth;
    canvas.height = image.naturalHeight;
    canvas.getContext('2d')!.drawImage(image, 0, 0);
    return canvas;
  };
  const fileOf = async (canvas: HTMLCanvasElement, name: string) => {
    const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/jpeg', 0.92));
    return new File([blob!], name, { type: 'image/jpeg' });
  };
  /** Mean of each channel. */
  const means = async (src: string) => {
    const canvas = await canvasOf(src);
    const data = canvas.getContext('2d')!.getImageData(0, 0, canvas.width, canvas.height).data;
    const sum = [0, 0, 0];
    for (let i = 0; i < data.length; i += 4) for (let c = 0; c < 3; c += 1) sum[c]! += data[i + c]!;
    return sum.map((value) => value / (data.length / 4));
  };

  document.querySelector('[data-tone-make]')?.addEventListener('click', async () => {
    page.dataset.tone = 'working';
    const good = await canvasOf(SOURCE);
    // An evening phone shot: darker, and yellow.
    const bad = await canvasOf(SOURCE);
    const ctx = bad.getContext('2d')!;
    const image = ctx.getImageData(0, 0, bad.width, bad.height);
    for (let i = 0; i < image.data.length; i += 4) {
      image.data[i] = 255 * (image.data[i]! / 255) ** 1.6;
      image.data[i + 1] = 255 * (image.data[i + 1]! / 255) ** 1.6 * 0.93;
      image.data[i + 2] = 255 * (image.data[i + 2]! / 255) ** 1.6 * 0.78;
    }
    ctx.putImageData(image, 0, 0);

    const badFile = await fileOf(bad, 'evening.jpg');
    const goodFile = await fileOf(good, 'daylight.jpg');
    const [fixed, plain, goodFixed] = await Promise.all([
      stripAndResize(badFile),
      stripAndResize(badFile, undefined, { tone: false }),
      stripAndResize(goodFile),
    ]);
    if (!fixed || !plain || !goodFixed) {
      page.dataset.tone = 'failed';
      return;
    }
    const [f, p] = await Promise.all([means(URL.createObjectURL(fixed.blob)), means(URL.createObjectURL(plain.blob))]);
    Object.assign(page.dataset, {
      tone: 'done',
      toneFixed: String(Boolean(fixed.toned)),
      tonePlain: String(Boolean(plain.toned)),
      toneGood: String(Boolean(goodFixed.toned)),
      toneBrightBefore: ((p[0]! + p[1]! + p[2]!) / 3).toFixed(1),
      toneBrightAfter: ((f[0]! + f[1]! + f[2]!) / 3).toFixed(1),
      toneCastBefore: (p[0]! - p[2]!).toFixed(1),
      toneCastAfter: (f[0]! - f[2]!).toFixed(1),
    });
  });
</script>
