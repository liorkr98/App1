---
import { ACCENTS } from '@/features/agents/accents';
import { ils } from '../lib/format';
import { tlvListing } from '../lib/fixtures';
import { GALLERY_WIDTHS, largest } from '../lib/images';
import { t } from '../lib/i18n';
import Prose from '../components/Prose.astro';
import Site from '../layouts/Site.astro';
import '../styles/me.css';

/**
 * The agent's own details.
 *
 * WHY THIS PAGE EXISTS. The homepage now promises an agent that their name
 * sits on top of every page they send, and until this page there was nowhere
 * to tell us what that name is. Migration 0009 added the columns — phone,
 * agency_name, role, licence_number — and nothing has ever written to them.
 * `listings.seller` was jsonb that only the two sample listings filled in.
 *
 * ASKED ONCE, NOT PER LISTING. CLAUDE.md §1: a private seller does this every
 * seven years, an agent every week. Putting these fields in the editor would
 * make an agent retype their agency twenty times a month, and guarantee that
 * listing twenty spells it differently from listing one — which is precisely
 * the inconsistency this product sells the cure for.
 *
 * NO REACT. astro.config.mjs is explicit that React exists for ONE page —
 * /new, a genuine multi-step application. This is a five-field form with a
 * live preview, which is a script. Pulling a framework in here would put a
 * bundle in front of a form that does not need one, on the same cellular
 * connection everything else on this site is optimised for.
 *
 * THE PREVIEW IS THE POINT, not decoration. An agent typing their agency name
 * into a text input has no idea what they are buying. The same agent watching
 * the strip above it fill in with their own name does. It is also the honest
 * way to show what happens when the agency is left blank — the bar falls back
 * to נבנה בהיעד — rather than explaining that in a hint nobody reads.
 *
 * V2 (P5): the brand kit and the first-run flow. The preview is now a
 * miniature listing (the Tel Aviv fixture) whose agent bar, button and
 * watermark take the agent's name, office, logo and accent as they type.
 * `?welcome` — where the dashboard's first-run banner points — adds the
 * three steps (details, brand, first listing) and, once saved, the way on
 * to the editor. The same form, the same profile columns; no new table.
 */
const sample = tlvListing;
const sampleTitle = sample.title.split('\n');

---

<Site title={`${t('agent.title')} · ${t('common.brand')}`} robots="noindex,nofollow" account={false}>
  <Fragment slot="nav">
    <a class="site-link" href="/mine/">{t('auth.myListings')}</a>
    <a class="site-link" id="nav-admin" href="/admin/" hidden>{t('admin.link')}</a>
  </Fragment>

  <div class="site-shell me">
    <ol class="me-steps" id="steps" aria-label={t('agent.steps')} hidden>
      <li id="step-details" data-state="on"><bdi>1</bdi> {t('agent.stepDetails')}</li>
      <li id="step-brand"><bdi>2</bdi> {t('agent.stepBrand')}</li>
      <li id="step-first"><bdi>3</bdi> {t('agent.stepFirst')}</li>
    </ol>

    <header class="me-head" id="plain-head">
      <h1 class="site-h2">{t('agent.title')}</h1>
      <p class="site-sub">{t('agent.lead')}</p>
    </header>
    <header class="me-head" id="welcome-head" hidden>
      <p class="site-h2 me-welcome">{t('agent.welcomeTitle')}</p>
      <p class="site-sub">{t('agent.welcomeLead')}</p>
    </header>

    {/* Shown instead of the form when nobody is signed in. */}
    <div class="gate" id="gate" hidden>
      <p>{t('agent.signedOut')}</p>
      <p><a href="/enter/">{t('agent.signIn')}</a></p>
    </div>

    {/*
      VISIBLE BY DEFAULT, and the script hides it if nobody is signed in.

      The other way round — everything hidden until a successful load —
      renders a blank page whenever the script fails, and it failed here on
      the first try: a stale Vite dependency returned 504, `loadProfile`
      never resolved, and the page showed a heading and nothing else. The
      same doctrine is written into mine.astro.
    */}
    <div class="me-grid" id="panel">
      <aside class="preview" aria-label={t('agent.previewTitle')}>
        <div class="pv-phone">
          <div class="agent-bar" id="pv-bar">
            <span class="dot" aria-hidden="true"><img id="pv-logo" hidden alt="" /></span>
            <strong id="pv-name" data-empty="true">{t('agent.name')}</strong>
            <span class="brand" id="pv-brand">{t('agent.previewFallback')}</span>
          </div>
          <div class="pv-hero">
            <img src={largest(sample.media.cover, GALLERY_WIDTHS)} alt="" width={sample.media.cover.width} height={sample.media.cover.height} decoding="async" />
            <img class="preview-watermark" id="pv-mark" alt="" />
            <div class="pv-copy">
              <p class="pv-title">{sampleTitle.map((line) => <span><Prose text={line} /></span>)}</p>
              <p class="pv-price"><bdi>{ils(sample.price)}</bdi></p>
            </div>
          </div>
          <span class="pv-wa">{t('agent.previewWa')}</span>
        </div>
        <p class="pv-note">{t('agent.previewNote')}</p>
      </aside>

      <form id="form" novalidate>
        <fieldset id="fields">
          <section class="me-group" id="g-details">
            <h2>{t('agent.groupDetails')}</h2>

            <div class="field" id="f-name">
              <label for="name">{t('agent.name')}</label>
              <input id="name" name="name" type="text" autocomplete="name" required />
              <p class="hint">{t('agent.nameHint')}</p>
              <p class="bad" id="e-name"></p>
            </div>

            <div class="field" id="f-phone">
              <label for="phone">{t('agent.phone')}</label>
              {/*
                dir="ltr" on the input only. A phone number is a run of Latin
                digits and separators; typed into an RTL field the caret jumps
                and the separators land on the wrong side of the groups. The
                LABEL stays RTL, because it is Hebrew.
              */}
              <input
                id="phone"
                name="phone"
                type="tel"
                inputmode="tel"
                autocomplete="tel"
                dir="ltr"
                placeholder="050-123-4567"
                required
              />
              <p class="hint">{t('agent.phoneHint')}</p>
              <p class="bad" id="e-phone"></p>
            </div>

            <div class="field" id="f-role">
              <span class="label">{t('agent.role')}</span>
              <div class="swatches pills">
                <input type="radio" name="role" id="role-agent" value="מתווך" />
                <label for="role-agent">{t('agent.roleAgent')}</label>
                <input type="radio" name="role" id="role-owner" value="בעל הנכס" checked />
                <label for="role-owner">{t('agent.roleOwner')}</label>
              </div>
              <p class="hint">{t('agent.roleHint')}</p>
            </div>

            <div class="field" id="f-licence">
              <label for="licence">{t('agent.licence')}</label>
              <input id="licence" name="licence" type="text" inputmode="numeric" dir="ltr" />
              <p class="hint">{t('agent.licenceHint')}</p>
            </div>
          </section>

          <section class="me-group" id="g-brand">
            <h2>{t('agent.groupBrand')}</h2>

            <div class="field" id="f-agency">
              <label for="agency">{t('agent.agency')}</label>
              <input id="agency" name="agency" type="text" autocomplete="organization" />
              <p class="hint">{t('agent.agencyHint')}</p>
            </div>

            <div class="field" id="f-accent">
              <span class="label">{t('agent.accent')}</span>
              <div class="swatches">
                {
                  ACCENTS.map((accent) => (
                    <Fragment>
                      <input
                        type="radio"
                        name="accent"
                        id={`accent-${accent.id}`}
                        value={accent.id}
                        checked={accent.id === 'olive'}
                      />
                      <label for={`accent-${accent.id}`}>
                        <span class="chip" style={`--chip:${accent.base}`} />
                        {t(`agent.accents.${accent.id}`)}
                      </label>
                    </Fragment>
                  ))
                }
              </div>
              <p class="hint">{t('agent.accentHint')}</p>
            </div>

            <div class="field" id="f-logo">
              <label for="logo">{t('agent.logo')}</label>
              <input id="logo" name="logo" type="file" accept="image/jpeg,image/png,image/webp" />
              <p class="hint">{t('agent.logoHint')}</p>
              <button type="button" class="quiet" id="logo-remove" hidden>
                {t('agent.logoRemove')}
              </button>
            </div>

            <div class="field" id="f-placement">
              <span class="label">{t('agent.logoPlacement')}</span>
              <div class="swatches pills">
                {
                  (
                    [
                      ['bar', 'logoBar'],
                      ['barWide', 'logoBarWide'],
                      ['footerOnly', 'logoFooterOnly'],
                      ['watermark', 'logoWatermark'],
                    ] as const
                  ).map(([id, key], index) => (
                    <Fragment>
                      <input
                        type="radio"
                        name="logoPlacement"
                        id={`place-${id}`}
                        value={id}
                        checked={index === 0}
                      />
                      <label for={`place-${id}`}>{t(`agent.${key}`)}</label>
                    </Fragment>
                  ))
                }
              </div>
              <p class="hint">{t('agent.logoPlacementHint')}</p>
            </div>
          </section>
        </fieldset>

        <button type="submit" id="save" class="site-btn site-btn-primary me-save">{t('agent.save')}</button>
        <p class="said" role="status" aria-live="polite" id="said"></p>
        <p class="me-next" id="next" hidden>
          <a class="site-btn site-btn-primary" href="/new/?fresh=1">{t('agent.nextCta')}</a>
        </p>
      </form>
    </div>
  </div>

  <script>
      import { ACCENTS } from '@/features/agents/accents';
      import { asLogoPlacement } from '@/features/agents/logo-placement';
      import { profileBlockers, type ProfileBlockerCode } from '@/features/agents/profile';
      import { t } from '../lib/i18n';
      import { removeAgencyLogo, uploadAgencyLogo } from '../lib/agency-logo';
      import { loadProfile, saveProfile } from '../lib/profile';
      import { revealIfSiteAdmin } from '../lib/site-admin';
      import { supabaseConfigured } from '../lib/supabase';

      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

      // Keyed by plain string: the value comes off a radio input, which the
      // DOM types as string and not as the literal union.
      const ACCENT_MAP = new Map<string, { base: string; lift: string }>(
        ACCENTS.map((accent) => [accent.id as string, accent]),
      );

      const gate = $('gate');
      const panel = $('panel');
      const form = $<HTMLFormElement>('form');
      const save = $<HTMLButtonElement>('save');
      const said = $('said');

      const name = $<HTMLInputElement>('name');
      const phone = $<HTMLInputElement>('phone');
      const agency = $<HTMLInputElement>('agency');
      const chosenRole = () =>
        (document.querySelector('input[name="role"]:checked') as HTMLInputElement | null)?.value ??
        'בעל הנכס';
      const licence = $<HTMLInputElement>('licence');
      const logo = $<HTMLInputElement>('logo');
      const logoRemove = $<HTMLButtonElement>('logo-remove');

      const pvName = $('pv-name');
      const pvDot = document.querySelector('.agent-bar .dot') as HTMLElement | null;
      const pvLogo = $<HTMLImageElement>('pv-logo');
      const pvBrand = $('pv-brand');
      const pvBar = $('pv-bar');
      const pvMark = $<HTMLImageElement>('pv-mark');
      const preview = document.querySelector('.preview') as HTMLElement | null;
      const welcome = new URLSearchParams(window.location.search).has('welcome');

      // Kept beside the form, not in an input: the file control's value is
      // the local path, and the public URL is what the page actually stamps.
      let logoUrl = '';

      const say = (text: string, tone: 'good' | 'bad' = 'good') => {
        said.textContent = text;
        said.dataset.tone = tone;
      };

      /** The form's fields, as the domain sees them. */
      const chosenAccent = () =>
        (document.querySelector('input[name="accent"]:checked') as HTMLInputElement | null)
          ?.value ?? 'olive';

      const chosenPlacement = () =>
        asLogoPlacement(
          (document.querySelector('input[name="logoPlacement"]:checked') as HTMLInputElement | null)
            ?.value,
        );

      const read = () => ({
        displayName: name.value,
        phone: phone.value,
        agencyName: agency.value,
        role: chosenRole(),
        licenceNumber: licence.value,
        accent: chosenAccent(),
        agencyLogoUrl: logoUrl || null,
        logoPlacement: chosenPlacement(),
      });

      /**
       * The preview, and the fallback that makes the agency field's point.
       *
       * With no agency the brand slot reads נבנה בהיעד — which is what
       * BaseListing does, and is also the viral loop (CLAUDE.md §8). Showing
       * it here is the difference between "optional" and "here is what you
       * get instead".
       */
      const paint = () => {
        const typed = name.value.trim();
        pvName.textContent = typed || t('agent.name');
        pvName.dataset.empty = typed ? 'false' : 'true';

        const office = agency.value.trim();
        pvBrand.textContent = office || t('agent.previewFallback');

        // The dot is the one place the accent shows in this preview, so it is
        // the one place that has to update. It uses the LIFT stop, because the
        // listing page does: on --ink-deep the base is too close in value to
        // read as a colour at all.
        const accent = ACCENT_MAP.get(chosenAccent());
        if (accent && pvDot) pvDot.style.background = accent.lift;
        if (accent && preview) {
          preview.style.setProperty('--pv-accent', accent.base);
          preview.style.setProperty('--pv-lift', accent.lift);
        }

        if (logoUrl) {
          pvLogo.src = logoUrl;
          pvLogo.hidden = false;
          pvMark.src = logoUrl;
        } else {
          pvLogo.removeAttribute('src');
          pvLogo.hidden = true;
          pvMark.removeAttribute('src');
        }
        const placement = chosenPlacement();
        pvBar.dataset.logo = placement;
        if (preview) preview.dataset.logo = placement;
        logoRemove.hidden = logoUrl === '';
      };

      /**
       * Errors are shown for a field only after it has been left, or after a
       * save was attempted. Marking a phone invalid on the third keystroke is
       * telling someone they are wrong while they are still typing.
       */
      let showErrors = false;

      const MESSAGES: Record<ProfileBlockerCode, string> = {
        nameMissing: t('agent.nameMissing'),
        phoneMissing: t('agent.phoneMissing'),
        phoneInvalid: t('agent.phoneInvalid'),
      };

      const validate = () => {
        const found = profileBlockers(read());

        const mark = (fieldId: string, errorId: string, codes: ProfileBlockerCode[]) => {
          const hit = codes.find((code) => found.includes(code));
          const field = $(fieldId);
          field.dataset.bad = showErrors && hit ? 'true' : 'false';
          $(errorId).textContent = hit ? MESSAGES[hit] : '';
        };

        mark('f-name', 'e-name', ['nameMissing']);
        mark('f-phone', 'e-phone', ['phoneMissing', 'phoneInvalid']);

        return found.length === 0;
      };

      for (const swatch of document.querySelectorAll(
        'input[name="accent"], input[name="logoPlacement"], input[name="role"]',
      )) {
        swatch.addEventListener('change', paint);
      }

      for (const input of [name, phone, agency, licence]) {
        input.addEventListener('input', () => {
          paint();
          validate();
        });
        input.addEventListener('blur', () => {
          showErrors = true;
          validate();
        });
      }

      logo.addEventListener('change', () => {
        const file = logo.files?.[0];
        logo.value = '';
        if (!file) return;

        void (async () => {
          logo.disabled = true;
          const result = await uploadAgencyLogo(file);
          logo.disabled = false;

          if ('url' in result) {
            logoUrl = result.url;
            paint();
            say(t('agent.saved'));
            return;
          }

          say('signedOut' in result ? t('agent.signedOut') : t('agent.logoFailed'), 'bad');
        })();
      });

      logoRemove.addEventListener('click', () => {
        void (async () => {
          logoRemove.disabled = true;
          const result = await removeAgencyLogo();
          logoRemove.disabled = false;

          if ('ok' in result) {
            logoUrl = '';
            paint();
            say(t('agent.saved'));
            return;
          }

          say('signedOut' in result ? t('agent.signedOut') : t('agent.logoFailed'), 'bad');
        })();
      });

      const start = async () => {
        if (!supabaseConfigured) {
          panel.hidden = true;
          gate.hidden = false;
          say(t('auth.unconfigured'), 'bad');
          return;
        }

        const result = await loadProfile();

        if ('signedOut' in result) {
          panel.hidden = true;
          gate.hidden = false;
          return;
        }

        void revealIfSiteAdmin(document.getElementById('nav-admin'));

        if ('error' in result) {
          // The form still opens. An agent who cannot read their saved
          // details can still type new ones, and a page that shows only an
          // error has taken away the thing they came to do.
          say(t('agent.loadFailed'), 'bad');
          paint();
          return;
        }

        const { profile } = result;
        name.value = profile.displayName ?? '';
        phone.value = profile.phone ?? '';
        agency.value = profile.agencyName ?? '';
        const broker = /מתווך|מתווכת|סוכן|סוכנת/.test(profile.role ?? '');
        const roleInput = document.getElementById(broker ? 'role-agent' : 'role-owner') as HTMLInputElement | null;
        if (roleInput) roleInput.checked = true;
        licence.value = profile.licenceNumber ?? '';
        logoUrl = profile.agencyLogoUrl?.trim() ?? '';

        const savedPlace = document.querySelector(
          `input[name="logoPlacement"][value="${CSS.escape(profile.logoPlacement ?? 'bar')}"]`,
        ) as HTMLInputElement | null;
        if (savedPlace) savedPlace.checked = true;

        const saved = document.querySelector(
          `input[name="accent"][value="${CSS.escape(profile.accent ?? 'olive')}"]`,
        ) as HTMLInputElement | null;
        // Falls back to the olive already checked in the markup, so an accent
        // we no longer offer leaves the agent on the brand colour, not on none.
        if (saved) saved.checked = true;

        paint();
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        showErrors = true;
        if (!validate()) {
          // The blocker text is already beside the offending field; repeating
          // it in the status line would say the same thing twice.
          say('', 'bad');
          return;
        }

        save.disabled = true;
        say(t('agent.saving'));

        const result = await saveProfile(read());

        save.disabled = false;

        if ('ok' in result) {
          say(t('agent.saved'));
          if (welcome) {
            $('next').hidden = false;
            $('step-first').dataset.state = 'on';
            for (const id of ['step-details', 'step-brand']) $(id).dataset.state = 'done';
            $('next').querySelector('a')?.focus();
          }
          return;
        }

        say('signedOut' in result ? t('agent.signedOut') : t('agent.failed'), 'bad');
      });

      if (welcome) {
        $('steps').hidden = false;
        $('welcome-head').hidden = false;
        $('plain-head').hidden = true;
        // The step follows the part of the form being filled.
        $('g-brand').addEventListener('focusin', () => {
          $('step-details').dataset.state = 'done';
          $('step-brand').dataset.state = 'on';
        });
      }

      // A rejection here must not leave a form the seller cannot use. The
      // fields are already on the page and already typeable; all that is lost
      // is whatever was saved before, so say so and let them re-enter it.
      void start().catch(() => say(t('agent.loadFailed'), 'bad'));
    </script>
</Site>
