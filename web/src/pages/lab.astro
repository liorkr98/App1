---
import { t } from '../lib/i18n';
import { propertyListing } from '../lib/listings';
import { GALLERY_WIDTHS, largest } from '../lib/images';
import { ils } from '../lib/format';
import BrandMark from '../components/BrandMark.astro';
import SectionLabel from '../components/SectionLabel.astro';
import '../styles/tokens.css';
import '../styles/listing.css';

/**
 * Motion lab. Noindex. Not a product surface.
 *
 * M1–M9 live here first so the listing page copies a working primitive
 * rather than inventing one. DESIGN-CONTRACT §6.3 / redesign plan Phase 2.
 */
const photos = [propertyListing.media.cover, ...propertyListing.media.gallery];
const rooms = ['סלון', 'מטבח', 'מרפסת', 'מבט לסלון'];
---

<!DOCTYPE html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{t('lab.title')} · {t('common.brand')}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;500;700;900&family=Assistant:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      .lab {
        max-inline-size: 620px;
        margin-inline: auto;
        padding: 1.25rem var(--gut) 4rem;
        font-family: 'Assistant', system-ui, sans-serif;
        background: var(--plaster);
        color: var(--ink);
        line-height: 1.6;
      }
      .lab-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-block-end: 1.5rem;
      }
      .lab h1 {
        font-family: 'Frank Ruhl Libre', serif;
        font-size: var(--t-h2);
        letter-spacing: -0.02em;
      }
      .lab-block {
        margin-block: 2.2rem;
        padding-block-end: 1.4rem;
        border-block-end: 1px solid var(--stone);
      }
      .lab-note {
        color: var(--muted);
        font-size: 0.92rem;
        max-inline-size: 48ch;
      }
      .lab-press {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-block-size: 44px;
        padding: 0.45rem 1rem;
        background: var(--olive);
        color: var(--plaster);
        font-weight: 700;
        border: 0;
        border-radius: 6px;
        cursor: pointer;
      }
    </style>
  </head>
  <body class="lab">
    <a class="skip" href="#main">{t('a11y.skip')}</a>
    <header class="lab-head">
      <BrandMark href="/" />
      <a href="/">{t('legal.home')}</a>
    </header>
    <main id="main">
      <h1>{t('lab.title')}</h1>
      <p class="lab-note">{t('lab.lead')}</p>

      <section class="lab-block">
        <SectionLabel text={t('lab.m1')} />
        <h2 class="hero-title">
          <span class="hero-line"><span>דירת <bdi>4</bdi> חדרים,</span></span>
          <span class="hero-line"><span>משופצת מהיסוד</span></span>
        </h2>
      </section>

      <section class="lab-block">
        <SectionLabel text={t('lab.m2')} />
        <img
          class="clip-reveal"
          src={largest(photos[0]!, GALLERY_WIDTHS)}
          alt={photos[0]!.alt ?? ''}
          width={photos[0]!.width}
          height={photos[0]!.height}
        />
      </section>

      <section class="lab-block">
        <SectionLabel text={t('lab.m3')} />
        <p class="lab-note">{t('lab.m3Note')}</p>
        <p>
          <bdi data-count="95">95</bdi>
          {' '}
          מ״ר ·
          {' '}
          <bdi data-count="4">4</bdi>
          {' '}
          חדרים
        </p>
      </section>

      <section class="lab-block">
        <SectionLabel text={t('lab.m4')} />
        <button
          type="button"
          class="gallery-open"
          data-lightbox={largest(photos[0]!, GALLERY_WIDTHS)}
          data-alt={photos[0]!.alt ?? ''}
        >
          <img
            src={largest(photos[0]!, GALLERY_WIDTHS)}
            alt={photos[0]!.alt ?? ''}
            width={photos[0]!.width}
            height={photos[0]!.height}
          />
        </button>
      </section>

      <section class="lab-block">
        <SectionLabel text={t('lab.m5')} />
        <p class="lab-note">{t('lab.m5Note')}</p>
        <nav class="tour-chips">
          {rooms.map((room, index) => (
            <a href={`#lab-tour-${index}`}>{room}</a>
          ))}
        </nav>
        <div class="tour-track">
          {photos.map((photo, index) => (
            <figure class="tour-card" id={`lab-tour-${index}`}>
              <img
                src={largest(photo, GALLERY_WIDTHS)}
                alt={photo.alt ?? rooms[index] ?? ''}
                width={photo.width}
                height={photo.height}
              />
            </figure>
          ))}
        </div>
      </section>

      <section class="lab-block">
        <SectionLabel text={t('lab.m7')} />
        <div class="compact-bar">
          <span class="compact-price"><bdi>{ils(propertyListing.price)}</bdi></span>
          <a class="compact-wa" href="#main">{t('listing.whatsappCta')}</a>
        </div>
      </section>

      <section class="lab-block">
        <SectionLabel text={t('lab.m8')} />
        <button type="button" class="lab-press gallery-open">{t('lab.press')}</button>
      </section>

      <section class="lab-block">
        <SectionLabel text={t('lab.m9')} />
        <p class="lab-note">{t('lab.m9Note')}</p>
      </section>
    </main>

    <dialog id="listing-lightbox" class="lightbox" aria-label={t('listing.openPhoto')}>
      <button type="button" class="lightbox-close">{t('listing.closeLightbox')}</button>
      <div class="lightbox-track"></div>
    </dialog>
    <script src="../scripts/listing-enhance.ts"></script>
  </body>
</html>
