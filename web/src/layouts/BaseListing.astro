---
import { accentFor } from '@/features/agents/accents';
import type { Listing } from '@/types/listing';
import { t } from '../lib/i18n';
import { listingJsonLd } from '../lib/jsonld';
import { ogDescription, ogImageUrl, ogTitle } from '../lib/og';
import '../styles/tokens.css';

interface Props {
  listing: Listing;
  /** Fact keys, in order, for the one-line og:description. */
  ogFactKeys: string[];
  /**
   * Hero height — an allowed divergence (DESIGN-CONTRACT §5.1).
   *
   * The B2 revision replaced the hero's aspect-ratio with a viewport height,
   * so the divergence changed shape with it: what differs is now how much of
   * the screen the photograph takes, not what proportion it is cropped to.
   * The rationale is unchanged — a car is a wide object and a tall vertical
   * frame either crops it or fills the rest with asphalt.
   */
  heroHeight: string;
  /** Override robots. `/template-check/` forces noindex. */
  robots?: string;
  /** True when the walk section will render. walkFirst then hides the hero. */
  hasWalk?: boolean;
}

const { listing, ogFactKeys, heroHeight, robots: robotsOverride, hasWalk = false } = Astro.props;

/**
 * The agent's accent, resolved to two stops and set as inline custom
 * properties — the same mechanism the hero divergence already uses.
 *
 * Inline rather than a class per colour, because six accents times three
 * templates is eighteen rules that all say the same thing. It also keeps the
 * stylesheet BYTE-IDENTICAL between the property and vehicle pages, which is
 * what verify-template-divergences.mjs asserts: the colour rides on the
 * attribute, not on the CSS.
 *
 * A listing with no accent resolves to olive, so every page made before 0011
 * looks exactly as it did.
 */
const accent = accentFor(listing.accent);

const title = ogTitle(listing);
const description = ogDescription(listing, ogFactKeys);

// Always absolute. Falls back to the cover photo until Stage D generates the
// real 1200x630 crop — see ogImageUrl.
const ogImage = ogImageUrl(listing, Astro.site);

const canonical = new URL(`/a/${listing.slug}/`, Astro.site).href;

// noindex unless the seller opted in. A private seller usually does not want
// their home address permanently searchable; an agent does. Not our call.
const robots = robotsOverride ?? (listing.indexable ? 'index,follow' : 'noindex');

// Structured data only when Google is invited. A noindex page with JSON-LD
// still puts the address in a crawl report.
const jsonLd =
  robots.startsWith('index') && listing.indexable
    ? listingJsonLd(listing, canonical)
    : undefined;

const sold = listing.status === 'sold';

/**
 * The agent bar, and what it says when there is no agent.
 *
 * CLAUDE.md §1 makes agents the primary audience and §8 makes נבנה בהיעד the
 * viral loop. Both are served by the same strip: an agency name where one
 * exists, our own mark where it does not. A private seller's listing is the
 * one most likely to be forwarded to somebody who has never heard of us.
 */
const agency = listing.seller.agencyName;
const logoPlacement = listing.seller.logoPlacement ?? 'bar';
const showBarLogo =
  Boolean(listing.seller.agencyLogoUrl) &&
  (logoPlacement === 'bar' || logoPlacement === 'barWide');
---

<!DOCTYPE html>
{/*
  The hero divergence rides on ONE custom property set here, rather than on a
  category class or a second stylesheet. Consequence: the <style> block below
  is BYTE-IDENTICAL for both categories, so CI can assert exact CSS equality
  and a fifth divergence cannot slip in as a style override.
*/}
<html
  lang="he"
  dir="rtl"
  data-template={listing.template}
  data-category={listing.category}
  data-logo={logoPlacement}
  data-has-walk={hasWalk ? '1' : undefined}
  style={`--heroH:${heroHeight};--accent:${accent.base};--accent-lift:${accent.lift}`}
>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#FBFAF7">
<title>{listing.title.replace(/\n/g, ' ')}</title>
<meta name="description" content={description}>

<meta name="robots" content={robots}>
<link rel="canonical" href={canonical}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">

<meta property="og:type" content="website">
<meta property="og:locale" content="he_IL">
<meta property="og:url" content={canonical}>
<meta property="og:site_name" content={t('common.brand')}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;500;700;900&family=Assistant:wght@400;600;700&display=swap" rel="stylesheet">

{jsonLd && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}

<style is:global>
@import '../styles/listing.css';
@import '../styles/walk.css';
</style>
</head>
<body>

<a class="skip" href="#main">{t('a11y.skip')}</a>

{/*
  The progress line is decoration for something the scrollbar already says,
  so it is hidden from assistive technology. It has no styles at all outside
  the @supports block: a browser without scroll-driven animations renders
  nothing here rather than a bar frozen at zero.
*/}
<div class="progress" aria-hidden="true"></div>

<header class="agent-bar">
  {showBarLogo ? (
    <div class="dot" aria-hidden="true">
      <img src={listing.seller.agencyLogoUrl} alt="" />
    </div>
  ) : null}
  {agency ? (
    <Fragment>
      <strong>{listing.seller.name}</strong>
      {listing.seller.licenceVerified ? (
        <span class="agent-verified">{t('listing.licenceVerified')}</span>
      ) : null}
      <span>{agency}</span>
    </Fragment>
  ) : (
    <Fragment>
      <strong>{listing.seller.name}</strong>
      <span>{t('common.builtByPrefix')}<a href="/">{t('common.brand')}</a></span>
    </Fragment>
  )}
</header>

{sold ? <p class="sold-banner">{t('listing.soldBanner')}</p> : null}

<main id="main" class="listing-flow">
  <slot />
</main>
<slot name="after" />

<dialog id="listing-lightbox" class="lightbox" aria-label={t('listing.openPhoto')}>
  <button type="button" class="lightbox-close">{t('listing.closeLightbox')}</button>
  <div class="lightbox-track"></div>
</dialog>

<script src="../scripts/listing-enhance.ts"></script>
</body>
</html>
