---
import type { Listing } from '@/types/listing';
import { ogDescription, ogImageUrl, ogTitle } from '../lib/og';
import '../styles/tokens.css';

interface Props {
  listing: Listing;
  /** Fact keys, in order, for the one-line og:description. */
  ogFactKeys: string[];
  /** aspect-ratio for .hero — an allowed divergence (DESIGN-CONTRACT §5.1). */
  heroRatio: string;
  /** .hero-veil top padding — the other half of the same divergence. */
  heroVeilPad: string;
}

const { listing, ogFactKeys, heroRatio, heroVeilPad } = Astro.props;

const title = ogTitle(listing);
const description = ogDescription(listing, ogFactKeys);

// Always absolute. Falls back to the cover photo until Stage D generates the
// real 1200x630 crop — see ogImageUrl.
const ogImage = ogImageUrl(listing, Astro.site);

// noindex unless the seller opted in. A private seller usually does not want
// their home address permanently searchable; an agent does. Not our call.
const robots = listing.indexable ? 'index,follow' : 'noindex';
---

<!DOCTYPE html>
{/*
  The hero divergence rides on two custom properties set here, rather than on
  a category class or a second stylesheet. Consequence: the <style> block
  below is BYTE-IDENTICAL for both categories, so CI can assert exact CSS
  equality and a fifth divergence cannot slip in as a style override.
*/}
<html lang="he" dir="rtl" style={`--heroRatio:${heroRatio};--heroVeilPad:${heroVeilPad}`}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{listing.title.replace(/\n/g, ' ')}</title>
<meta name="description" content={description}>

<meta name="robots" content={robots}>

<meta property="og:type" content="website">
<meta property="og:locale" content="he_IL">
<meta property="og:site_name" content="סיבוב">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@500;700&family=Assistant:wght@400;600&display=swap" rel="stylesheet">

<style is:global>
html{background:var(--stone)}

body{
  font-family:'Assistant',system-ui,sans-serif;
  background:var(--plaster);
  color:var(--ink);
  line-height:1.6;
  max-width:600px;
  margin-inline:auto;
  padding-bottom:6rem;
  -webkit-font-smoothing:antialiased;
}

/* ---------- Hero ----------
   The ONLY category-parameterised rule. aspect-ratio and veil padding are one
   decision, not two: the padding differs because the ratio does, and a car is
   a wide object that a vertical frame either crops or surrounds with asphalt.
   Both values arrive from a single place — see DESIGN-CONTRACT.md §5.1. */
.hero{position:relative;aspect-ratio:var(--heroRatio);overflow:hidden;background:var(--stone)}
.hero img{width:100%;height:100%;object-fit:cover;display:block}

.hero-veil{
  position:absolute;inset-inline:0;bottom:0;padding:var(--heroVeilPad) 1.5rem 1.25rem;
  background:linear-gradient(to top,rgba(25,26,21,.82),transparent);
  color:var(--plaster);
}
.hero-place{font-size:.9rem;opacity:.9}
.hero-title{
  font-family:'Frank Ruhl Libre',serif;
  font-weight:700;font-size:2rem;line-height:1.25;margin-top:.15rem;
}

/* ---------- Price ---------- */
.price-bar{
  display:flex;align-items:baseline;justify-content:space-between;gap:1rem;
  padding:1.25rem 1.5rem;border-bottom:1px solid var(--stone);
}
.price{
  font-family:'Frank Ruhl Libre',serif;
  font-weight:700;font-size:1.9rem;letter-spacing:-.01em;
}
.price-note{font-size:.85rem;color:var(--muted)}

/* ---------- Facts ----------
   הגריד הזה הוא הסיבה שהעמוד עובד. קונה ישראלי סורק בדיוק
   את השדות האלה לפני שהוא קורא מילה אחת מהתיאור. */
.facts{
  display:grid;grid-template-columns:repeat(3,1fr);
  border-bottom:1px solid var(--stone);
}
.fact{
  padding:1rem .75rem;text-align:center;
  border-inline-start:1px solid var(--stone);
  border-block-start:1px solid var(--stone);
}
.fact:nth-child(3n+1){border-inline-start:none}
.fact:nth-child(-n+3){border-block-start:none}
.fact-val{font-family:'Frank Ruhl Libre',serif;font-weight:500;font-size:1.3rem;line-height:1.2}
.fact-lbl{font-size:.78rem;color:var(--muted);margin-top:.15rem}
.fact.off .fact-val,.fact.off .fact-lbl{opacity:.35}

/* ---------- Provenance ----------
   The verified/declared distinction is the product, so it is a visual class
   and not a tooltip. Olive rather than the usual green tick: a tick reads as
   "good", and this is not an endorsement of the car — it is a statement about
   who recorded the number. */
.fact-src{margin-top:.3rem;display:flex;flex-direction:column;gap:.1rem}
.verified{
  align-self:flex-start;font-family:'Assistant',sans-serif;font-size:.66rem;
  font-weight:600;color:var(--olive);border:1px solid var(--olive);
  border-radius:2px;padding:.05rem .3rem;line-height:1.4
}
.fact-cite{font-size:.66rem;color:var(--muted);line-height:1.4}

/* ---------- Enrichment ----------
   One section class for both categories. A section on one page and not the
   other is a fifth divergence, which the build refuses — so what differs here
   is content, never structure. Logical properties only (CLAUDE.md §4.1). */
.enrich{border-block-start:1px solid var(--stone)}
.enrich-lede{color:var(--muted);font-size:.95rem;margin-block-end:1rem}
.enrich-group{margin-block-start:1.1rem}
.enrich-group h3{
  font-family:'Assistant',sans-serif;font-size:.8rem;font-weight:600;
  color:var(--muted);margin-block-end:.4rem
}
.enrich-group ul{list-style:none}
.enrich-group li{
  border-block-end:1px solid var(--stone);padding-block:.45rem;
  display:flex;flex-wrap:wrap;gap:.15rem .6rem;align-items:baseline
}
.enrich-group li:last-child{border-block-end:none}
.enrich-name{font-size:.95rem}
.enrich-meta{color:var(--muted);font-size:.8rem;margin-inline-start:auto}
.enrich-src{margin-block-start:1rem;color:var(--muted);font-size:.7rem;line-height:1.6}
.attribution{font-size:.68rem;opacity:.85}

/* ---------- Sections ---------- */
section{padding:1.75rem 1.5rem;border-bottom:1px solid var(--stone)}
h2{
  font-family:'Frank Ruhl Libre',serif;
  font-weight:500;font-size:1.15rem;margin-bottom:.6rem;
}
p{font-size:1rem;max-width:60ch}

/* ---------- Gallery ---------- */
.gallery{
  display:flex;gap:.6rem;overflow-x:auto;
  scroll-snap-type:x mandatory;
  padding:1.5rem;margin:0;
  scrollbar-width:none;
}
.gallery::-webkit-scrollbar{display:none}
.gallery figure{
  flex:0 0 78%;scroll-snap-align:center;margin:0;
}
.gallery img{
  width:100%;aspect-ratio:4/3;object-fit:cover;
  border-radius:3px;background:var(--stone);display:block;
}
.gallery figcaption{font-size:.82rem;color:var(--muted);margin-top:.4rem}

/* ---------- Map — property only (DESIGN-CONTRACT §5.4) ---------- */
.map img{width:100%;border-radius:3px;display:block;background:var(--stone)}
.addr{font-size:.9rem;color:var(--muted);margin-top:.6rem}

/* ---------- Disclosures — vehicle only (DESIGN-CONTRACT §5.3) ----------
   גילוי פגמים — הבידול האמיתי מול מודעת רכב רגילה.
   מסגרת נפרדת, לא מוסתר בתוך הגלריה. */
.flaws{background:#F5F2EA}
.flaws ul{list-style:none;margin-top:.5rem}
.flaws li{padding:.45rem 0;border-block-end:1px solid var(--stone);font-size:.95rem}
.flaws li:last-child{border:none}

/* ---------- Seller ---------- */
.seller{display:flex;align-items:center;gap:.9rem}
.avatar{
  width:46px;height:46px;border-radius:50%;
  background:var(--stone);flex:0 0 auto;
}
.seller-name{font-weight:600}
.seller-role{font-size:.85rem;color:var(--muted)}

/* ---------- CTA ---------- */
.cta-dock{
  position:fixed;inset-inline:0;bottom:0;
  max-width:600px;margin-inline:auto;
  padding:.75rem 1rem calc(.75rem + env(safe-area-inset-bottom));
  background:linear-gradient(to top,var(--plaster) 72%,transparent);
}
.cta{
  display:block;width:100%;padding:.95rem;
  background:var(--olive);color:var(--plaster);
  font-family:'Assistant',sans-serif;font-size:1.05rem;font-weight:600;
  border:none;border-radius:4px;text-align:center;text-decoration:none;
  box-shadow:var(--shadow);cursor:pointer;
}
.cta:focus-visible{outline:3px solid var(--ink);outline-offset:2px}

/* ---------- Footer ---------- */
footer{padding:1.5rem;text-align:center;font-size:.82rem;color:var(--muted)}
footer a{color:var(--muted)}

/* ---------- Motion: רגע אחד בלבד ---------- */
@media (prefers-reduced-motion:no-preference){
  .hero-veil{animation:rise .5s .1s both cubic-bezier(.2,.7,.3,1)}
  @keyframes rise{from{opacity:0;transform:translateY(14px)}}
}
</style>
</head>
<body>
<slot />
</body>
</html>
