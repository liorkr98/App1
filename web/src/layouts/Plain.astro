---
import BrandMark from '../components/BrandMark.astro';
import { t } from '../lib/i18n';
import '../styles/tokens.css';

interface Props {
  title: string;
  robots?: string;
}

const { title, robots = 'index,follow' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!DOCTYPE html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FBFAF7" />
    <title>{title} · {t('common.brand')}</title>
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;500;700;900&family=Assistant:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      html {
        background: var(--plaster);
        color-scheme: light;
      }
      body {
        font-family: 'Assistant', system-ui, sans-serif;
        background: var(--plaster);
        color: var(--ink);
        font-size: var(--t-body);
        line-height: 1.7;
        max-inline-size: 40rem;
        margin-inline: auto;
        padding: 1.5rem var(--gut) 3rem;
        -webkit-font-smoothing: antialiased;
      }
      .mark {
        font-family: 'Frank Ruhl Libre', serif;
        font-weight: 700;
        font-size: 1.4rem;
        color: inherit;
        text-decoration: none;
      }
      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-block-end: 1.5rem;
        margin-block-end: 1.5rem;
        border-block-end: 1px solid var(--stone);
      }
      header > a:not(.brand-mark) {
        color: var(--muted);
        font-size: 0.9rem;
      }
      h1 {
        font-family: 'Frank Ruhl Libre', serif;
        font-weight: 700;
        font-size: var(--t-h2);
        line-height: 1.2;
        margin-block-end: 0.4rem;
      }
      .updated {
        color: var(--muted);
        font-size: var(--t-label);
        margin-block-end: 1.5rem;
      }
      h2 {
        font-family: 'Frank Ruhl Libre', serif;
        font-weight: 500;
        font-size: 1.2rem;
        margin-block: 1.6rem 0.5rem;
      }
      p + p {
        margin-block-start: 0.85rem;
      }
      footer {
        margin-block-start: 2.5rem;
        padding-block-start: 1.25rem;
        border-block-start: 1px solid var(--stone);
        font-size: 0.85rem;
        color: var(--muted);
      }
      footer a {
        color: var(--muted);
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">{t('a11y.skip')}</a>
    <header>
      <BrandMark />
      <a href="/">{t('legal.home')}</a>
    </header>
    <main id="main">
    <slot />
    </main>
    <footer>
      <a href="/legal/terms/">{t('legal.terms')}</a>
      {' · '}
      <a href="/legal/privacy/">{t('legal.privacy')}</a>
      {' · '}
      <a href="/legal/accessibility/">{t('legal.accessibility')}</a>
    </footer>
  </body>
</html>
