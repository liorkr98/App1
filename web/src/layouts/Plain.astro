---
import { t } from '../lib/i18n';
import Site from './Site.astro';
import '../styles/reading.css';

/**
 * Reading pages: guides, legal, about, contact, the 404 and an ended listing.
 *
 * ON THE SITE SHELL SINCE 14 OCT 2026. These pages had their own head,
 * header, footer and faces (Frank Ruhl Libre and Assistant on cream), so
 * they read as a different company from the rest of the site — the design
 * audit's largest single finding. They now render through layouts/Site.astro
 * in Paper, the same system the editor uses: same header, same footer, same
 * faces, a light ground for long reading. This file keeps only what is
 * theirs: the breadcrumb trail, and a reading column.
 */

interface Props {
  title: string;
  robots?: string;
  description?: string;
  /** Structured data for this page, added to the Organization and WebSite every page carries. */
  ld?: object[];
  /** The breadcrumb trail after the brand. Default: this page alone. */
  trail?: { name: string; path: string }[];
}

const { title, robots = 'index,follow', description, ld = [], trail } = Astro.props;
const origin = Astro.site ?? new URL(Astro.url.origin);
const fullTitle = `${title} · ${t('common.brand')}`;
const steps = trail ?? [{ name: title, path: Astro.url.pathname }];
const crumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('common.brand'), item: new URL('/', origin).href },
    ...steps.map((step, index) => ({
      '@type': 'ListItem',
      position: index + 2,
      name: step.name,
      item: new URL(step.path, origin).href,
    })),
  ],
};
---

<Site title={fullTitle} description={description} robots={robots} ls="paper" ld={[crumbs, ...ld]}>
  <div class="site-shell site-read">
    <slot />
  </div>
</Site>
