---
import he from '@locales/he.json';

import BrandMark from '../components/BrandMark.astro';
import { t } from '../lib/i18n';
import '../styles/tokens.css';
import '../styles/fonts.css';

/**
 * The owner's data page, the frame around lib/admin-data-view.ts: the real
 * page (/admin/data/) and its CI fixture (/template-check/admin-data/) both
 * use it, and each brings its own script in the slot. noindex, no account
 * data in the markup: everything is drawn after an admin_analytics answer.
 *
 * Reads, never grants (CLAUDE.md §8 does not apply).
 */
interface Props {
  /** A note above everything, for the fixture's sample data. */
  note?: string;
}

const { note } = Astro.props;
const copy = he.adminData;
---

<!DOCTYPE html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FBFAF7" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{copy.title} · {t('common.brand')}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline type="application/json" id="admin-data-copy" set:html={JSON.stringify(copy).replace(/</g, '\\u003c')} />
    <style is:global>
      :root {
        --d-surface: #fbfaf7;
        --d-card: #f1ede3;
        --d-grid: #e4e0d6;
        --d-ink: #191a15;
        --d-ink-soft: #6e6f66;
        --d-muted: #67685f;
        --d-good: #3f6a1f;
        --d-bad: #8c2f1e;
        --d-accent: #4f7a2a;
        --d-quiet: #c9c4b6;
      }
      html { background: var(--d-surface); color-scheme: light; }
      body {
        font-family: 'Assistant', system-ui, sans-serif;
        background: var(--d-surface);
        color: var(--d-ink);
        font-size: var(--t-body);
        line-height: 1.6;
        max-inline-size: 68rem;
        margin-inline: auto;
        padding-block: 1.25rem 3rem;
        padding-inline: max(16px, var(--gut));
      }
      bdi { font-variant-numeric: tabular-nums; }
      .d-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem 1rem;
        padding-block-end: 1rem;
        border-block-end: 1px solid var(--d-grid);
      }
      .d-head nav { display: flex; gap: 0.25rem 1rem; flex-wrap: wrap; }
      .d-head nav a {
        color: var(--d-muted);
        display: inline-flex;
        align-items: center;
        min-block-size: 44px;
      }
      h1 {
        font-family: 'Frank Ruhl Libre', serif;
        font-size: var(--t-h2);
        line-height: 1.3;
        margin-block: 1.5rem 0.25rem;
      }
      h2 {
        font-family: 'Frank Ruhl Libre', serif;
        font-size: 1.3rem;
        line-height: 1.35;
        margin-block: 0 0.25rem;
      }
      h3 { font-size: 1rem; font-weight: 600; margin-block: 1rem 0.4rem; }
      .d-lead, .d-intro { color: var(--d-muted); margin-block: 0 0.9rem; max-inline-size: 62ch; }
      .d-fixture {
        padding: 0.6rem 0.9rem;
        border-radius: 10px;
        background: var(--d-card);
        font-weight: 600;
      }
      .d-gate { padding: 1rem 1.15rem; border: 1px solid var(--d-grid); border-radius: 12px; background: var(--d-card); }
      .d-gate a { color: var(--d-accent); font-weight: 700; display: inline-flex; min-block-size: 44px; align-items: center; }

      .d-controls {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 1rem;
        margin-block: 1.25rem 1.5rem;
      }
      .d-range { display: inline-flex; border: 1px solid var(--d-grid); border-radius: 999px; padding: 3px; background: #fff; }
      .d-range button {
        min-block-size: 40px;
        min-inline-size: 64px;
        padding-inline: 0.9rem;
        border: 0;
        border-radius: 999px;
        background: transparent;
        color: var(--d-ink);
        font: inherit;
        cursor: pointer;
      }
      .d-range button[aria-pressed='true'] { background: var(--d-ink); color: var(--d-surface); font-weight: 700; }
      .d-period { color: var(--d-muted); font-size: 0.92rem; }

      #d-body { display: grid; gap: 2.25rem; transition: opacity var(--dur-ui, 240ms); }
      #d-body.is-loading { opacity: 0.55; }
      section { min-inline-size: 0; }

      .d-kpis { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 9.5rem), 1fr)); gap: 0.6rem; }
      .kpi {
        display: grid;
        gap: 0.2rem;
        align-content: start;
        padding: 0.9rem 1rem;
        border-radius: 12px;
        background: var(--d-card);
      }
      .kpi-label { color: var(--d-muted); font-size: 0.86rem; }
      .kpi-value { font-size: 1.85rem; font-weight: 700; line-height: 1.2; }
      .kpi-value bdi { font-variant-numeric: normal; }
      .kpi-delta { font-size: 0.82rem; color: var(--d-muted); }
      .kpi-delta.is-good { color: var(--d-good); }
      .kpi-delta.is-bad { color: var(--d-bad); }
      .kpi-arrow { font-size: 0.7rem; }

      .d-two { display: grid; gap: 2.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr)); }
      .d-legend { list-style: none; margin: 0 0 0.5rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; font-size: 0.9rem; }
      .d-legend li { display: inline-flex; align-items: center; gap: 0.4rem; }
      .d-key { inline-size: 14px; block-size: 2px; border-radius: 2px; display: inline-block; }
      .d-plot { position: relative; }
      .d-svg { display: block; max-inline-size: 100%; block-size: auto; touch-action: pan-y; }
      .d-svg:focus-visible { outline: 2px solid var(--d-accent); outline-offset: 4px; border-radius: 4px; }
      .d-axis { fill: var(--d-muted); font-size: 11px; font-family: 'Assistant', system-ui, sans-serif; font-variant-numeric: tabular-nums; }
      .d-tip {
        position: absolute;
        inset-block-start: 0;
        display: grid;
        gap: 0.15rem;
        min-inline-size: 9rem;
        padding: 0.5rem 0.7rem;
        border-radius: 8px;
        background: #fff;
        box-shadow: 0 2px 10px rgba(25, 26, 21, 0.14);
        font-size: 0.85rem;
        pointer-events: none;
      }
      .d-tip[hidden] { display: none; }
      .d-tip-day { color: var(--d-muted); }
      .d-tip-row { display: flex; align-items: center; gap: 0.4rem; }
      .d-tip-key { inline-size: 10px; block-size: 2px; display: inline-block; }

      .d-tableview { margin-block-start: 0.5rem; }
      .d-tableview summary { cursor: pointer; color: var(--d-accent); min-block-size: 44px; display: flex; align-items: center; }
      .d-table { overflow-x: auto; }
      table { border-collapse: collapse; inline-size: 100%; font-size: 0.92rem; }
      th, td { text-align: start; padding: 0.45rem 0.5rem; border-block-end: 1px solid var(--d-grid); vertical-align: top; }
      th { color: var(--d-muted); font-weight: 600; font-size: 0.82rem; }
      th.num, td.num { text-align: end; font-variant-numeric: tabular-nums; }
      td a { color: var(--d-accent); }

      .d-worst { font-weight: 600; margin-block: 0 0.75rem; }
      .d-bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
      .d-bars li {
        display: grid;
        grid-template-columns: minmax(6.5rem, 9rem) 1fr auto;
        align-items: center;
        gap: 0.75rem;
      }
      .d-bar-name { font-size: 0.92rem; }
      .d-bar-track { block-size: 18px; display: block; }
      .d-bar-fill {
        display: block;
        block-size: 100%;
        background: var(--d-quiet);
        border-start-end-radius: 4px;
        border-end-end-radius: 4px;
      }
      .d-bars li.is-worst .d-bar-fill { background: var(--d-accent); }
      .d-bars li.is-worst .d-bar-name { font-weight: 700; }
      .d-bar-value { font-size: 0.88rem; color: var(--d-muted); white-space: nowrap; }
      .d-empty { color: var(--d-muted); }

      .d-mixes { display: grid; gap: 0.5rem 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
      .d-mix h3 { margin-block-start: 0.5rem; }

      .d-ai { padding: 1.25rem; border-radius: 14px; background: var(--d-card); }
      .d-ai button {
        min-block-size: 44px;
        padding-inline: 1.2rem;
        border: 0;
        border-radius: 999px;
        background: var(--d-ink);
        color: var(--d-surface);
        font: inherit;
        font-weight: 700;
        cursor: pointer;
      }
      .d-ai button:disabled { opacity: 0.6; cursor: progress; }
      #d-ai-result { margin-block-start: 1rem; }
      .d-ai-note { font-size: 0.85rem; color: var(--d-muted); }
      .d-ai-error { color: var(--d-bad); font-weight: 600; }
      .d-ai-stuck { margin: 0; padding-inline-start: 1.2rem; display: grid; gap: 0.35rem; }
      .d-ai-proposals { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.75rem; counter-reset: proposal; }
      .d-ai-proposals li { background: #fff; border-radius: 10px; padding: 0.8rem 1rem; border-inline-start: 4px solid var(--d-quiet); }
      .d-ai-proposals li.is-high { border-inline-start-color: var(--d-accent); }
      .d-ai-proposals p { margin-block: 0.3rem 0; }
      .d-ai-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.25rem 1rem; }
      .d-ai-impact { font-size: 0.82rem; color: var(--d-muted); }
      .d-ai-label { font-weight: 600; }

      @media (prefers-reduced-motion: reduce) {
        #d-body { transition: none; }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">{t('a11y.skip')}</a>
    <header class="d-head">
      <BrandMark />
      <nav aria-label={copy.title}>
        <a href="/admin/">{copy.back}</a>
        <a href="/mine/">{t('dash.title')}</a>
      </nav>
    </header>
    <main id="main">
      <h1>{copy.title}</h1>
      <p class="d-intro">{copy.lead}</p>
      {note && <p class="d-fixture">{note}</p>}

      <p class="d-gate" id="gate" hidden>{t('admin.forbidden')}</p>
      <p class="d-gate" id="anon" hidden>
        {t('agent.signedOut')}
        {' '}
        <a href="/enter/">{t('agent.signIn')}</a>
      </p>

      <div id="d-app" hidden>
        <div class="d-controls">
          <div class="d-range" role="group" aria-label={copy.rangeLabel}>
            {[7, 30, 90].map((n) => (
              <button type="button" data-range={n} aria-pressed="false">
                {copy.days.split('{n}')[0]}<bdi>{n}</bdi>{copy.days.split('{n}')[1]}
              </button>
            ))}
          </div>
          <span class="d-period" id="d-period"></span>
        </div>
        <p class="d-gate" id="d-say" role="status">{copy.loading}</p>

        <div id="d-body" hidden>
          <section aria-labelledby="h-kpis">
            <h2 id="h-kpis" class="visually-hidden">{copy.title}</h2>
            <div class="d-kpis" id="d-kpis"></div>
          </section>

          <div class="d-two">
            <section aria-labelledby="h-traffic">
              <h2 id="h-traffic">{copy.traffic}</h2>
              <p class="d-lead">{copy.trafficLead}</p>
              <div id="d-traffic"></div>
            </section>
            <section aria-labelledby="h-growth">
              <h2 id="h-growth">{copy.growth}</h2>
              <p class="d-lead">{copy.growthLead}</p>
              <div id="d-growth"></div>
            </section>
          </div>

          <section aria-labelledby="h-stuck">
            <h2 id="h-stuck">{copy.stuck}</h2>
            <p class="d-lead">{copy.stuckLead}</p>
            <div id="d-funnel"></div>
          </section>

          <section class="d-ai" aria-labelledby="h-ai">
            <h2 id="h-ai">{copy.ai}</h2>
            <p class="d-lead">{copy.aiLead}</p>
            <button type="button" id="d-ai-button">{copy.aiButton}</button>
            <div id="d-ai-result" aria-live="polite" hidden></div>
          </section>

          <div class="d-two">
            <section aria-labelledby="h-sources">
              <h2 id="h-sources">{copy.sources}</h2>
              <div id="d-sources"></div>
            </section>
            <section aria-labelledby="h-pages">
              <h2 id="h-pages">{copy.pages}</h2>
              <div id="d-pages"></div>
            </section>
          </div>

          <section aria-labelledby="h-listings">
            <h2 id="h-listings">{copy.topListings}</h2>
            <div id="d-listings"></div>
          </section>

          <section aria-labelledby="h-mix">
            <h2 id="h-mix">{copy.mix}</h2>
            <div class="d-mixes" id="d-mixes"></div>
          </section>
        </div>
      </div>
    </main>
    <slot />
  </body>
</html>
