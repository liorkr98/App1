{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // expo/tsconfig.base pulls in neither test-runner globals (describe/it/expect)
    // nor Node types, which scripts/new-app.ts needs.
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  // supabase/functions is Deno, not React Native: it uses the Deno global and
  // jsr: imports, which this tsconfig cannot resolve. Supabase typechecks it
  // on deploy.
  "exclude": ["node_modules", ".expo", "dist", "supabase/functions"]
}
