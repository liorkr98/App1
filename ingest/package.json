{
  "name": "listing-ingest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc --outDir test-build && node --test \"test-build/**/*.test.js\"",
    "sync:schools": "node dist/ingest/src/index.js schools",
    "sync:transit": "node dist/ingest/src/index.js transit",
    "sync:stations": "node dist/ingest/src/index.js stations",
    "sync:places": "node dist/ingest/src/index.js places",
    "sync:police": "node dist/ingest/src/index.js police",
    "sync:parking": "node dist/ingest/src/index.js parking",
    "sync:park-ride": "node dist/ingest/src/index.js park_ride"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.115.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "~6.0.3"
  }
}
