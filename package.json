{
  "name": "listing-pages",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hebrew-first enriched listing pages. Web product; see RESEARCH.md.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.test.json && node --test \"test-build/**/*.test.js\"",
    "build": "npm install --prefix web --no-audit --no-fund && npm run build --prefix web",
    "web": "npm run dev --prefix web",
    "web:build": "npm run build --prefix web",
    "worker:test": "npm run test --prefix worker"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "expo": "^54.0.0"
  }
}
