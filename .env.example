# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# EXPO_PUBLIC_* variables are embedded in the client bundle and are PUBLIC.
# Treat every value below that carries the EXPO_PUBLIC_ prefix as visible to
# anyone who downloads the app (CLAUDE.md §8). Never put a service-role key,
# a secret API key, or any server credential behind an EXPO_PUBLIC_ prefix.

# --- Supabase -----------------------------------------------------------
# Project URL and the publishable (anon) key. Safe to ship: row access is
# governed by RLS, which is mandatory on every table (CLAUDE.md §8).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- RevenueCat ---------------------------------------------------------
# Platform-specific PUBLIC SDK keys (appl_... / goog_...). These are designed
# to ship in the client. The RevenueCat SECRET key must never appear here.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# --- Sentry -------------------------------------------------------------
# The DSN is public by design.
EXPO_PUBLIC_SENTRY_DSN=

# Build-time only, used by EAS to upload source maps. NOT EXPO_PUBLIC_ —
# this is a real secret and must stay out of the bundle. Set it as an EAS
# secret in production rather than keeping it in a local .env.
SENTRY_AUTH_TOKEN=
